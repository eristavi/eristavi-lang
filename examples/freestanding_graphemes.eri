import std.unicode;
function makeCharacters() {
    let local be "A\u{301}👩🏽‍💻";
    return local.characters;
}
let characters be makeCharacters();
let snapshot be characters;
let i be 0;
while i<1000 { let temporary be "temporary"; i=i+1; }
