// Original canonical SSA Function: loop, simultaneous backedge value swap,
// unreachable block, exact scalar return. No handwritten executable IR.
import std.process;
import compiler.u1_budget as budget;
import compiler.u1_meta as meta;
import compiler.u1_builder as build;
import compiler.u1_aggregate as aggregate;
import compiler.u1_aggregate_build as ab;
import compiler.u1_aggregate_execute as execute;
import compiler.u1_verify as verify;
import compiler.u2_function_scalar_x86_64 as lower;

error ProbeError { message Text; }
function check(ok Bool,message Text) fails ProbeError {
    if not ok { fail ProbeError { message=message; }; }
}
function run() fails budget.LimitError,verify.InvalidIR,lower.Unsupported,ProbeError {
    let root be try budget.developmentRequest();
    let shared be try budget.metadataOwner(root);
    let mp be try budget.constructionPhase(shared);
    let data be try meta.create(shared,mp);
    let signature be try meta.signature(data,mp,[meta.i64()],[meta.i64(),meta.i64()]);
    let source be try meta.source(data,mp,"u2-native-scalar-cfg",
        "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",160);
    let loc be try meta.location(data,mp,source,0,7,1,1,1);
    let graph be try aggregate.create(shared,mp);
    let i64 be try aggregate.primitive(graph,meta.i64());
    let pred be try aggregate.primitive(graph,meta.pred());
    let box be try aggregate.aggregate(graph,mp,[i64]);
    try aggregate.freeze(graph);
    try meta.freeze(data);
    try budget.finishPhase(mp);

    let fnOwner be try budget.functionOwner(root,false);
    let cp be try budget.constructionPhase(fnOwner);
    let fn be try build.create(data,signature,fnOwner,cp);
    let entry be try ab.block(fn,graph,[i64]);
    let input be try build.parameter(fn,entry,0);
    let eleven be try build.integer(fn,entry,11,loc);
    let on be try build.predicate(fn,entry,true,loc);
    let off be try build.predicate(fn,entry,false,loc);
    let loop be try ab.block(fn,graph,[i64,i64,pred]);
    let exit be try ab.block(fn,graph,[i64,i64]);
    try ab.jump(fn,graph,entry,loop,[input,eleven,on],loc);
    let first be try build.parameter(fn,loop,0);
    let second be try build.parameter(fn,loop,1);
    let again be try build.parameter(fn,loop,2);
    try ab.branch(fn,graph,loop,again,loop,[second,first,off],
        exit,[second,first],loc);
    let result0 be try build.parameter(fn,exit,0);
    let result1 be try build.parameter(fn,exit,1);
    try ab.returnValues(fn,graph,exit,[result0,result1],loc);
    let dead be try ab.block(fn,graph,[i64]);
    let deadEntry be try build.block(fn,[]);
    let deadTarget be try build.block(fn,[meta.i64()]);
    try build.jump(fn,deadEntry,deadTarget,[input],loc);
    try ab.returnValues(fn,graph,deadTarget,[eleven,eleven],loc);
    let deadValue be try build.parameter(fn,dead,0);
    let never be try build.wrapAdd(fn,dead,deadValue,eleven,loc);
    try ab.returnValues(fn,graph,dead,[never,eleven],loc);
    try ab.complete(fn,graph);
    try budget.finishPhase(cp);
    let reference be try execute.run(fn,graph,fnOwner,[37],64);
    try check(reference.kind == 0 and reference.count == 2 and
        (try execute.result(reference,0)) == 37 and
        (try execute.result(reference,1)) == 11,
        "canonical SSA loop backedge reference mismatch");
    try lower.emit(fn,graph,83);
    try build.close(fn); try aggregate.close(graph); try meta.close(data);
    try budget.close(fnOwner); try budget.close(shared); try budget.close(root);
}
function main() {
    run()
    else error budget.LimitError {
        output("limit:"+error.message); process.setExitCode(1);
    } else error verify.InvalidIR {
        output("invalid:"+error.message); process.setExitCode(1);
    } else error lower.Unsupported {
        output("unsupported:"+error.message); process.setExitCode(1);
    } else error ProbeError {
        output("probe:"+error.message); process.setExitCode(1);
    };
}
main();
