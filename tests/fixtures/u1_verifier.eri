function manyUses() fails budget.LimitError,verify.InvalidIR,ProbeError {
    let harness be try create([meta.pred()],[]); let routine be harness.routine;
    let entry be try build.block(routine,[meta.pred()]); let body be try build.block(routine,[]);
    let test be try build.parameter(routine,entry,0); try build.jump(routine,entry,body,[],harness.location);
    let index be 0; while index < 128 { try build.guard(routine,body,test,1,harness.location); index=index+1; }
    try build.returnValues(routine,body,[],harness.location); try build.complete(routine);
    // O(1) use queries are scanning work, not new dominator-construction visits.
    try accepted(harness,2,"many-dominated-uses"); try close(harness);
}
function run() returns Bool fails budget.LimitError,verify.InvalidIR,ProbeError {
    try mutations(); try orphanRecords(); try diamond(); try loop(); try dead(); try repeatedTarget(); try limits(); try cancellation();
    try scalarShapes(); try predicateOperations(); try predicateDead(); try integerOperations(); try integerDead(); try divremContracts(); try divremDead(); try floatOperations(); try floatDead(); try syntheticOrigins(); try switchContracts(); try switchEmpty(); try narrowTypeShapes(); try narrowConstantContract(); try narrowArithmeticContract(); try narrowArithmeticDead(); try narrowDivRemContracts(); try narrowDivRemDead(); try manyUses(); return true;
}
function main() {
    let done be run() else error budget.LimitError { output(error.category+":"+error.message); process.setExitCode(1); return; }
    else error verify.InvalidIR { output("unexpected invalid IR"); output(error.message); output(error.stage); output(error.block); output(error.instruction); process.setExitCode(1); return; }
    else error ProbeError { output(error.message); process.setExitCode(1); return; };
}
main();
