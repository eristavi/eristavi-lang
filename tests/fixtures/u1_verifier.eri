    let second be try build.edge(routine,join,[selector]);
    let third be try build.edge(routine,join,[selector]);
    let fallback be try build.edge(routine,join,[selector]);
    try build.switchInteger(routine,entry,selector,[0,9223372036854775807,-9223372036854775807-1],
        [first,second,third],fallback,harness.location);
    try build.returnValues(routine,join,[try build.parameter(routine,join,0)],harness.location);
    try build.complete(routine); try accepted(harness,2,"switch-valid");
    let edit be try budget.constructionPhase(harness.owner);
    try change(routine.cases,edit,2,0);
    try rejected(harness,2,0,"switch-duplicate-case"); try change(routine.cases,edit,2,9223372036854775807);
    try change(routine.cases,edit,1,999);
    try rejected(harness,2,0,"switch-invalid-case-edge"); try change(routine.cases,edit,1,first.index);
    try change(routine.switches,edit,2,0);
    try rejected(harness,2,0,"switch-invalid-default"); try change(routine.switches,edit,2,fallback.index);
    try change(routine.instructions,edit,7,999);
    try rejected(harness,2,1,"switch-invalid-header"); try change(routine.instructions,edit,7,1);
    try change(routine.cases,edit,3,first.index);
    try rejected(harness,2,1,"switch-reused-edge"); try change(routine.cases,edit,3,second.index);
    try change(routine.instructions,edit,8,1);
    try rejected(harness,2,1,"switch-unexpected-extra"); try change(routine.instructions,edit,8,0);
    try change(routine.operands,edit,0,wrong.index);
    try rejected(harness,2,1,"switch-selector-type"); try change(routine.operands,edit,0,selector.index);
    try accepted(harness,2,"switch-restored"); try close(harness);
}


function switchEmpty() fails budget.LimitError,verify.InvalidIR,ProbeError {
    let harness be try create([meta.i64()],[meta.i64()]); let routine be harness.routine;
