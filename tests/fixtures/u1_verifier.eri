function switchContracts() fails budget.LimitError,verify.InvalidIR,ProbeError {
    let harness be try create([meta.i64(),meta.pred()],[meta.i64()]);
    let routine be harness.routine; let entry be try build.block(routine,[meta.i64(),meta.pred()]);
    let join be try build.block(routine,[meta.i64()]);
