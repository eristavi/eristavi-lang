import std.process;
import compiler.u1_budget as budget;
import compiler.u1_words as words;
import compiler.u1_meta as meta;
import compiler.u1_builder as build;
import compiler.u1_verify as verify;
error ProbeError { message Text; }
type Harness { root identity budget.Owner; shared identity budget.Owner; data identity meta.Metadata;
    owner identity budget.Owner; construct identity budget.Phase; routine identity build.Function; location meta.LocId; alternate meta.LocId; }
function check(condition Bool,message Text) fails ProbeError { if not condition { fail ProbeError { message=message; }; } }
function create(parameters,results) returns identity Harness fails budget.LimitError {
    let root be try budget.developmentRequest(); let shared be try budget.metadataOwner(root); let phase be try budget.constructionPhase(shared);
    let data be try meta.create(shared,phase); let signature be try meta.signature(data,phase,parameters,results);
    let collision be try meta.signature(data,phase,[meta.pred(),meta.pred()],[]);
    collision=try meta.signature(data,phase,[meta.pred(),meta.i64(),meta.f64()],[]);
    let source be try meta.source(data,phase,"verifier-α","0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",32);
    let location be try meta.location(data,phase,source,0,8,3,1,4);
    let alternate be try meta.location(data,phase,source,9,17,4,1,4); try meta.freeze(data); try budget.finishPhase(phase);
    let owner be try budget.functionOwner(root,false); let construct be try budget.constructionPhase(owner);
    return identity Harness { root=root; shared=shared; data=data; owner=owner; construct=construct;
        routine=try build.create(data,signature,owner,construct); location=location; alternate=alternate; };
}
function close(harness identity Harness) fails budget.LimitError,ProbeError {
    try build.close(harness.routine); try meta.close(harness.data);
    try check(harness.root.live == 0 and harness.root.pending == 0,"workspace or input charge leak");
    try budget.close(harness.owner); try budget.close(harness.shared); try budget.close(harness.root);
}
function change(table identity words.Words,phase identity budget.Phase,index Int,value Int) fails budget.LimitError {
    table.frozen=false; try words.set(table,phase,index,value); table.frozen=true;
}
function accepted(harness identity Harness,reachable Int,label Text) fails budget.LimitError,verify.InvalidIR,ProbeError {
    let live be harness.owner.live; let revision be harness.routine.revision;
    let phase be try budget.verificationPhase(harness.owner); let result be try verify.verify(harness.routine,phase);
    try check(result.reachableBlocks == reachable and result.revision == revision and result.structuralVisits > 0 and result.dominanceVisits > 0,"verification report");
    try check(harness.owner.live == live and harness.owner.pending == 0 and harness.routine.revision == revision and phase.state == 1,"read-only verification and scratch release"); output(label+":ok");
}
function rejected(harness identity Harness,stage Int,block Int,label Text) fails budget.LimitError,verify.InvalidIR,ProbeError {
    let live be harness.owner.live; let phase be try budget.verificationPhase(harness.owner);
    let unexpected be verify.verify(harness.routine,phase) else error verify.InvalidIR {
        try check(error.category == "invalid-ir" and error.stage == stage and error.block == block,"deterministic invalid IR category/stage/block: "+label);
        try check(harness.owner.live == live and harness.owner.pending == 0 and phase.state == 1,"rejected workspace cleanup"); output(label+":ok"); return;
    } else error budget.LimitError { fail error; };
    fail ProbeError { message="accepted invalid IR: "+label; };
}
function straight() returns identity Harness fails budget.LimitError {
    let harness be try create([meta.i64(),meta.pred()],[meta.i64()]); let routine be harness.routine;
    let entry be try build.block(routine,[meta.i64(),meta.pred()]); let first be try build.parameter(routine,entry,0);
    let one be try build.integer(routine,entry,1,harness.location);
    let sum be try build.addOverflow(routine,entry,first,one,harness.location);
    let later be try build.integer(routine,entry,2,harness.location);
    try build.guard(routine,entry,try build.parameter(routine,entry,1),1,harness.location);
    try build.returnValues(routine,entry,[sum.value],harness.location); try build.complete(routine); try budget.finishPhase(harness.construct); return harness;
}
function mutations() fails budget.LimitError,verify.InvalidIR,ProbeError {
    let harness be try straight(); let routine be harness.routine; let edit be try budget.constructionPhase(harness.owner);
    try accepted(harness,1,"straight");
    // Alter backing without changing revision: verification must derive facts again.
    try change(routine.operands,edit,0,4); try rejected(harness,4,1,"own-result");
    try change(routine.operands,edit,0,6); try rejected(harness,4,1,"use-before-definition");
    try change(routine.operands,edit,0,1); try accepted(harness,1,"reverify-after-restoration");
    try change(routine.values,edit,12,1); try rejected(harness,2,1,"result-type"); try change(routine.values,edit,12,2);
    try change(routine.values,edit,14,1); try rejected(harness,2,1,"definition-owner"); try change(routine.values,edit,14,2);
    try change(routine.instructions,edit,10,99); try rejected(harness,2,1,"unknown-operation"); try change(routine.instructions,edit,10,3);
    try change(routine.instructions,edit,9,1); try rejected(harness,2,1,"cyclic-order"); try change(routine.instructions,edit,9,2);
    try change(routine.instructions,edit,19,2); try rejected(harness,2,1,"cyclic-later-position"); try change(routine.instructions,edit,19,3);
    try change(routine.instructions,edit,35,1); try rejected(harness,2,1,"fake-void-result"); try change(routine.instructions,edit,35,0);
    try change(routine.instructions,edit,6,0); try rejected(harness,3,1,"required-location"); try change(routine.instructions,edit,6,1);
    try change(routine.instructions,edit,37,5); try rejected(harness,2,1,"trap-code"); try change(routine.instructions,edit,37,1);
    try change(routine.instructions,edit,12,9223372036854775807); try rejected(harness,2,0,"overflowing-range"); try change(routine.instructions,edit,12,0);
    try change(routine.blocks,edit,4,9223372036854775807); try rejected(harness,2,1,"overflowing-instruction-id"); try change(routine.blocks,edit,4,5);
    let length be routine.values.length; routine.values.length=9223372036854775807;
    try rejected(harness,0,0,"overflowing-count"); routine.values.length=length;
    let foreign be try budget.functionOwner(harness.root,false); routine.values.owner=foreign;
    try rejected(harness,0,0,"foreign-table"); routine.values.owner=harness.owner; try budget.close(foreign);
    let oldRoot be routine.values.root; routine.values.root=none; try rejected(harness,2,1,"missing-page"); routine.values.root=oldRoot;
    let metadataEdit be try budget.constructionPhase(harness.shared);
    try change(harness.data.locations,metadataEdit,3,33); try rejected(harness,3,0,"source-anchor"); try change(harness.data.locations,metadataEdit,3,3);
    try change(harness.data.locations,metadataEdit,6,1); try rejected(harness,3,0,"unsupported-origin"); try change(harness.data.locations,metadataEdit,6,0);
    try change(harness.data.bytes,metadataEdit,12,71); try rejected(harness,1,0,"source-digest"); try change(harness.data.bytes,metadataEdit,12,49);
    try change(harness.data.signatures,metadataEdit,1,1); try rejected(harness,1,0,"signature-chain"); try change(harness.data.signatures,metadataEdit,1,0);
    try accepted(harness,1,"metadata-restored"); try close(harness);
}
function orphanRecords() fails budget.LimitError,verify.InvalidIR,ProbeError {
    let harness be try straight(); let routine be harness.routine; let edit be try budget.constructionPhase(harness.owner);
    let length be routine.values.length; routine.values.frozen=false;
    let ignored be try words.push(routine.values,edit,2); ignored=try words.push(routine.values,edit,1);
    ignored=try words.push(routine.values,edit,2); ignored=try words.push(routine.values,edit,0); routine.values.frozen=true;
    try rejected(harness,2,0,"orphan-value"); routine.values.length=length;
    length=routine.instructions.length; routine.instructions.frozen=false;
    ignored=try words.push(routine.instructions,edit,1); ignored=try words.push(routine.instructions,edit,1);
    ignored=try words.push(routine.instructions,edit,routine.operands.length); ignored=try words.push(routine.instructions,edit,0);
    ignored=try words.push(routine.instructions,edit,-9223372036854775807-1); ignored=try words.push(routine.instructions,edit,0);
    ignored=try words.push(routine.instructions,edit,1); ignored=try words.push(routine.instructions,edit,0);
    ignored=try words.push(routine.instructions,edit,0); ignored=try words.push(routine.instructions,edit,0); routine.instructions.frozen=true;
    try rejected(harness,2,0,"orphan-instruction-before-backlink"); routine.instructions.length=length;
    length=routine.edges.length; routine.edges.frozen=false;
    ignored=try words.push(routine.edges,edit,1); ignored=try words.push(routine.edges,edit,0); ignored=try words.push(routine.edges,edit,0); routine.edges.frozen=true;
    try rejected(harness,2,0,"orphan-edge"); routine.edges.length=length;
    try close(harness);
}
function diamond() fails budget.LimitError,verify.InvalidIR,ProbeError {
    let harness be try create([meta.pred(),meta.i64()],[meta.i64()]); let routine be harness.routine;
    let entry be try build.block(routine,[meta.pred(),meta.i64()]); let left be try build.block(routine,[]); let right be try build.block(routine,[]); let join be try build.block(routine,[]);
    let test be try build.parameter(routine,entry,0); let initial be try build.parameter(routine,entry,1);
    try build.branch(routine,entry,test,left,[],right,[],harness.location);
    let partial be try build.integer(routine,left,9,harness.location); try build.jump(routine,left,join,[],harness.location);
    try build.jump(routine,right,join,[],harness.location); try build.returnValues(routine,join,[partial],harness.location); try build.complete(routine);
    try rejected(harness,4,4,"diamond-nondominance");
    let edit be try budget.constructionPhase(harness.owner); try change(routine.operands,edit,1,initial.index); try accepted(harness,4,"diamond-dominance");
    try change(routine.edges,edit,0,1); try rejected(harness,2,1,"entry-predecessor"); try change(routine.edges,edit,0,left.index);
    // Edge 1's owner is also referenced as the second branch edge.
    try change(routine.instructions,edit,8,1); try rejected(harness,2,1,"duplicate-edge-owner"); try close(harness);
}
function loop() fails budget.LimitError,verify.InvalidIR,ProbeError {
    let harness be try create([meta.i64(),meta.i64(),meta.pred()],[meta.i64()]); let routine be harness.routine;
    let entry be try build.block(routine,[meta.i64(),meta.i64(),meta.pred()]); let header be try build.block(routine,[meta.i64(),meta.i64()]); let done be try build.block(routine,[meta.i64()]);
    let a be try build.parameter(routine,entry,0); let b be try build.parameter(routine,entry,1); let test be try build.parameter(routine,entry,2);
    let x be try build.parameter(routine,header,0); let y be try build.parameter(routine,header,1);
    try build.jump(routine,entry,header,[a,b],harness.location); try build.branch(routine,header,test,header,[y,x],done,[x],harness.location);
    try build.returnValues(routine,done,[try build.parameter(routine,done,0)],harness.location); try build.complete(routine);
    try accepted(harness,3,"loop-swap"); let edit be try budget.constructionPhase(harness.owner);
    try change(routine.arguments,edit,0,x.index); try rejected(harness,4,1,"header-value-in-predecessor"); try change(routine.arguments,edit,0,a.index);
    try change(routine.arguments,edit,0,test.index); try rejected(harness,2,1,"edge-type"); try change(routine.arguments,edit,0,a.index);
    try change(routine.edges,edit,2,1); try rejected(harness,2,0,"edge-range"); try close(harness);
}
function dead() fails budget.LimitError,verify.InvalidIR,ProbeError {
    let harness be try create([meta.i64()],[meta.i64()]); let routine be harness.routine;
    let entry be try build.block(routine,[meta.i64()]); let first be try build.block(routine,[meta.i64()]); let second be try build.block(routine,[]);
    try build.returnValues(routine,entry,[try build.parameter(routine,entry,0)],harness.location);
    try build.returnValues(routine,first,[try build.parameter(routine,first,0)],harness.location);
    try build.returnValues(routine,second,[try build.parameter(routine,first,0)],harness.location); try build.complete(routine);
    try accepted(harness,1,"typed-unreachable"); let edit be try budget.constructionPhase(harness.owner);
    try change(routine.instructions,edit,20,99); try rejected(harness,2,3,"malformed-unreachable"); try close(harness);
}
function repeatedTarget() fails budget.LimitError,verify.InvalidIR,ProbeError {
    let harness be try create([meta.i64(),meta.i64(),meta.pred()],[meta.i64()]); let routine be harness.routine;
    let entry be try build.block(routine,[meta.i64(),meta.i64(),meta.pred()]); let target be try build.block(routine,[meta.i64()]);
    let a be try build.parameter(routine,entry,0); let b be try build.parameter(routine,entry,1); let test be try build.parameter(routine,entry,2);
    try build.branch(routine,entry,test,target,[a],target,[b],harness.location); try build.returnValues(routine,target,[try build.parameter(routine,target,0)],harness.location); try build.complete(routine);
    try accepted(harness,2,"repeated-target-arguments"); try check((try build.edgeArgument(routine,1,0)).index != (try build.edgeArgument(routine,2,0)).index,"edge distinctions preserved"); try close(harness);
}
function limits() fails budget.LimitError,verify.InvalidIR,ProbeError {
    let harness be try straight(); let live be harness.owner.live; let phase be try budget.phase(harness.owner,100);
    let unexpected be verify.verify(harness.routine,phase) else error budget.LimitError {
        try check(error.category == "resource-limit" and harness.owner.live == live and harness.owner.pending == 0 and phase.state == 1 and harness.routine.state == 1,"failed verification releases partial scratch");
        try close(harness); output("work-exhaustion:ok"); return;
    } else error verify.InvalidIR { fail error; }; fail ProbeError { message="verification should exhaust its phase"; };
}
function cancellation() fails budget.LimitError,verify.InvalidIR,ProbeError {
    let harness be try straight(); let live be harness.owner.live; let phase be try budget.verificationPhase(harness.owner); budget.cancel(harness.owner);
    let unexpected be verify.verify(harness.routine,phase) else error budget.LimitError {
        try check(error.category == "cancelled" and harness.owner.live == live,"cancelled verification does not publish or allocate");
        try close(harness); output("cancellation:ok"); return;
    } else error verify.InvalidIR { fail error; }; fail ProbeError { message="verification should be cancelled"; };
}
function scalarShapes() fails budget.LimitError,verify.InvalidIR,ProbeError {
    let harness be try create([],[]); let entry be try build.block(harness.routine,[]);
    try build.returnValues(harness.routine,entry,[],harness.location); try build.complete(harness.routine);
    try accepted(harness,1,"zero-result-function"); try close(harness);
    harness=try create([],[meta.f64(),meta.f64()]); entry=try build.block(harness.routine,[]);
    let negativeZero be try build.floatBits(harness.routine,entry,-9223372036854775807-1,harness.location);
    let nan be try build.floatBits(harness.routine,entry,9221120237041090560,harness.location);
    try build.returnValues(harness.routine,entry,[negativeZero,nan],harness.location); try build.complete(harness.routine);
    try accepted(harness,1,"float-bits-multiple-results"); try close(harness);
}

// Positive and malformed predicates are checked independently of builder acceptance.
function predicateOperations() fails budget.LimitError,verify.InvalidIR,ProbeError {
    let harness be try create([meta.pred(),meta.pred(),meta.i64()],[meta.pred()]); let routine be harness.routine;
    let entry be try build.block(routine,[meta.pred(),meta.pred(),meta.i64()]);
    let first be try build.parameter(routine,entry,0); let second be try build.parameter(routine,entry,1);
    let invalidType be try build.parameter(routine,entry,2);
    let both be try build.andPredicate(routine,entry,first,second,harness.location);
    let result be try build.orPredicate(routine,entry,both,second,harness.location);
    try build.returnValues(routine,entry,[result],harness.location); try build.complete(routine);
    try accepted(harness,1,"predicate-ops");
    let edit be try budget.constructionPhase(harness.owner);
    try change(routine.instructions,edit,7,1); try rejected(harness,2,1,"predicate-payload");
    try change(routine.instructions,edit,7,0);
    try change(routine.instructions,edit,0,4); try rejected(harness,2,1,"predicate-arity");
    try change(routine.instructions,edit,0,13);
    try change(routine.operands,edit,1,invalidType.index); try rejected(harness,2,1,"predicate-type");
    try change(routine.operands,edit,1,second.index);
    try accepted(harness,1,"predicate-restored"); try close(harness);
}
function predicateDead() fails budget.LimitError,verify.InvalidIR,ProbeError {
    let harness be try create([],[meta.pred()]); let routine be harness.routine;
    let entry be try build.block(routine,[]); let dead be try build.block(routine,[]);
    let yes be try build.predicate(routine,entry,true,harness.location);
    try build.returnValues(routine,entry,[yes],harness.location);
    let a be try build.predicate(routine,dead,true,harness.location);
    let b be try build.predicate(routine,dead,false,harness.location);
    let unused be try build.andPredicate(routine,dead,a,b,harness.location);
    try build.returnValues(routine,dead,[unused],harness.location); try build.complete(routine);
    try accepted(harness,1,"predicate-dead-ok");
    let edit be try budget.constructionPhase(harness.owner);
    // Instruction five is the dead-block and operation; payload is its eighth word.
    try change(routine.instructions,edit,47,1);
    try rejected(harness,2,2,"predicate-dead-payload");
    try close(harness);
}


function integerOperations() fails budget.LimitError,verify.InvalidIR,ProbeError {
    let harness be try create([meta.i64(),meta.i64(),meta.pred()],[meta.i64(),meta.pred()]); let routine be harness.routine;
    let entry be try build.block(routine,[meta.i64(),meta.i64(),meta.pred()]);
    let a be try build.parameter(routine,entry,0); let b be try build.parameter(routine,entry,1); let wrong be try build.parameter(routine,entry,2);
    let sum be try build.wrapAdd(routine,entry,a,b,harness.location);
    let compared be try build.compareInteger(routine,entry,a,b,7,harness.location);
    try build.returnValues(routine,entry,[sum,compared],harness.location); try build.complete(routine);
    try accepted(harness,1,"integer-ops");
    let edit be try budget.constructionPhase(harness.owner);
    try change(routine.instructions,edit,7,1); try rejected(harness,2,1,"integer-wrap-payload"); try change(routine.instructions,edit,7,0);
    try change(routine.instructions,edit,17,11); try rejected(harness,2,1,"integer-cmp-relation"); try change(routine.instructions,edit,17,7);
    try change(routine.operands,edit,1,wrong.index); try rejected(harness,2,1,"integer-type"); try change(routine.operands,edit,1,b.index);
    try change(routine.values,edit,12,1); try rejected(harness,2,1,"integer-result-type"); try change(routine.values,edit,12,2);
    try accepted(harness,1,"integer-restored"); try close(harness);
}
function integerDead() fails budget.LimitError,verify.InvalidIR,ProbeError {
    let harness be try create([],[meta.i64()]); let routine be harness.routine;
    let entry be try build.block(routine,[]); let dead be try build.block(routine,[]);
    let zero be try build.integer(routine,entry,0,harness.location);
    try build.returnValues(routine,entry,[zero],harness.location);
    let a be try build.integer(routine,dead,2,harness.location); let b be try build.integer(routine,dead,3,harness.location);
    let sum be try build.wrapMultiply(routine,dead,a,b,harness.location);
    let instruction be routine.instructions.length/10;
    try build.returnValues(routine,dead,[sum],harness.location); try build.complete(routine);
    try accepted(harness,1,"integer-dead-ok");
    let edit be try budget.constructionPhase(harness.owner);
    try change(routine.instructions,edit,(instruction-1)*10+7,1);
    try rejected(harness,2,2,"integer-dead-payload"); try close(harness);
}


function divremContracts() fails budget.LimitError,verify.InvalidIR,ProbeError {
    let harness be try create([meta.i64(),meta.i64(),meta.pred()],[meta.i64(),meta.i64(),meta.i64(),meta.i64()]);
    let routine be harness.routine; let entry be try build.block(routine,[meta.i64(),meta.i64(),meta.pred()]);
    let a be try build.parameter(routine,entry,0); let b be try build.parameter(routine,entry,1);
    let wrong be try build.parameter(routine,entry,2);
    let sd be try build.divideSigned(routine,entry,a,b,harness.location);
    let sr be try build.remainderSigned(routine,entry,a,b,harness.location);
    let ud be try build.divideUnsigned(routine,entry,a,b,harness.location);
    let ur be try build.remainderUnsigned(routine,entry,a,b,harness.location);
    try build.returnValues(routine,entry,[sd,sr,ud,ur],harness.location);
    try build.complete(routine); try accepted(harness,1,"divrem-ops");
    let edit be try budget.constructionPhase(harness.owner);
    try change(routine.instructions,edit,7,1); try rejected(harness,2,1,"divrem-payload"); try change(routine.instructions,edit,7,0);
    try change(routine.instructions,edit,18,1); try rejected(harness,2,1,"divrem-extra"); try change(routine.instructions,edit,18,0);
    try change(routine.operands,edit,1,wrong.index); try rejected(harness,2,1,"divrem-operand-type"); try change(routine.operands,edit,1,b.index);
    // The global canonical-operand-pool scan runs before per-block instruction checks.
    // Reducing the encoded count leaves an unclaimed operand: V2, block 0.
    try change(routine.instructions,edit,3,1); try rejected(harness,2,0,"divrem-arity"); try change(routine.instructions,edit,3,2);
    // Entry parameters occupy value records 0..11; result #1 starts at 12.
    try change(routine.values,edit,12,1); try rejected(harness,2,1,"divrem-result-type"); try change(routine.values,edit,12,2);
    try change(routine.instructions,edit,6,0); try rejected(harness,3,1,"divrem-required-location");
    try change(routine.instructions,edit,6,harness.location.index);
    try accepted(harness,1,"divrem-restored"); try close(harness);
}
function divremDead() fails budget.LimitError,verify.InvalidIR,ProbeError {
    let harness be try create([],[meta.i64()]); let routine be harness.routine;
    let entry be try build.block(routine,[]); let dead be try build.block(routine,[]);
    let zero be try build.integer(routine,entry,0,harness.location);
    try build.returnValues(routine,entry,[zero],harness.location);
    let a be try build.integer(routine,dead,3,harness.location);
    let b be try build.integer(routine,dead,0,harness.location);
    let remainder be try build.remainderSigned(routine,dead,a,b,harness.location);
    let instruction be routine.instructions.length/10;
    try build.returnValues(routine,dead,[remainder],harness.location);
    try build.complete(routine); try accepted(harness,1,"divrem-dead-valid");
    let edit be try budget.constructionPhase(harness.owner);
    try change(routine.instructions,edit,(instruction-1)*10+7,9);
    try rejected(harness,2,2,"divrem-dead-payload"); try close(harness);
}


function floatOperations() fails budget.LimitError,verify.InvalidIR,ProbeError {
    let harness be try create([meta.f64(),meta.f64(),meta.pred()],
        [meta.f64(),meta.f64(),meta.f64(),meta.f64(),meta.f64(),meta.pred()]);
    let routine be harness.routine; let entry be try build.block(routine,[meta.f64(),meta.f64(),meta.pred()]);
    let a be try build.parameter(routine,entry,0); let b be try build.parameter(routine,entry,1);
    let wrong be try build.parameter(routine,entry,2);
    let sum be try build.addFloat(routine,entry,a,b,harness.location);
    let sub be try build.subtractFloat(routine,entry,a,b,harness.location);
    let mul be try build.multiplyFloat(routine,entry,a,b,harness.location);
    let div be try build.divideFloat(routine,entry,a,b,harness.location);
    let neg be try build.negateFloat(routine,entry,a,harness.location);
    let cmp be try build.compareFloat(routine,entry,a,b,6,harness.location);
    try build.returnValues(routine,entry,[sum,sub,mul,div,neg,cmp],harness.location);
    try build.complete(routine); try accepted(harness,1,"float-ops");
    let edit be try budget.constructionPhase(harness.owner);
    try change(routine.instructions,edit,7,1); try rejected(harness,2,1,"float-payload"); try change(routine.instructions,edit,7,0);
