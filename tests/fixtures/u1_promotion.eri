function passthrough() fails budget.LimitError,verify.InvalidIR,ProbeError {
    let harness be try create([meta.i64(),meta.pred()],[meta.i64()],true); let routine be harness.routine;
    let entry be try build.block(routine,[meta.i64(),meta.pred()]); let left be try build.block(routine,[meta.i64()]); let right be try build.block(routine,[meta.i64()]); let join be try build.block(routine,[meta.i64()]);
    let value be try build.parameter(routine,entry,0); try build.branch(routine,entry,try build.parameter(routine,entry,1),left,[value],right,[value],harness.location);
    try build.jump(routine,left,join,[try build.parameter(routine,left,0)],harness.location); try build.jump(routine,right,join,[try build.parameter(routine,right,0)],harness.location);
    try build.returnValues(routine,join,[try build.parameter(routine,join,0)],harness.location); try build.complete(routine); try promoted(harness,"passthrough",0,0);
