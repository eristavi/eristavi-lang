function failedOutput() fails budget.LimitError,verify.InvalidIR,ProbeError {
    let harness be try create([],[meta.i64()],true); let routine be harness.routine; let entry be try build.block(routine,[]);
    try initialize(harness,entry,1); try finish(harness,entry,1);
    let pilot be try promote.promote(routine,try budget.promotionPhase(harness.owner)); let quota be pilot.work-1; try build.close(pilot.routine);
    let live be harness.owner.live; let traffic be harness.owner.traffic; let root be routine.instructions.root;
    let phase be try budget.phase(harness.owner,quota);
    // Deterministic fault injection at the end of rebuilding, not a qualification
    // threshold. Post-verification has its own phase and is not in pilot.work.
    let unexpected be promote.promote(routine,phase) else error budget.LimitError {
        try check(error.category == "resource-limit" and harness.owner.live == live and harness.owner.pending == 0 and phase.state == 1,"partial output must be discarded");
        try check(phase.used >= quota-7 and harness.owner.traffic > traffic and routine.instructions.root == root and routine.state == 1,"late failure provenance and immutable input");
        try close(harness); output("partial-output:ok"); return;
    } else error verify.InvalidIR { fail error; }; fail ProbeError { message="late promotion quota ignored"; };
}
function cancelled() fails budget.LimitError,verify.InvalidIR,ProbeError {
    let harness be try create([],[meta.i64()],true); let entry be try build.block(harness.routine,[]);
    try initialize(harness,entry,1); try finish(harness,entry,1); let live be harness.owner.live;
    let phase be try budget.promotionPhase(harness.owner); budget.cancel(harness.owner);
    let unexpected be promote.promote(harness.routine,phase) else error budget.LimitError {
        try check(error.category == "cancelled" and harness.owner.live == live and harness.owner.pending == 0 and phase.used == 0,"cancelled promotion cannot allocate/publish");
        try close(harness); output("cancelled:ok"); return;
    } else error verify.InvalidIR { fail error; }; fail ProbeError { message="cancelled promotion completed"; };
}

// Pure eager predicate operations preserve truth tables through promotion.
function predicateTruth() fails budget.LimitError,verify.InvalidIR,ProbeError {
    let harness be try create([meta.pred(),meta.pred()],[meta.pred(),meta.pred()],true); let routine be harness.routine;
    let entry be try build.block(routine,[meta.pred(),meta.pred()]);
    let first be try build.parameter(routine,entry,0); let second be try build.parameter(routine,entry,1);
    let both be try build.andPredicate(routine,entry,first,second,harness.location);
    let either be try build.orPredicate(routine,entry,first,second,harness.alternate);
    try build.returnValues(routine,entry,[both,either],harness.location);
    try build.complete(routine); try promoted(harness,"pred-truth",0,0);
}
// SSA promotion must not silently drop op 13/14 when reconstructing a join.
function predicateMerge() fails budget.LimitError,verify.InvalidIR,ProbeError {
    let harness be try create([meta.pred(),meta.pred()],[meta.pred(),meta.pred()],true); let routine be harness.routine;
    let entry be try build.block(routine,[meta.pred(),meta.pred()]);
    let left be try build.block(routine,[]); let right be try build.block(routine,[]); let join be try build.block(routine,[]);
    let a be try build.parameter(routine,entry,0); let b be try build.parameter(routine,entry,1);
