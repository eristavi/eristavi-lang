 let n2 be try meta.declaration(data,p,n2sig,imports.nestedListName(false,2),2,63,1);
 let n3sig be try sig.signature(data,g,p,[outerCarrier,carrier],[outerCarrier]);
 let n3 be try meta.declaration(data,p,n3sig,imports.nestedListName(false,3),2,63,1);
 let n4sig be try sig.signature(data,g,p,[outerCarrier,intType,carrier],[outerCarrier]);
 let n4 be try meta.declaration(data,p,n4sig,imports.nestedListName(false,4),2,63,1);
 let n5sig be try sig.signature(data,g,p,[outerCarrier],[intType]);
 let n5 be try meta.declaration(data,p,n5sig,imports.nestedListName(false,5),2,63,1);
 let n6sig be try sig.signature(data,g,p,[outerCarrier,intType],[carrier]);
 let n6 be try meta.declaration(data,p,n6sig,imports.nestedListName(false,6),2,63,1);
 let n7sig be try sig.signature(data,g,p,[],[]);
