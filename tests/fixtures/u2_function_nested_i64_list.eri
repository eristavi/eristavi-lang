function run() fails budget.LimitError,verify.InvalidIR,lists.Unsupported,integrated.Unsupported,roots.InvalidManagedRoots,ssa.InvalidLiveness,managed.InvalidManagedTypes,graphVerify.InvalidGraph {
 let root be try budget.developmentRequest(); let shared be try budget.metadataOwner(root);
 let p be try budget.constructionPhase(shared); let data be try meta.create(shared,p);
 let entrySig be try meta.signature(data,p,[],[meta.i64()]);
 let source be try meta.source(data,p,"list-probe","0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",64);
 let loc be try meta.location(data,p,source,0,1,0,1,1);
 let g be try aggregate.create(shared,p); let intType be try aggregate.primitive(g,meta.i64());
 let text be try aggregate.aggregate(g,p,[]);
