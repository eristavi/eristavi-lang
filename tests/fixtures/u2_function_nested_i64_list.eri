 try aggregate.freeze(g);
 let managedTable be try managed.create(g,p);
 let managedList be try managed.listOfBase(managedTable,p,intType);
 let nestedType be try managed.listOfManaged(managedTable,p,managedList);
 try managed.freeze(managedTable); try meta.freeze(data);
 let table be try contracts.create(data,g,p);
 try contracts.freeze(table); try budget.finishPhase(p);
 let owner be try budget.functionOwner(root,false); let phase be try budget.constructionPhase(owner);
 let fn be try build.create(data,entrySig,owner,phase);
 let b be try build.block(fn,[]);
 let loop be try ab.block(fn,g,[carrier,carrier]);
 let body be try ab.block(fn,g,[carrier,carrier]);
 let done be try ab.block(fn,g,[carrier,carrier]);
 let zero be try build.integer(fn,b,0,loc);
 if false { try build.jump(fn,b,b,[zero],loc); }
 let scalar be try build.integer(fn,b,946,loc);
 let ten be scalar;
 let limit be try build.integer(fn,b,3,loc);
 let call be try ab.call(fn,g,b,f1,[],loc); let empty be try build.result(fn,call,0);
 call=try ab.call(fn,g,b,f3,[empty,ten],loc); let initial be try build.result(fn,call,0);
 try ab.jump(fn,g,b,loop,[initial,initial],loc);
 let current be try build.parameter(fn,loop,0); let snapshot be try build.parameter(fn,loop,1);
 call=try ab.call(fn,g,loop,f5,[current],loc); let count be try build.result(fn,call,0);
 let condition be try build.compareInteger(fn,loop,count,limit,3,loc);
 try ab.branch(fn,g,loop,condition,body,[current,snapshot],done,[current,snapshot],loc);
 let growing be try build.parameter(fn,body,0); let retained be try build.parameter(fn,body,1);
 call=try ab.call(fn,g,body,f3,[growing,ten],loc); let next be try build.result(fn,call,0);
 call=try ab.call(fn,g,body,f7,[],loc);
 try ab.jump(fn,g,body,loop,[next,retained],loc);
