 call=try ab.call(fn,g,done,f5,[resultList],loc); let newCount be try build.result(fn,call,0);
 let replacementScalar be try build.integer(fn,done,955,loc);
 let replacement be replacementScalar;
 call=try ab.call(fn,g,done,f2,[resultList],loc); let copied be try build.result(fn,call,0);
 call=try ab.call(fn,g,done,f4,[copied,zero,replacement],loc); let changed be try build.result(fn,call,0);
 call=try ab.call(fn,g,done,f7,[],loc);
 call=try ab.call(fn,g,done,n1,[],loc); let outerEmpty be try build.result(fn,call,0);
 call=try ab.call(fn,g,done,n3,[outerEmpty,resultList],loc); let outerOne be try build.result(fn,call,0);
 call=try ab.call(fn,g,done,n3,[outerOne,resultList],loc); let outerOriginal be try build.result(fn,call,0);
 call=try ab.call(fn,g,done,n2,[outerOriginal],loc); let outerCopy be try build.result(fn,call,0);
 call=try ab.call(fn,g,done,n4,[outerCopy,zero,changed],loc); let outerChanged be try build.result(fn,call,0);
 call=try ab.call(fn,g,done,n7,[],loc);
 call=try ab.call(fn,g,done,n6,[outerOriginal,zero],loc); let originalInner be try build.result(fn,call,0);
 call=try ab.call(fn,g,done,n6,[outerChanged,zero],loc); let changedInner be try build.result(fn,call,0);
 call=try ab.call(fn,g,done,f3,[changedInner,replacement],loc); let detachedInner be try build.result(fn,call,0);
 call=try ab.call(fn,g,done,f5,[detachedInner],loc); let detachedCount be try build.result(fn,call,0);
 call=try ab.call(fn,g,done,n6,[outerChanged,zero],loc); let innerSnapshot be try build.result(fn,call,0);
 call=try ab.call(fn,g,done,f5,[innerSnapshot],loc); let innerCount be try build.result(fn,call,0);
 call=try ab.call(fn,g,done,n5,[outerOriginal],loc); let outerCount be try build.result(fn,call,0);
 call=try ab.call(fn,g,done,f6,[originalInner,zero],loc); let originalText be try build.result(fn,call,0);
 call=try ab.call(fn,g,done,f6,[changedInner,zero],loc); let changedText be try build.result(fn,call,0);
 let oldEqual be try build.compareInteger(fn,done,originalText,ten,1,loc);
 let secondCheck be try build.block(fn,[]); let good be try build.block(fn,[]); let bad be try build.block(fn,[]);
 try ab.branch(fn,g,done,oldEqual,secondCheck,[],bad,[],loc);
 let newEqual be try build.compareInteger(fn,secondCheck,changedText,replacement,1,loc);
 try ab.branch(fn,g,secondCheck,newEqual,good,[],bad,[],loc);
 let initialAnswer be try build.wrapAdd(fn,good,oldCount,newCount,loc);
 let withOuter be try build.wrapAdd(fn,good,initialAnswer,outerCount,loc);
 let withInner be try build.wrapAdd(fn,good,withOuter,innerCount,loc);
 let answer be try build.wrapAdd(fn,good,withInner,detachedCount,loc);
 try build.returnValues(fn,good,[answer],loc); let wrong be try build.integer(fn,bad,-1,loc);
 try build.returnValues(fn,bad,[wrong],loc); try ab.complete(fn,g);
 let read be try budget.constructionPhase(owner);
 try integrated.emit(fn,g,table,read,managedTable,[text,carrier,outerCarrier],[managed.text(managedTable),managedList,nestedType],true,96);
 try budget.finishPhase(read); try build.close(fn); try budget.finishPhase(phase);
 try contracts.close(table);
 try managed.close(managedTable); try aggregate.close(g); try meta.close(data); try budget.close(owner); try budget.close(shared); try budget.close(root);
}
run() else error budget.LimitError { output(error.message); process.setExitCode(1); }
else error verify.InvalidIR { output(error.message); process.setExitCode(1); }
else error managed.InvalidManagedTypes { output(error.message); process.setExitCode(1); }
else error graphVerify.InvalidGraph { output(error.message); process.setExitCode(1); }
else error integrated.Unsupported { output("native:"+error.message); process.setExitCode(1); }
else error roots.InvalidManagedRoots { output("roots:"+error.message); process.setExitCode(1); }
