 let equalText be try meta.declaration(data,p,equalSig,textNative.name(4),2,63,1);
 let n1sig be try sig.signature(data,g,p,[],[outerCarrier]);
 let n1 be try meta.declaration(data,p,n1sig,imports.nestedListName(false,1),2,63,1);
