{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Eristavi",
  "scopeName": "source.eristavi",
  "fileTypes": ["eri"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#operators" },
    { "include": "#calls" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.eristavi",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.eristavi",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.eristavi",
              "match": "\\\\(?:[\\\"'nrt0]|u\\{[0-9A-Fa-f]+\\})"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.eristavi",
          "match": "(?<![A-Za-z0-9_])(?:[0-9]+\\.[0-9]+(?:[eE][+-]?[0-9]+)?|[0-9]+[eE][+-]?[0-9]+)(?![A-Za-z0-9_])"
        },
        {
          "name": "constant.numeric.integer.eristavi",
          "match": "(?<![A-Za-z0-9_])[0-9]+(?![A-Za-z0-9_])"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.function.definition.eristavi",
          "match": "\\b(?:function|fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.function.eristavi" }
          }
        },
        {
          "name": "meta.type.definition.eristavi",
          "match": "\\b(?:type|record|error|resource)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.type.eristavi" }
          }
        },
        {
          "name": "meta.import.eristavi",
          "match": "\\b(?:import|from|as)\\b",
          "captures": {
            "0": { "name": "keyword.control.import.eristavi" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.eristavi",
          "match": "\\b(?:if|else|while|for|in|return|break|continue|match|case|try|catch|handle|with|defer)\\b"
        },
        {
          "name": "storage.modifier.eristavi",
          "match": "\\b(?:fixed|maybe|identity|checked|public|private|mutable)\\b"
        },
        {
          "name": "keyword.declaration.eristavi",
          "match": "\\b(?:function|fn|type|record|error|resource|let|var|import|from|as)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.builtin.eristavi",
          "match": "\\b(?:Int|Float|Bool|Text|List|None|Void)\\b"
        },
        {
          "name": "entity.name.type.eristavi",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.eristavi",
          "match": "\\b(?:true|false)\\b"
        },
        {
          "name": "constant.language.none.eristavi",
          "match": "\\b(?:none|null)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.eristavi",
          "match": "(?:==|!=|<=|>=|->|=>|\\+|-|\\*|/|%|<|>|=|!|&&|\\|\\||\\?|\\.)"
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "name": "meta.function-call.eristavi",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.eristavi" }
          }
        }
      ]
    }
  }
}
