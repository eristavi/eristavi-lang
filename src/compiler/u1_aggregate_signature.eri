// U1b opt-in structural signatures stored in the EXISTING canonical Metadata
// signatures/types/buckets pools (6-word signatures, 64 buckets). The primitive
// U1a APIs, 14-field Metadata object and public ABI are unchanged.
// Requires the owner-scoped immutable aggregate type graph. This is a
// construction adapter, not another executable IR or AST type system.
import compiler.u1_budget as budget;
import compiler.u1_words as words;
import compiler.u1_meta as meta;
import compiler.u1_aggregate as aggregate;

function check(data identity meta.Metadata,graph identity aggregate.Registry,
    phase identity budget.Phase) fails budget.LimitError {
    try budget.poll(data.owner);
    if data.closed or data.frozen or graph.state == 2 or
       graph.owner != data.owner or phase.owner != data.owner {
        try budget.reject("U1b signatures require mutable shared metadata and same-owner type graph");
    }
}

function sequence(graph identity aggregate.Registry,phase identity budget.Phase,
    values,seed Int) returns Int fails budget.LimitError {
    let hash be seed; let index be 0;
    while index < values.count {
        let value be values[index]; try aggregate.valid(graph,value);
        try budget.work(phase,1);
        hash=(hash*131+value.index)%2147483629;
        index=index+1;
    }
    return (hash*131+values.count)%2147483629;
}
function same(data identity meta.Metadata,phase identity budget.Phase,
    offset Int,values) returns Bool fails budget.LimitError {
    let item be 0;
    while item < values.count {
        let value be values[item];
        if try words.get(data.types,phase,offset+item) != value.index { return false; }
        item=item+1;
    }
    return true;
}
public function signature(data identity meta.Metadata,graph identity aggregate.Registry,
    phase identity budget.Phase,parameters,results)
    returns meta.SignatureId fails budget.LimitError {
    try check(data,graph,phase);
    let hash be try sequence(graph,phase,results,
        try sequence(graph,phase,parameters,17));
    let bucket be hash%64;
    let cursor be try words.get(data.buckets,phase,bucket);
    while cursor != 0 {
        let offset be (cursor-1)*6;
        if try words.get(data.signatures,phase,offset) == hash and
           try words.get(data.signatures,phase,offset+3) == parameters.count and
           try words.get(data.signatures,phase,offset+5) == results.count {
            let first be try words.get(data.signatures,phase,offset+2);
            let second be try words.get(data.signatures,phase,offset+4);
            if try same(data,phase,first,parameters) and
               try same(data,phase,second,results) {
                return meta.SignatureId { owner=data.key; index=cursor; };
            }
        }
        cursor=try words.get(data.signatures,phase,offset+1);
    }
    if data.signatures.length/6 >= 65536 or
       parameters.count > data.types.limit-data.types.length or
       results.count > data.types.limit-data.types.length-parameters.count {
        try budget.exceed(data.owner,1,0);
    }
    let first be data.types.length; let i be 0;
    while i < parameters.count {
        let value be parameters[i];
        let ignored be try words.push(data.types,phase,value.index);
        i=i+1;
    }
    let second be data.types.length; i=0;
    while i < results.count {
        let value be results[i];
        let ignored be try words.push(data.types,phase,value.index);
        i=i+1;
    }
    let record be data.signatures.length/6+1;
    let previous be try words.get(data.buckets,phase,bucket);
    let ignored be try words.push(data.signatures,phase,hash);
    ignored=try words.push(data.signatures,phase,previous);
    ignored=try words.push(data.signatures,phase,first);
    ignored=try words.push(data.signatures,phase,parameters.count);
    ignored=try words.push(data.signatures,phase,second);
    ignored=try words.push(data.signatures,phase,results.count);
    try words.set(data.buckets,phase,bucket,record);
    return meta.SignatureId { owner=data.key; index=record; };
}
// These views do not use scalar-only meta.typeAt on aggregate IDs.
public function parameterType(data identity meta.Metadata,
    graph identity aggregate.Registry,phase identity budget.Phase,
    value meta.SignatureId,index Int)
    returns aggregate.TypeId fails budget.LimitError {
    let count be try meta.parameterCount(data,phase,value);
    if index < 0 or index >= count { try budget.reject("aggregate signature parameter index"); }
    let offset be (value.index-1)*6;
    let first be try words.get(data.signatures,phase,offset+2);
    return try aggregate.typeAt(graph,try words.get(data.types,phase,first+index));
}
public function resultType(data identity meta.Metadata,
    graph identity aggregate.Registry,phase identity budget.Phase,
    value meta.SignatureId,index Int)
    returns aggregate.TypeId fails budget.LimitError {
    let count be try meta.resultCount(data,phase,value);
    if index < 0 or index >= count { try budget.reject("aggregate signature result index"); }
    let offset be (value.index-1)*6;
    let first be try words.get(data.signatures,phase,offset+4);
    return try aggregate.typeAt(graph,try words.get(data.types,phase,first+index));
}
