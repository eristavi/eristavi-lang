// Verify the typed IR independently of the semantic analyzer and lowerer.
import compiler.typed_ir as ir;
import compiler.semantic_model as m;
import compiler.lexer;
import compiler.token;
import compiler.diagnostic;

type Active { index Int; next maybe identity Active; }
type State { program identity ir.Program; routine identity ir.Function; active maybe identity Active; declared maybe identity Active; }
function has(active maybe identity Active, index Int) returns Bool {
    let cursor be active; while cursor != none { if cursor.index == index { return true; } cursor=cursor.next; } return false;
}
function child(value maybe identity ir.Node, location identity m.Location) returns identity ir.Node fails m.SemanticError {
    try ir.require(value != none,location,"missing required IR child"); if value != none { return value; } return ir.node(-1,5,location);
}
function operand(state identity State, value maybe identity ir.Node, location identity m.Location) returns identity ir.Node fails m.SemanticError {
    let node be try child(value,location); try expression(state,node);
    try ir.require(ir.scalar(node.valueType),location,"operand requires a scalar value"); return node;
}
function floatLiteral(node identity ir.Node) returns Bool fails m.SemanticError {
    let tokens be lexer.lex(node.text) else error diagnostic.LexError { return try ir.require(false,node.location,"invalid Float literal spelling in IR"); };
    return try ir.require(tokens.count == 2 and tokens[0].kind == token.float() and tokens[0].lexeme == node.text,node.location,"IR Float constant requires exactly one source Float token");
}
function expression(state identity State, node identity ir.Node) returns Bool fails m.SemanticError {
    try ir.require(ir.scalar(node.valueType) or node.valueType == 5,node.location,"unsupported IR value type");
    try ir.require(node.third == none,node.location,"unexpected third expression child");
    if node.kind == 1 {
        try ir.require(ir.scalar(node.valueType) and node.first == none and node.second == none,node.location,"invalid scalar constant");
        if node.valueType == 2 { try floatLiteral(node); }
        if node.valueType == 3 { try ir.require(node.number == 0 or node.number == 1,node.location,"invalid Bool constant"); } return true;
    }
    if node.kind == 2 {
        let item be ir.localAt(state.routine,node.index);
        try ir.require(item != none and has(state.active,node.index),node.location,"local is undeclared or outside its lexical scope");
        if item != none { try ir.require(node.valueType == item.valueType,node.location,"local read type mismatch"); }
        try ir.require(node.first == none and node.second == none,node.location,"unexpected local read child"); return true;
    }
    if node.kind == 3 {
        let first be try operand(state,node.first,node.location);
        try ir.require(node.second == none and first.next == none,node.location,"invalid unary operands");
        if node.text == "not" { try ir.require(node.valueType == 3 and first.valueType == 3,node.location,"not requires Bool"); }
        else { try ir.require(node.text == "-" and (node.valueType == 1 or node.valueType == 2) and first.valueType == node.valueType,node.location,"negation requires Int or Float"); } return true;
    }
    if node.kind == 4 {
        let first be try operand(state,node.first,node.location); let second be try operand(state,node.second,node.location);
        try ir.require(first.next == none and second.next == none and first.valueType == second.valueType,node.location,"binary operand mismatch");
        let op be node.text; let kind be first.valueType;
        if op == "and" or op == "or" { return try ir.require(kind == 3 and node.valueType == 3,node.location,"logical operation requires Bool"); }
        if op == "==" or op == "!=" { return try ir.require(node.valueType == 3,node.location,"equality result requires Bool"); }
        if op == "<" or op == "<=" or op == ">" or op == ">=" { return try ir.require((kind == 1 or kind == 2) and node.valueType == 3,node.location,"ordering requires matching numeric types and a Bool result"); }
        if op == "+" { return try ir.require((kind == 1 or kind == 2 or kind == 4) and node.valueType == kind,node.location,"addition type mismatch"); }
        return try ir.require(((op == "-" or op == "*" or op == "/") and (kind == 1 or kind == 2) or (op == "%" and kind == 1)) and node.valueType == kind,node.location,"unsupported binary operation");
    }
    if node.kind == 6 {
        let first be try operand(state,node.first,node.location);
        return try ir.require(first.next == none and node.second == none and node.valueType == 5,node.location,"output requires one scalar and no result");
    }
    if node.kind == 5 {
        let callee be ir.functionAt(state.program,node.index);
        try ir.require(callee != none and node.second == none,node.location,"unknown call target or invalid call shape");
        if callee != none {
            try ir.require(node.valueType == callee.result,node.location,"call result type mismatch");
            let parameter be callee.locals; let argument be node.first;
            while parameter != none {
                if parameter.parameter {
                    let value be try operand(state,argument,node.location);
                    try ir.require(value.valueType == parameter.valueType,node.location,"call argument type mismatch"); argument=value.next;
                }
                parameter=parameter.next;
            }
            try ir.require(argument == none,node.location,"too many IR arguments");
        }
        return true;
    }
    return try ir.require(false,node.location,"unknown IR expression opcode");
}
function statement(state identity State, node identity ir.Node) returns Bool fails m.SemanticError {
    try ir.require(node.valueType == 5,node.location,"statement must have no value");
    if node.kind == 10 or node.kind == 11 {
        let item be ir.localAt(state.routine,node.index); let value be try operand(state,node.first,node.location);
        try ir.require(item != none and node.second == none and node.third == none and value.next == none,node.location,"invalid local store");
        if item != none {
            try ir.require(item.valueType == value.valueType,node.location,"local store type mismatch");
            if node.kind == 10 {
                try ir.require(not has(state.declared,node.index) and not item.parameter and item.immutable == node.immutable,node.location,"duplicate declaration or fixed contract mismatch");
                state.active=identity Active { index=node.index; next=state.active; };
                state.declared=identity Active { index=node.index; next=state.declared; };
            } else { try ir.require(has(state.active,node.index) and not item.immutable,node.location,"store into fixed or inactive local"); }
        } return false;
    }
    if node.kind == 12 {
        let value be try child(node.first,node.location); try expression(state,value);
        try ir.require(value.next == none and node.second == none and node.third == none,node.location,"invalid discarded expression"); return false;
    }
    if node.kind == 13 or node.kind == 14 {
        let condition be try operand(state,node.first,node.location);
        try ir.require(condition.valueType == 3 and condition.next == none,node.location,"control flow condition requires Bool");
        let thenTerminated be try block(state,try child(node.second,node.location));
        if node.kind == 14 { try ir.require(node.third == none,node.location,"loop cannot have an else block"); return false; }
        let other be node.third; let elseTerminated be false;
        if other != none { elseTerminated=try block(state,other); } return thenTerminated and elseTerminated;
    }
    if node.kind == 15 {
        try ir.require(state.routine.index != -1 and node.second == none and node.third == none,node.location,"invalid entry return or return shape");
        let value be node.first;
        if value == none { try ir.require(state.routine.result == 5,node.location,"missing return value"); }
        else { try expression(state,value); try ir.require(value.next == none and ir.scalar(value.valueType) and value.valueType == state.routine.result,node.location,"return type mismatch"); }
        return true;
    }
    try ir.require(false,node.location,"unknown IR statement opcode"); return false;
}
function block(state identity State, node identity ir.Node) returns Bool fails m.SemanticError {
    try ir.require(node.kind == 0 and node.valueType == 5 and node.second == none and node.third == none,node.location,"invalid IR block");
    let saved be state.active; let cursor be node.first; let terminated be false;
    while cursor != none {
        try ir.require(not terminated,cursor.location,"unreachable instruction after terminator");
        terminated=try statement(state,cursor); cursor=cursor.next;
    }
    state.active=saved; return terminated;
}
function routine(program identity ir.Program, value identity ir.Function) returns Bool fails m.SemanticError {
    try ir.require(ir.scalar(value.result) or value.result == 5,value.body.location,"invalid function result type");
    let state be identity State { program=program; routine=value; active=none; declared=none; };
    let item be value.locals; let count be 0; let sawLocal be false;
    while item != none {
        try ir.require(item.index == count and ir.scalar(item.valueType),value.body.location,"invalid local index or type"); count=count+1;
        if item.parameter {
            try ir.require(not sawLocal and not item.immutable and value.index != -1,value.body.location,"invalid parameter layout");
            state.active=identity Active { index=item.index; next=state.active; };
            state.declared=identity Active { index=item.index; next=state.declared; };
        } else { sawLocal=true; }
        item=item.next;
    }
    let terminated be try block(state,value.body);
    item=value.locals; while item != none { try ir.require(has(state.declared,item.index),value.body.location,"local table entry has no declaration"); item=item.next; }
    return try ir.require(value.result == 5 or terminated,value.body.location,"value function has a path without a return");
}

type NodeSeen { value identity ir.Node; next maybe identity NodeSeen; }
type LocalSeen { value identity ir.Local; next maybe identity LocalSeen; }
type FunctionSeen { value identity ir.Function; next maybe identity FunctionSeen; }
type Shape { nodes maybe identity NodeSeen; locals maybe identity LocalSeen; routines maybe identity FunctionSeen; }
function tree(shape identity Shape, value maybe identity ir.Node) returns Bool fails m.SemanticError {
    if value == none { return true; }
    let seen be shape.nodes;
    while seen != none { try ir.require(seen.value != value,value.location,"IR nodes must form owned acyclic trees"); seen=seen.next; }
    shape.nodes=identity NodeSeen { value=value; next=shape.nodes; };
    try tree(shape,value.first); try tree(shape,value.second); try tree(shape,value.third); return try tree(shape,value.next);
}
function layout(shape identity Shape, value identity ir.Function) returns Bool fails m.SemanticError {
    let seen be shape.routines;
    while seen != none { try ir.require(seen.value != value,value.body.location,"cyclic or shared function table"); seen=seen.next; }
    shape.routines=identity FunctionSeen { value=value; next=shape.routines; };
    let item be value.locals;
    while item != none {
        let prior be shape.locals;
        while prior != none { try ir.require(prior.value != item,value.body.location,"cyclic or shared local table"); prior=prior.next; }
        shape.locals=identity LocalSeen { value=item; next=shape.locals; }; item=item.next;
    }
    return try tree(shape,value.body);
}

public function verify(program identity ir.Program) returns Bool fails m.SemanticError {
    try ir.require(program.entry.index == -1 and program.entry.result == 5 and program.entry.next == none,program.entry.body.location,"invalid IR entry contract");
    let shape be identity Shape { nodes=none; locals=none; routines=none; };
    try layout(shape,program.entry);
    let shapes be program.functions; while shapes != none { try layout(shape,shapes); shapes=shapes.next; }
    let cursor be program.functions; let count be 0;
    while cursor != none {
        try ir.require(cursor.index >= 0,cursor.body.location,"invalid function index");
        let other be cursor.next;
        while other != none { try ir.require(cursor.index != other.index,cursor.body.location,"duplicate function index"); other=other.next; }
        try routine(program,cursor); count=count+1; cursor=cursor.next;
    }
    let index be 0;
    while index < count { try ir.require(ir.functionAt(program,index) != none,program.entry.body.location,"noncontiguous function table"); index=index+1; }
    return try routine(program,program.entry);
}
