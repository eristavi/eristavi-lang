// Opt-in original whole-Function managed-parameter native CFG profile.
// Uses verified canonical SSA liveness at every instruction and block entry.
// Text/List runtime imports reuse the existing verified native adapters;
// The optional checked profile uses canonical typed outcomes, not global flags.
// No frozen source semantics or public ABI changes.
// Defined self calls are opt-in, verified by exact FunctionId/signature.
import compiler.u1_budget as budget;
import compiler.u1_words as words;
import compiler.u1_builder as build;
import compiler.u1_meta as meta;
import compiler.u1_aggregate as aggregate;
import compiler.u1_verify as canonical;
import compiler.u2_ssa_liveness as ssa;
import compiler.u2_invoke_contract as contracts;
import compiler.u2_managed_root_gate as roots;
import compiler.u2_managed_types as managed;
import compiler.u1_aggregate_verify as graphVerify;
import compiler.u2_function_native_imports as nativeImports;
import compiler.u2_list_i64 as listNative;
import compiler.u2_function_contract as body;
import compiler.u2_root_map as checkedRoots;
import compiler.format as format;

public error Unsupported { message Text; }
function require(ok Bool,message Text) fails Unsupported {
    if not ok { fail Unsupported { message=message; }; }
}
function line(value Text) { output("    "+value); }
function slot(index Int) returns Text {
    return format.integer((index-1)*8)+"(%rsp)";
}
function name(base Text,kind Text,index Int) returns Text {
    return base+"_"+kind+"_"+format.integer(index);
}
// All edge sources are staged before ANY block parameter is overwritten.
// This includes self-loop swaps, repeated inputs, and different edges that
// share the same destination. Scratch is separate from every SSA slot.
function emitEdge(base Text,edgeId Int,blocks,edges,arguments,
    scratchOffset Int,outcomeOffset Int) {
    let row be (edgeId-1)*3;
    let target be edges[row];
    let first be edges[row+1];
    let count be edges[row+2];
    let destination be blocks[(target-1)*5];
    output(name(base,"edge",edgeId)+":");
    let i be 0;
    while i < count {
        let argument Int be arguments[first+i];
        if argument < 0 {
            line("movq "+format.integer(outcomeOffset+(0-argument-1)*8)+"(%rsp),%rax");
        } else { line("movq "+slot(argument)+",%rax"); }
        line("movq %rax,"+format.integer(scratchOffset+i*8)+"(%rsp)");
        i=i+1;
    }
    i=0;
    while i < count {
        line("movq "+format.integer(scratchOffset+i*8)+"(%rsp),%rax");
        line("movq %rax,"+slot(destination+i));
        i=i+1;
    }
    line("jmp "+name(base,"block",target));
}
// Delegate native operation semantics to the SAME owned runtime entrypoints
// proven by the original Text and List adapters. The new code only adapts
// their boxed scalar ABI to this Function's raw i64 SSA stack convention.
// All calls are pre-admitted against immutable metadata before any emission.
function emitNativeImport(result Int,first Int,operands,
    kind Int,operation Int,tempOffset Int,base Text,id Int) {
    if kind == 1 {
        if operation == 1 {
            line("movq "+slot(operands[first])+",%rdi");
            line("call erist_rt_unicode_from_scalar");
        }
        if operation == 2 {
            line("movq "+slot(operands[first])+",%rdi");
            line("movq "+slot(operands[first+1])+",%rsi");
            line("call erist_rt_text_concat");
        }
        if operation == 3 or operation == 12 {
            line("movq "+slot(operands[first])+",%rdi");
            if operation == 3 { line("call evn_copy"); }
            else { line("call erist_rt_unicode_normalize_nfc"); }
        }
        if operation == 4 {
            line("movl $5,%edi");
            line("movq "+slot(operands[first])+",%rsi");
            line("movq "+slot(operands[first+1])+",%rdx");
            line("call erist_rt_text_binary");
            line("movq 8(%rax),%rax");
        }
        if operation == 5 or operation == 6 or operation == 7 or
            operation == 9 or operation == 10 or operation == 11 {
            let viewType be 15;
            if operation == 6 or operation == 10 { viewType=16; }
            if operation == 7 or operation == 11 { viewType=17; }
            line("movl $"+format.integer(viewType)+",%edi");
            line("movq "+slot(operands[first])+",%rsi");
            line("call evn_view");
            line("movq %rax,"+format.integer(tempOffset)+"(%rsp)");
            line("movq %rax,%rdi");
            if operation <= 7 { line("call erist_rt_view_count"); }
            else {
                line("movq "+slot(operands[first+1])+",%rsi");
                line("call erist_rt_view_index");
            }
            if operation <= 9 { line("movq 8(%rax),%rax"); }
        }
        if operation == 8 {
            line("xorl %edi,%edi");
            line("call erist_rt_slots_collect");
            line("call erist_rt_text_collect");
        } else { line("movq %rax,"+slot(result)); }
    }
    if kind == 2 {
        if operation == 4 or operation == 6 {
            // The existing standalone List adapter validates the index
            // against the live object length before any mutation or copy.
            line("movq "+slot(operands[first])+",%rdi");
            line("call erist_rt_graph_object_of");
            line("movq "+slot(operands[first+1])+",%rcx");
            line("testq %rcx,%rcx");
            line("js "+name(base,"bounds",id));
            line("cmpq 0(%rax),%rcx");
            line("jae "+name(base,"bounds",id));
        }
        if operation == 1 {
            line("movl $7,%edi");
            line("xorl %esi,%esi");
            line("call evn_object");
        }
        if operation == 2 {
            line("movq "+slot(operands[first])+",%rdi");
            line("call evn_copy");
        }
        if operation == 3 {
            // Reuse original List snapshot/append semantics, with one extra
            // exact class-1 root for each allocating intermediate.
            line("movq "+slot(operands[first])+",%rdi");
            line("call evn_copy");
            line("movq %rax,"+format.integer(tempOffset)+"(%rsp)");
            line("movq "+slot(operands[first+1])+",%rdi");
            line("call evn_int");
            line("movq %rax,"+format.integer(tempOffset+8)+"(%rsp)");
            line("movq "+format.integer(tempOffset)+"(%rsp),%rdi");
            line("movq "+format.integer(tempOffset+8)+"(%rsp),%rsi");
            line("call evn_add");
            line("movq "+format.integer(tempOffset)+"(%rsp),%rax");
        }
        if operation == 4 {
            // Preserve snapshot value and replacement box in registered
            // class-1 temporary roots across allocating native helpers.
            line("movq "+slot(operands[first])+",%rdi");
            line("call evn_copy");
            line("movq %rax,"+format.integer(tempOffset)+"(%rsp)");
            line("movq "+slot(operands[first+2])+",%rdi");
            line("call evn_int");
            line("movq %rax,"+format.integer(tempOffset+8)+"(%rsp)");
            line("movq "+format.integer(tempOffset)+"(%rsp),%rdi");
            line("movq "+slot(operands[first+1])+",%rsi");
            line("call evn_index_ref");
            line("movq %rax,%rdi");
            line("movq "+format.integer(tempOffset+8)+"(%rsp),%rsi");
            line("call evn_store");
            line("movq "+format.integer(tempOffset)+"(%rsp),%rax");
        }
        if operation == 5 {
            line("movq "+slot(operands[first])+",%rdi");
            line("call evn_count");
            line("movq 8(%rax),%rax");
        }
        if operation == 6 {
            line("movq "+slot(operands[first])+",%rdi");
            line("movq "+slot(operands[first+1])+",%rsi");
            line("call evn_index");
            line("movq 8(%rax),%rax");
        }
        if operation == 7 { line("call erist_rt_text_collect"); }
        else { line("movq %rax,"+slot(result)); }
    }
}
function emitSelfCall(base Text,first Int,count Int,operands,
    tempOffset Int,rootOffset Int,checked Bool) {
    let scratchOffset be rootOffset-256;
    let argument be 0;
    while argument < count {
        line("movq "+slot(operands[first+argument])+",%rax");
        line("movq %rax,"+format.integer(scratchOffset+argument*8)+"(%rsp)");
        argument=argument+1;
    }
    line("leaq "+format.integer(scratchOffset)+"(%rsp),%rdi");
    line("leaq "+format.integer(tempOffset)+"(%rsp),%rsi");
    line("movl $2,%edx");
    if checked { line("leaq "+format.integer(tempOffset+16)+"(%rsp),%rcx"); }
    line("call "+base);
}
function emitInstruction(base Text,id Int,frameBytes Int,
    instructions,operands,switches,cases,importKinds,importOperations,
    tempOffset Int,rootCount Int,rootOffset Int,scopeOffset Int,
    returnOffset Int,transferManaged Bool,transferManagedSecond Bool,
    callerRootOffset Int,callerFailureOffset Int,checked Bool) {
    let row be (id-1)*10;
    let op be instructions[row];
    let first be instructions[row+2];
    let count be instructions[row+3];
    let result be instructions[row+4];
    let payload be instructions[row+7];
    if op == 1 or op == 2 {
        line("movabsq $"+format.integer(payload)+",%rax");
        line("movq %rax,"+slot(result));
    }
    if op == 4 {
        line("movq "+slot(operands[first])+",%rax");
        line("testq %rax,%rax");
        line("sete %al"); line("movzbq %al,%rax");
        line("movq %rax,"+slot(result));
    }
    if op == 13 or op == 14 {
        line("movq "+slot(operands[first])+",%rax");
        line("movq "+slot(operands[first+1])+",%rcx");
        if op == 13 { line("andq %rcx,%rax"); }
        else { line("orq %rcx,%rax"); }
        line("testq %rax,%rax");
        line("setne %al"); line("movzbq %al,%rax");
        line("movq %rax,"+slot(result));
    }
    if op >= 15 and op <= 18 {
        line("movq "+slot(operands[first])+",%rax");
        line("movq "+slot(operands[first+1])+",%rcx");
        if op == 15 { line("addq %rcx,%rax"); }
        if op == 16 { line("subq %rcx,%rax"); }
        if op == 17 { line("imulq %rcx,%rax"); }
        if op == 18 {
            line("cmpq %rcx,%rax");
            let condition be "sete";
            if payload == 2 { condition="setne"; }
            if payload == 3 { condition="setl"; }
            if payload == 4 { condition="setle"; }
            if payload == 5 { condition="setg"; }
            if payload == 6 { condition="setge"; }
            if payload == 7 { condition="setb"; }
            if payload == 8 { condition="setbe"; }
            if payload == 9 { condition="seta"; }
            if payload == 10 { condition="setae"; }
            line(condition+" %al"); line("movzbq %al,%rax");
        }
        line("movq %rax,"+slot(result));
    }
    if op == 6 {
        line("jmp "+name(base,"edge",payload));
    }
    if op == 7 {
        line("movq "+slot(operands[first])+",%rax");
        line("testq %rax,%rax");
        line("jne "+name(base,"edge",payload));
        line("jmp "+name(base,"edge",instructions[row+8]));
    }
    if op == 35 {
        let header be (payload-1)*3;
        let start be switches[header];
        let number be switches[header+1];
        line("movq "+slot(operands[first])+",%rax");
        let i be 0;
        while i < number {
            line("movabsq $"+format.integer(cases[(start+i)*2])+",%rcx");
            line("cmpq %rcx,%rax");
            line("je "+name(base,"edge",cases[(start+i)*2+1]));
            i=i+1;
        }
        line("jmp "+name(base,"edge",switches[header+2]));
    }
    if op == 34 {
        if importKinds[id-1] == 3 {
            // Arguments remain live in the caller's registered vector until
            // the child publishes its own roots. The child transfers managed
            // results into our registered temporary words before scope leave.
            emitSelfCall(base,first,count,operands,tempOffset,rootOffset,false);
            line("movq %rax,"+slot(result));
            if instructions[row+5] == 2 {
                line("movq %rdx,"+slot(result+1));
            }
        } else {
            emitNativeImport(result,first,operands,
                importKinds[id-1],importOperations[id-1],tempOffset,base,id);
        }
    }
    if op == 46 {
        emitSelfCall(base,first,count,operands,tempOffset,rootOffset,true);
        line("movq %rax,"+format.integer(returnOffset)+"(%rsp)");
        line("movq %rdx,"+format.integer(returnOffset+8)+"(%rsp)");
        line("cmpq $0,%r10");
        line("jne "+name(base,"checked_failed",id));
        line("cmpq $0,"+format.integer(tempOffset+16)+"(%rsp)");
        line("jne erist_rt_value_fault_internal");
        line("jmp "+name(base,"edge",instructions[row+8]));
        output(name(base,"checked_failed",id)+":");
        line("cmpq $1,%r10");
        line("jne erist_rt_value_fault_internal");
        line("testq %rax,%rax");
        line("je erist_rt_value_fault_internal");
        line("cmpq %rax,"+format.integer(tempOffset+16)+"(%rsp)");
        line("jne erist_rt_value_fault_internal");
        line("jmp "+name(base,"edge",instructions[row+8]+1));
    }
    if op == 8 or op == 47 {
        if count >= 1 { line("movq "+slot(operands[first])+",%rax"); }
        else { line("xorl %eax,%eax"); }
        if count >= 2 { line("movq "+slot(operands[first+1])+",%rdx"); }
        else { line("xorl %edx,%edx"); }
        // A managed result transfers into an ALREADY REGISTERED caller root
        // before the callee retires any class-1 root or leaves its scope.
        // No collecting runtime call may intervene in this transfer window.
        if op == 8 and (transferManaged or transferManagedSecond) {
            line("movq "+format.integer(callerRootOffset)+"(%rsp),%rdi");
            line("testq %rdi,%rdi");
            line("je erist_rt_value_fault_internal");
            if transferManaged {
                line("testq %rax,%rax");
                line("je erist_rt_value_fault_internal");
                line("movq %rax,(%rdi)");
            }
            if transferManagedSecond {
                line("testq %rdx,%rdx");
                line("je erist_rt_value_fault_internal");
                line("movq %rdx,8(%rdi)");
            }
        }
        if checked {
            line("movq "+format.integer(callerFailureOffset)+"(%rsp),%rdi");
            line("testq %rdi,%rdi");
            line("je erist_rt_value_fault_internal");
            if op == 47 {
                line("testq %rax,%rax");
                line("je erist_rt_value_fault_internal");
                line("movq %rax,(%rdi)");
            } else { line("movq $0,(%rdi)"); }
        }
        line("movq %rax,"+format.integer(returnOffset)+"(%rsp)");
        line("movq %rdx,"+format.integer(returnOffset+8)+"(%rsp)");
        let root be 0;
        while root < rootCount {
            line("movq $0,"+format.integer(rootOffset+root*8)+"(%rsp)");
            root=root+1;
        }
        line("call evn_void");
        line("movq %rax,%rsi");
        line("movq "+format.integer(scopeOffset)+"(%rsp),%rdi");
        line("call evn_scope_leave");
        line("movq "+format.integer(returnOffset)+"(%rsp),%rax");
        line("movq "+format.integer(returnOffset+8)+"(%rsp),%rdx");
        line("addq $"+format.integer(frameBytes)+",%rsp");
        line("popq %rbx");
        if checked {
            if op == 47 { line("movl $1,%r10d"); }
            else { line("xorl %r10d,%r10d"); }
        }
        line("ret");
    }
}

// A single function-wide class-1 vector is registered before any forced GC.
// The per-ValueId liveness bits are independently verified from the immutable
// canonical IR and placed in original SSA slot order (NOT slot compaction).
function publish(selected,flags,first Int,rootOffset Int) {
    let i be 0;
    while i < selected.count {
        if flags[first+i] == 1 {
            let value Int be selected[i];
            line("movq "+slot(value)+",%rax");
            line("testq %rax,%rax");
            line("je erist_rt_value_fault_internal");
            line("movq %rax,"+format.integer(rootOffset+i*8)+"(%rsp)");
        } else {
            line("movq $0,"+format.integer(rootOffset+i*8)+"(%rsp)");
        }
        i=i+1;
    }
}
function nativeSafepoint(forceGC Bool) {
    if forceGC {
        line("xorl %edi,%edi");
        line("call erist_rt_slots_collect");
        line("call erist_rt_text_collect");
    }
}


// This is real native lowering over an original whole canonical Function,
// with managed (Text/List/identity) values admitted as already boxed inputs
// and block parameters, admitted runtime imports and explicit self calls.
// The typed caller retains its own incoming root until this frame's class-1
// vector is safely registered. Aggregate producers remain unsupported;
// opcode 46 requires the explicit bound checked profile.
// A test flag can force physical GC
// on EVERY block entry to prove exact root lifetime during CFG transitions.
function checkedRootTypes(map identity checkedRoots.Map,
    phase identity budget.Phase,failureType Int) returns Bool fails budget.LimitError {
    let i be 0;
    while i < map.records.length/6 {
        if (try words.get(map.records,phase,i*6+3)) != failureType { return false; }
        i=i+1;
    }
    return true;
}
function verifyCheckedRoots(routine identity build.Function,
    graph identity aggregate.Registry,phase identity budget.Phase,failureType Int)
    fails budget.LimitError,Unsupported {
    let map be checkedRoots.create(routine,graph,phase)
        else error budget.LimitError { fail error; }
        else error checkedRoots.InvalidRoots { fail Unsupported { message=error.message; }; };
    let report be checkedRoots.verify(map,routine,graph,phase)
        else error budget.LimitError { try checkedRoots.close(map); fail error; }
        else error checkedRoots.InvalidRoots {
            try checkedRoots.close(map); fail Unsupported { message=error.message; };
        };
    let compatible be checkedRootTypes(map,phase,failureType)
        else error budget.LimitError { try checkedRoots.close(map); fail error; };
    try checkedRoots.close(map);
    try require(compatible,"checked roots require the exact declared native context type");
}
function compile(plan identity ssa.Plan,routine identity build.Function,
    graph identity aggregate.Registry,table identity contracts.Registry,
    phase identity budget.Phase,registry identity managed.Registry,
    carriers,descriptors,forceGC Bool,label Int,selfTarget Int,checked Bool)
    fails budget.LimitError,canonical.InvalidIR,ssa.InvalidLiveness,Unsupported {
    let proof be try ssa.verify(plan,routine,graph,table,phase);
    let admissible be label >= 1 and label <= 2147483647 and
        proof.tracked >= 1 and proof.tracked <= 64 and
        routine.blocks.length/5 >= 1 and routine.blocks.length/5 <= 64 and
        routine.values.length/4 <= 256 and
        routine.instructions.length/10 <= 512 and
        routine.operands.length <= 2048 and
        routine.edges.length/3 <= 256 and
        routine.arguments.length <= 2048 and
        routine.switches.length/3 <= 64 and routine.cases.length/2 <= 512;
    let signatureStart be (routine.signature.index-1)*6;
    let params be try words.get(routine.metadata.signatures,phase,signatureStart+3);
    let paramStart be try words.get(routine.metadata.signatures,phase,signatureStart+2);
    let results be try words.get(routine.metadata.signatures,phase,signatureStart+5);
    let resultStart be try words.get(routine.metadata.signatures,phase,signatureStart+4);
    if params > 8 or results > 2 or (not checked and results < 1) {
        admissible=false;
    }
    let failureType be 0;
    if checked {
        let failure be body.failureType(routine,graph,table,phase)
            else error budget.LimitError { fail error; }
            else error body.InvalidBody { fail Unsupported { message=error.message; }; };
        failureType=failure.index;
        try verifyCheckedRoots(routine,graph,phase,failureType);
        try require(routine.definedTarget == selfTarget,
            "checked FunctionId differs from its canonical body binding");
    } else { try require(routine.definedTarget == 0,
        "checked body requires the checked native profile"); }
    if selfTarget != 0 {
        try require(selfTarget >= 1 and
            selfTarget <= routine.metadata.declarations.length/6,
            "invalid recursive FunctionId");
        let selfRow be (selfTarget-1)*6;
        let failure be try words.get(table.entries,phase,(selfTarget-1)*2+1);
        try require((try words.get(routine.metadata.declarations,phase,selfRow)) ==
            routine.signature.index and
            (try words.get(routine.metadata.declarations,phase,selfRow+3)) == 1 and
            (try words.get(routine.metadata.declarations,phase,selfRow+4)) == 63 and
            (try words.get(routine.metadata.declarations,phase,selfRow+5)) == 0 and
            ((checked and failure > 0) or (not checked and failure == 0)),
            "recursive target has an incompatible defined outcome signature");
    }
    let managedReturn be false;
    let managedReturnSecond be false;
    let selected be [];
    let textCarrier be 0; let listCarrier be 0;
    let typeRead be try budget.verificationPhase(registry.owner);
    let marker be 0;
    while marker < carriers.count {
        let carrier aggregate.TypeId be carriers[marker];
        let descriptor managed.TypeId be descriptors[marker];
        let desc be try managed.descriptor(registry,typeRead,descriptor);
        if desc.kind == 1 { textCarrier=carrier.index; }
        if desc.kind == 2 and desc.elementDomain == 0 and desc.element == 2 {
            listCarrier=carrier.index;
        }
        marker=marker+1;
    }
    try budget.finishPhase(typeRead);
    let i be 0;
    while i < plan.values.length/4 {
        selected.add(try words.get(plan.values,phase,i*4));
        i=i+1;
    }
    i=0;
    while i < results {
        let ty be try words.get(routine.metadata.types,phase,resultStart+i);
        if failureType != 0 and ty == failureType { admissible=false; }
        if ty != 1 and ty != 2 {
            let found be false; let j be 0;
            while j < plan.types.length {
                if ty == (try words.get(plan.types,phase,j)) { found=true; }
                j=j+1;
            }
            if not found { admissible=false; }
            else {
                if i == 0 { managedReturn=true; }
                else { managedReturnSecond=true; }
            }
        }
        i=i+1;
    }
    // Snapshot the frozen canonical Function tables before emitting any code.
    let blocks be []; i=0;
    while i < routine.blocks.length {
        blocks.add(try words.get(routine.blocks,phase,i)); i=i+1;
    }
    let values be []; i=0;
    while i < routine.values.length {
        values.add(try words.get(routine.values,phase,i)); i=i+1;
    }
    let instructions be []; i=0;
    while i < routine.instructions.length {
        instructions.add(try words.get(routine.instructions,phase,i)); i=i+1;
    }
    let operands be []; i=0;
    while i < routine.operands.length {
        operands.add(try words.get(routine.operands,phase,i)); i=i+1;
    }
    let edges be []; i=0;
    while i < routine.edges.length {
        edges.add(try words.get(routine.edges,phase,i)); i=i+1;
    }
    let arguments be []; i=0;
    while i < routine.arguments.length {
        arguments.add(try words.get(routine.arguments,phase,i)); i=i+1;
    }
    let switches be []; i=0;
    while i < routine.switches.length {
        switches.add(try words.get(routine.switches,phase,i)); i=i+1;
    }
    let cases be []; i=0;
    while i < routine.cases.length {
        cases.add(try words.get(routine.cases,phase,i)); i=i+1;
    }
    // Only typed ingress and phi values may have a managed representation.
    // Producers/boxed aggregates still require their own validated lowering.
    i=0;
    while i < values.count/4 {
        let ty be values[i*4];
        if ty != 1 and ty != 2 {
            let found be false; let j be 0;
            while j < plan.types.length {
                if ty == (try words.get(plan.types,phase,j)) { found=true; }
                j=j+1;
            }
            if not found { admissible=false; }
            if values[i*4+1] != 0 {
                let producer be values[i*4+2];
                if values[i*4+1] != 1 or producer < 1 or
                    producer > instructions.count/10 { admissible=false; }
                else {
                    // Only typed, independently admitted runtime call
                    // instructions can construct managed values here.
                    if instructions[(producer-1)*10] != 34 {
                        admissible=false;
                    }
                }
            }
        }
        i=i+1;
    }
    i=0;
    while i < params {
        let ty be try words.get(routine.metadata.types,phase,paramStart+i);
        let assigned be values[(blocks[0]+i-1)*4];
        if ty != assigned { admissible=false; }
        i=i+1;
    }
    let importKinds be []; let importOperations be [];
    i=0;
    while i < instructions.count/10 {
        let row be i*10;
        let op be instructions[row];
        let importKind be 0; let importOperation be 0;
        if op == 46 {
            if not checked or instructions[row+7] != selfTarget {
                admissible=false;
            }
        }
        if op == 34 {
            if selfTarget != 0 and instructions[row+7] == selfTarget {
                importKind=3;
            } else {
                let resolved be nativeImports.inspect(routine.metadata,graph,phase,
                    instructions[row+7],textCarrier,listCarrier)
                    else error budget.LimitError { fail error; }
                    else error nativeImports.Unsupported {
                        fail Unsupported { message=error.message; };
                    };
                importKind=resolved.kind; importOperation=resolved.operation;
            }
        }
        importKinds.add(importKind); importOperations.add(importOperation);
        if op != 1 and op != 2 and op != 4 and
            op != 6 and op != 7 and op != 8 and
            op != 13 and op != 14 and
            (op < 15 or op > 18) and op != 35 and op != 34 and
            not (checked and (op == 46 or op == 47)) {
            admissible=false;
        }
        if op == 35 {
            let selectedCase be instructions[row+7];
            if selectedCase < 1 or selectedCase > switches.count/3 {
                admissible=false;
            } else {
                if switches[(selectedCase-1)*3+1] > 32 {
                    admissible=false;
                }
            }
        }
        i=i+1;
    }
    i=0;
    while i < edges.count/3 {
        if edges[i*3+2] > 32 { admissible=false; }
        i=i+1;
    }
    try require(admissible,
        "unsupported whole-Function managed producer, opcode or budget");
    // Build the publication product in two bounded sweeps per canonical block,
    // rather than rescanning its linked instruction tail for EVERY SSA/value
    // pair. The independent whole-product verifier below is unchanged: it
    // still reruns original liveEntry/liveBefore/liveAfter for every row.
    // This is only an optimized producer, never an unverified root authority.
    let entryBits be [];
    let beforeBits be [];
    let afterBits be [];
    let rowCount be (instructions.count/10)*selected.count;
    let rowIndex be 0;
    while rowIndex < rowCount {
        beforeBits.add(0); afterBits.add(0);
        rowIndex=rowIndex+1;
    }
    let block be 1;
    while block <= blocks.count/5 {
        let j be 0;
        while j < selected.count {
            let tyId be build.ValueId { owner=routine.key; index=selected[j]; };
            let blockId be build.BlockId { owner=routine.key; index=block; };
            let bit be 0;
            if try ssa.liveEntry(plan,routine,phase,blockId,tyId) { bit=1; }
            entryBits.add(bit); j=j+1;
        }
        // Preserve the original linked instruction order; global IDs may be
        // interleaved across blocks. The canonical verifier already checked
        // all reachable AND unreachable chains; retain an additional cap.
        let order be [];
        let cursor be blocks[(block-1)*5+2];
        while cursor != 0 {
            try budget.work(phase,1);
            try require(order.count < instructions.count/10,
                "cyclic canonical instruction list in root publication");
            order.add(cursor);
            cursor=instructions[(cursor-1)*10+9];
        }
        let terminator be blocks[(block-1)*5+4];
        order.add(terminator);
        j=0;
        while j < selected.count {
            let valueId be selected[j];
            let usedLater be 0;
            let position be order.count-1;
            // The output buffers also hold the temporary inclusive/exclusive
            // suffix-use bits; no extra per-value matrix is retained.
            while position >= 0 {
                try budget.work(phase,1);
                let id be order[position];
                let instructionRow be (id-1)*10;
                let outputRow be (id-1)*selected.count+j;
                afterBits[outputRow]=usedLater;
                let first be instructions[instructionRow+2];
                let operandCount be instructions[instructionRow+3];
                let operand be 0;
                while operand < operandCount {
                    try budget.work(phase,1);
                    if operands[first+operand] == valueId { usedLater=1; }
                    operand=operand+1;
                }
                beforeBits[outputRow]=usedLater;
                position=position-1;
            }
            let definition be (valueId-1)*4;
            let kind be values[definition+1];
            let definedAt be values[definition+2];
            let definitionBlock be try words.get(plan.values,phase,j*4+3);
            let defined be kind == 0 or definitionBlock != block;
            let liveOut be (try words.get(plan.outputs,phase,
                (block-1)*selected.count+j)) == 1;
            position=0;
            while position < order.count {
                try budget.work(phase,1);
                let id be order[position];
                let outputRow be (id-1)*selected.count+j;
                let before be defined and (beforeBits[outputRow] == 1 or liveOut);
                if before { beforeBits[outputRow]=1; }
                else { beforeBits[outputRow]=0; }
                // A nonterminal SSA result becomes defined AFTER its
                // producer; terminal instructions cannot define result words.
                if position+1 < order.count and kind == 1 and definedAt == id {
                    defined=true;
                }
                let after be defined and (afterBits[outputRow] == 1 or liveOut);
                if after { afterBits[outputRow]=1; }
                else { afterBits[outputRow]=0; }
                position=position+1;
            }
            j=j+1;
        }
        block=block+1;
    }
    // Verify the entire immutable publication product at one boundary instead
    // of reconstructing the full CFG/liveness twice per instruction. Every
    // entry/before/after row, including dead code, is still independently checked.
    let verifiedPublications be try ssa.verifyPublications(
        plan,routine,graph,table,phase,selected,entryBits,beforeBits,afterBits);
    // Precharge ALL output work. From here only pure string/array operations.
    // Charge exactly the same verified output work, but respect U1a's
    // strict maximum of 1024 units per budget.work() invocation. Large
    // Text/List corpora can otherwise fail with invalid accounting state
    // without ever reaching native emission.
    let remainingWork be instructions.count+values.count+edges.count+
        blocks.count+selected.count*32+128;
    while remainingWork > 0 {
        let charge be remainingWork;
        if charge > 1024 { charge=1024; }
        try budget.work(phase,charge);
        remainingWork=remainingWork-charge;
    }
    let rootOffset be (values.count/4+32)*8;
    // Two additional, class-1 temporary slots preserve native helper
    // intermediates: a List snapshot and boxed i64, or a Unicode view.
    let tempOffset be rootOffset+selected.count*8;
    let temporaryRoots be 2;
    if checked { temporaryRoots=3; }
    let scopeOffset be tempOffset+temporaryRoots*8;
    let returnOffset be scopeOffset+8;
    let callerRootOffset be returnOffset+16;
    let callerFailureOffset be callerRootOffset+8;
    let bytes be callerRootOffset+8;
    if checked { bytes=bytes+8; }
    let frameBytes be ((bytes+15)/16)*16;
    let base be "erist_u2_rooted_function_"+format.integer(label);
    output(".section .rodata");
    output(".p2align 3");
    output(base+"_classes:");
    i=0;
    while i < selected.count {
        let selectedType be values[(selected[i]-1)*4];
        if failureType != 0 and selectedType == failureType { output("    .byte 5"); }
        else { output("    .byte 1"); }
        i=i+1;
    }
    output("    .byte 1"); output("    .byte 1");
    if checked { output("    .byte 5"); }
    i=0;
    while i < selected.count {
        output(".set "+base+"_root_"+format.integer(selected[i])+", "+
            format.integer(rootOffset+i*8));
        i=i+1;
    }
    output(".text");
    output(".globl "+base);
    output(".type "+base+",@function");
    output(base+":");
    line("pushq %rbx");
    line("subq $"+format.integer(frameBytes)+",%rsp");
    line("movq %rdi,%rbx");
    line("movq %rsi,"+format.integer(callerRootOffset)+"(%rsp)");
    if checked {
        line("testq %rcx,%rcx");
        line("je erist_rt_value_fault_internal");
        line("movq %rcx,"+format.integer(callerFailureOffset)+"(%rsp)");
    }
    if managedReturn or managedReturnSecond {
        line("testq %rsi,%rsi");
        line("je erist_rt_value_fault_internal");
    }
    if managedReturnSecond {
        // A second native managed result needs at least two caller root words.
        line("cmpq $2,%rdx");
        line("jb erist_rt_value_fault_internal");
    }
    // Clear full SSA and registered root-vector storage first.
    i=0;
    while i < values.count/4 {
        line("movq $0,"+format.integer(i*8)+"(%rsp)"); i=i+1;
    }
    i=0;
    while i < selected.count+temporaryRoots {
        line("movq $0,"+format.integer(rootOffset+i*8)+"(%rsp)");
        i=i+1;
    }
    line("call evn_scope_enter");
    line("movq %rax,"+format.integer(scopeOffset)+"(%rsp)");
    line("movq %rax,%rdi");
    line("leaq "+format.integer(rootOffset)+"(%rsp),%rsi");
    line("leaq "+base+"_classes(%rip),%rdx");
    line("movl $"+format.integer(selected.count+temporaryRoots)+",%ecx");
    line("call evn_bind_roots");
    if params > 0 {
        line("testq %rbx,%rbx");
        line("je erist_rt_value_fault_internal");
    }
    let firstEntry be blocks[0];
    i=0;
    while i < params {
        line("movq "+format.integer(i*8)+"(%rbx),%rax");
        let ty be values[(firstEntry+i-1)*4];
        if ty == 1 {
            line("cmpq $1,%rax");
            line("ja erist_rt_value_fault_internal");
        }
        if ty > 6 {
            line("testq %rax,%rax");
            line("je erist_rt_value_fault_internal");
        }
        line("movq %rax,"+slot(firstEntry+i));
        i=i+1;
    }
    line("jmp "+name(base,"block",1));
    block=1;
    while block <= blocks.count/5 {
        output(name(base,"block",block)+":");
        // Phi/edge sources are all staged, transferred and published before
        // this block's first allocating/collecting safepoint.
        publish(selected,entryBits,(block-1)*selected.count,rootOffset);
        // Checked edge results have now moved into their canonical destination
        // slots and exact roots. Only now retire the caller handoff words.
        if checked {
            line("movq $0,"+format.integer(tempOffset)+"(%rsp)");
            line("movq $0,"+format.integer(tempOffset+8)+"(%rsp)");
            line("movq $0,"+format.integer(tempOffset+16)+"(%rsp)");
        }
        nativeSafepoint(forceGC);
        let current be blocks[(block-1)*5+2];
        while current != 0 {
            publish(selected,beforeBits,(current-1)*selected.count,rootOffset);
            emitInstruction(base,current,frameBytes,
                instructions,operands,switches,cases,importKinds,importOperations,
                tempOffset,selected.count+temporaryRoots,rootOffset,scopeOffset,returnOffset,
                managedReturn,managedReturnSecond,callerRootOffset,
                callerFailureOffset,checked);
            publish(selected,afterBits,(current-1)*selected.count,rootOffset);
            // Publish the canonical result before retiring intermediary roots.
            if instructions[(current-1)*10] == 34 {
                line("movq $0,"+format.integer(tempOffset)+"(%rsp)");
                line("movq $0,"+format.integer(tempOffset+8)+"(%rsp)");
            }
            current=instructions[(current-1)*10+9];
        }
        let term be blocks[(block-1)*5+4];
        publish(selected,beforeBits,(term-1)*selected.count,rootOffset);
        emitInstruction(base,term,frameBytes,
            instructions,operands,switches,cases,importKinds,importOperations,
            tempOffset,selected.count+temporaryRoots,rootOffset,scopeOffset,returnOffset,
            managedReturn,managedReturnSecond,callerRootOffset,
            callerFailureOffset,checked);
        block=block+1;
    }
    i=1;
    while i <= edges.count/3 {
        emitEdge(base,i,blocks,edges,arguments,(values.count/4)*8,returnOffset);
        i=i+1;
    }
    output(".size "+base+",.-"+base);
    // Emit exactly the source-aware, terminal bounds handlers used by the
    // original List adapter; labels are Function-qualified to avoid clashes.
    i=1;
    while i <= instructions.count/10 {
        let row be (i-1)*10;
        if importKinds[i-1] == 2 and
            (importOperations[i-1] == 4 or importOperations[i-1] == 6) {
            try listNative.fault(routine,phase,i,instructions[row+6],base);
        }
        i=i+1;
    }
    output(".section .note.GNU-stack,\"\",@progbits");
}
public function emit(routine identity build.Function,
    graph identity aggregate.Registry,table identity contracts.Registry,
    phase identity budget.Phase,registry identity managed.Registry,
    carriers,descriptors,forceGC Bool,label Int)
    fails budget.LimitError,canonical.InvalidIR,ssa.InvalidLiveness,
        roots.InvalidManagedRoots,managed.InvalidManagedTypes,
        graphVerify.InvalidGraph,Unsupported {
    let plan be try roots.create(routine,graph,table,phase,registry,
        carriers,descriptors);
    compile(plan,routine,graph,table,phase,registry,carriers,descriptors,
        forceGC,label,0,false)
        else error budget.LimitError { try ssa.close(plan); fail error; }
        else error canonical.InvalidIR { try ssa.close(plan); fail error; }
        else error ssa.InvalidLiveness { try ssa.close(plan); fail error; }
        else error Unsupported { try ssa.close(plan); fail error; };
    try ssa.close(plan);
}

// Explicitly bind a defined metadata FunctionId to THIS independently
// verified body. Other defined targets still fail closed. No process-global
// recursion counter, shared root storage or unchecked symbol substitution.
public function emitRecursive(routine identity build.Function,
    graph identity aggregate.Registry,table identity contracts.Registry,
    phase identity budget.Phase,registry identity managed.Registry,
    carriers,descriptors,forceGC Bool,label Int,target meta.FunctionId)
    fails budget.LimitError,canonical.InvalidIR,ssa.InvalidLiveness,
        roots.InvalidManagedRoots,managed.InvalidManagedTypes,
        graphVerify.InvalidGraph,Unsupported {
    try require(target.owner == routine.metadata.key and target.index >= 1,
        "foreign recursive FunctionId");
    let plan be try roots.create(routine,graph,table,phase,registry,
        carriers,descriptors);
    compile(plan,routine,graph,table,phase,registry,carriers,descriptors,
        forceGC,label,target.index,false)
        else error budget.LimitError { try ssa.close(plan); fail error; }
        else error canonical.InvalidIR { try ssa.close(plan); fail error; }
        else error ssa.InvalidLiveness { try ssa.close(plan); fail error; }
        else error Unsupported { try ssa.close(plan); fail error; };
    try ssa.close(plan);
}

public function emitChecked(routine identity build.Function,
    graph identity aggregate.Registry,table identity contracts.Registry,
    phase identity budget.Phase,registry identity managed.Registry,
    carriers,descriptors,forceGC Bool,label Int)
    fails budget.LimitError,canonical.InvalidIR,ssa.InvalidLiveness,
        roots.InvalidManagedRoots,managed.InvalidManagedTypes,
        graphVerify.InvalidGraph,Unsupported {
    let plan be try roots.create(routine,graph,table,phase,registry,
        carriers,descriptors);
    compile(plan,routine,graph,table,phase,registry,carriers,descriptors,
        forceGC,label,routine.definedTarget,true)
        else error budget.LimitError { try ssa.close(plan); fail error; }
        else error canonical.InvalidIR { try ssa.close(plan); fail error; }
        else error ssa.InvalidLiveness { try ssa.close(plan); fail error; }
        else error Unsupported { try ssa.close(plan); fail error; };
    try ssa.close(plan);
}
