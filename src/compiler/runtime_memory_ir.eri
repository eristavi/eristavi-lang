// Restricted compiler-private memory operation profile used to break the runtime
// bootstrap cycle. These classes/opcodes are implementation data, not source syntax.
// Class 7 = machine word, 8 = reservation base, 9 = checked derived address.
// Reservation base/length pairs carry verifier-only provenance so unrelated regions
// cannot be mixed by a runtime implementation lowering.

public type Register {
    index Int;
    valueClass Int;
    defined Bool;
    provenance Int;
    next maybe identity Register;
}

public type Instruction {
    kind Int;
    result Int;
    extra Int;
    first Int;
    second Int;
    third Int;
    number Int;
    width Int;
    alignment Int;
    next maybe identity Instruction;
}

public type Program {
    registers maybe identity Register;
    instructions maybe identity Instruction;
}

function powerOfTwo(value Int) returns Bool {
    if value <= 0 { return false; }
    let current be value;
    while current > 1 {
        if current % 2 != 0 { return false; }
        current = current / 2;
    }
    return true;
}

function widthValid(width Int) returns Bool {
    return width == 1 or width == 2 or width == 4 or width == 8;
}

public function registerClass(program identity Program,index Int) returns Int {
    let cursor be program.registers;
    while cursor != none {
        let current be cursor;
        if current.index == index { return current.valueClass; }
        cursor = current.next;
    }
    return -1;
}

function definedAt(program identity Program,index Int) returns Bool {
    let cursor be program.registers;
    while cursor != none {
        let current be cursor;
        if current.index == index { return current.defined; }
        cursor = current.next;
    }
    return false;
}

function provenanceAt(program identity Program,index Int) returns Int {
    let cursor be program.registers;
    while cursor != none {
        let current be cursor;
        if current.index == index { return current.provenance; }
        cursor = current.next;
    }
    return -1;
}

function reset(program identity Program) returns Bool {
    let cursor be program.registers;
    let expected be 0;
    while cursor != none {
        let current be cursor;
        if current.index != expected { return false; }
        if current.valueClass < 7 or current.valueClass > 9 { return false; }
        current.defined = false;
        current.provenance = -1;
        expected = expected + 1;
        if expected > 128 { return false; }
        cursor = current.next;
    }
    return true;
}

function define(program identity Program,index Int,wanted Int,provenance Int) returns Bool {
    let cursor be program.registers;
    while cursor != none {
        let current be cursor;
        if current.index == index {
            if current.valueClass != wanted or current.defined { return false; }
            current.defined = true;
            current.provenance = provenance;
            return true;
        }
        cursor = current.next;
    }
    return false;
}

function input(program identity Program,index Int,wanted Int) returns Bool {
    if index < 0 { return false; }
    return registerClass(program,index) == wanted and definedAt(program,index);
}

function sameReservation(program identity Program,base Int,length Int) returns Bool {
    let first be provenanceAt(program,base);
    let second be provenanceAt(program,length);
    return first >= 0 and first == second;
}

function noInputs(value identity Instruction) returns Bool {
    return value.first == -1 and value.second == -1 and value.third == -1;
}

function verifyInstruction(program identity Program,value identity Instruction) returns Bool {
    // machine-word constant represented in compiler data by a checked Eristavi Int
    if value.kind == 1 {
        return value.extra == -1 and noInputs(value) and value.width == 0 and value.alignment == 0
            and define(program,value.result,7,-1);
    }
    // checked power-of-two align-up; transformed words deliberately lose provenance
    if value.kind == 2 {
        return value.extra == -1 and input(program,value.first,7) and value.second == -1 and value.third == -1
            and value.width == 0 and powerOfTwo(value.alignment) and value.alignment <= 4096
            and define(program,value.result,7,-1);
    }
    // reserve produces both an opaque base and the exact mapped length returned by
    // the platform boundary. The pair receives the same verifier provenance.
    if value.kind == 3 {
        if value.result == value.extra or not input(program,value.first,7) or value.second != -1 or value.third != -1
            or value.width != 0 or value.alignment != 0 { return false; }
        if not define(program,value.result,8,value.result) { return false; }
        return define(program,value.extra,7,value.result);
    }
    // release accepts only a base and exact length originating from one reservation.
    if value.kind == 4 {
        return value.result == -1 and value.extra == -1 and input(program,value.first,8) and input(program,value.second,7)
            and sameReservation(program,value.first,value.second)
            and value.third == -1 and value.width == 0 and value.alignment == 0;
    }
    // derive an address only from a matching reservation pair and a checked offset.
    if value.kind == 5 {
        if value.extra != -1 or not input(program,value.first,8) or not input(program,value.second,7)
            or not input(program,value.third,7) or not sameReservation(program,value.first,value.second)
            or not widthValid(value.width) or not powerOfTwo(value.alignment) or value.alignment > value.width { return false; }
        return define(program,value.result,9,provenanceAt(program,value.first));
    }
    // fixed-width load from a previously checked derived address
    if value.kind == 6 {
        return value.extra == -1 and input(program,value.first,9) and value.second == -1 and value.third == -1
            and widthValid(value.width) and value.alignment == value.width
            and define(program,value.result,7,-1);
    }
    // fixed-width store to a previously checked derived address
    if value.kind == 7 {
        return value.result == -1 and value.extra == -1 and input(program,value.first,9) and input(program,value.second,7)
            and value.third == -1 and widthValid(value.width) and value.alignment == value.width;
    }
    return false;
}

public function verify(program identity Program) returns Bool {
    if not reset(program) { return false; }
    let cursor be program.instructions;
    let count be 0;
    while cursor != none {
        let current be cursor;
        if not verifyInstruction(program,current) { return false; }
        count = count + 1;
        if count > 256 { return false; }
        cursor = current.next;
    }
    return count > 0;
}

function register(index Int,valueClass Int) returns identity Register {
    return identity Register { index=index; valueClass=valueClass; defined=false; provenance=-1; next=none; };
}

function instruction(kind Int,result Int,extra Int) returns identity Instruction {
    return identity Instruction { kind=kind; result=result; extra=extra; first=-1; second=-1; third=-1;
        number=0; width=0; alignment=0; next=none; };
}

public function foundationValid() returns Bool {
    let r0 be register(0,7); let r1 be register(1,7); let r2 be register(2,8); let r3 be register(3,7);
    let r4 be register(4,7); let r5 be register(5,9); let r6 be register(6,7); let r7 be register(7,7);
    r0.next=r1; r1.next=r2; r2.next=r3; r3.next=r4; r4.next=r5; r5.next=r6; r6.next=r7;

    let i0 be instruction(1,0,-1); i0.number=64;
    let i1 be instruction(2,1,-1); i1.first=0; i1.alignment=16;
    let i2 be instruction(3,2,3); i2.first=1;
    let i3 be instruction(1,4,-1); i3.number=32;
    let i4 be instruction(5,5,-1); i4.first=2; i4.second=3; i4.third=4; i4.width=8; i4.alignment=8;
    let i5 be instruction(1,6,-1); i5.number=123;
    let i6 be instruction(7,-1,-1); i6.first=5; i6.second=6; i6.width=8; i6.alignment=8;
    let i7 be instruction(6,7,-1); i7.first=5; i7.width=8; i7.alignment=8;
    let i8 be instruction(4,-1,-1); i8.first=2; i8.second=3;
    i0.next=i1; i1.next=i2; i2.next=i3; i3.next=i4; i4.next=i5; i5.next=i6; i6.next=i7; i7.next=i8;

    let program be identity Program { registers=r0; instructions=i0; };
    return verify(program) and registerClass(program,7) == 7;
}

public function rejectsMixedReservations() returns Bool {
    let r0 be register(0,7); let r1 be register(1,8); let r2 be register(2,7);
    let r3 be register(3,8); let r4 be register(4,7);
    r0.next=r1; r1.next=r2; r2.next=r3; r3.next=r4;
    let i0 be instruction(1,0,-1); i0.number=64;
    let i1 be instruction(3,1,2); i1.first=0;
    let i2 be instruction(3,3,4); i2.first=0;
    let i3 be instruction(4,-1,-1); i3.first=1; i3.second=4;
    i0.next=i1; i1.next=i2; i2.next=i3;
    let program be identity Program { registers=r0; instructions=i0; };
    return not verify(program);
}
