// U2 opt-in canonical Text/Unicode17 native slice. Closed import profile only.
// The opaque structural carrier is Text only under this verified descriptor;
// neither a new source syntax nor a general managed TypeId encoding.
import compiler.u1_budget as budget;
import compiler.u1_words as words;
import compiler.u1_meta as meta;
import compiler.u1_builder as build;
import compiler.u1_aggregate as aggregate;
import compiler.u1_aggregate_signature as signatures;
import compiler.u1_verify as canonical;
import compiler.u1_aggregate_verify as graphVerify;
import compiler.u2_managed_types as managed;
import compiler.u2_invoke_contract as contracts;
import compiler.u2_ssa_liveness as ssa;
import compiler.format as format;

public error Unsupported { message Text; }
function require(ok Bool,message Text) fails Unsupported {
    if not ok { fail Unsupported { message=message; }; }
}
function get(w identity words.Words,p identity budget.Phase,index Int)
    returns Int fails budget.LimitError {
    return try words.get(w,p,index);
}
public function name(op Int) returns Text {
    if op == 1 { return "u2.text.fromScalar"; }
    if op == 2 { return "u2.text.concat"; }
    if op == 3 { return "u2.text.copy"; }
    if op == 4 { return "u2.text.equal"; }
    if op == 5 { return "u2.text.bytes.count"; }
    if op == 6 { return "u2.text.scalars.count"; }
    if op == 7 { return "u2.text.characters.count"; }
    if op == 8 { return "u2.text.collect"; }
    if op == 9 { return "u2.text.bytes.index"; }
    if op == 10 { return "u2.text.scalars.index"; }
    if op == 11 { return "u2.text.characters.index"; }
    if op == 12 { return "u2.text.normalizeNfc"; }
    return "u2.text.recurse";
}
function verify(fn identity build.Function,g identity aggregate.Registry,
    carrier aggregate.TypeId,p identity budget.Phase)
    fails budget.LimitError,canonical.InvalidIR,Unsupported {
    let proof be try canonical.verifyAggregates(fn,g,
        try budget.verificationPhase(fn.owner));
    let resultType be try signatures.resultType(fn.metadata,g,p,fn.signature,0);
    let recursive be fn.metadata.declarations.length == 78;
    let parameters be try meta.parameterCount(fn.metadata,p,fn.signature);
    let allowedParameters be parameters == 0;
    if recursive { allowedParameters=parameters == 2; }
    let allowedReturn be resultType.index == 1 or resultType.index == 2;
    if recursive { allowedReturn=resultType.index == 2; }
    try require(p.owner == fn.owner and p.state == 0 and
        carrier.owner == g.key and carrier.index > 6 and
        (try aggregate.fieldCount(g,p,carrier)) == 0 and
        fn.blocks.length >= 5 and fn.blocks.length <= 320 and
        fn.edges.length <= 1536 and
        fn.values.length/4 <= 128 and fn.instructions.length/10 <= 256 and
        (fn.metadata.declarations.length == 72 or recursive) and
        allowedParameters and
        (try meta.resultCount(fn.metadata,p,fn.signature)) == 1 and
        allowedReturn,
        "unsupported bounded canonical Text profile");
    let op be 1;
    while op <= 12 {
        let d be (op-1)*6;
        let symbol be name(op);
        let first be try get(fn.metadata.declarations,p,d+1);
        try require((try get(fn.metadata.declarations,p,d+2)) == symbol.bytes.count and
            (try get(fn.metadata.declarations,p,d+3)) == 2 and
            (try get(fn.metadata.declarations,p,d+4)) == 63 and
            (try get(fn.metadata.declarations,p,d+5)) == 1,
            "unsupported Text runtime import version or effects");
        let j be 0;
        while j < symbol.bytes.count {
            try require((try get(fn.metadata.symbolBytes,p,first+j)) ==
                symbol.bytes[j],"foreign Text runtime symbol");
            j=j+1;
        }
        let target be meta.FunctionId { owner=fn.metadata.key; index=op; };
        let sig be try meta.functionSignature(fn.metadata,p,target);
        let count be 1;
        if op == 2 or op == 4 or (op >= 9 and op <= 11) { count=2; }
        if op == 8 { count=0; }
        let resultCount be 1;
        if op == 8 { resultCount=0; }
        try require((try meta.parameterCount(fn.metadata,p,sig)) == count and
            (try meta.resultCount(fn.metadata,p,sig)) == resultCount,
            "unsupported Text runtime import arity");
        j=0;
        while j < count {
            let ty be carrier.index;
            if op == 1 or (op >= 9 and op <= 11 and j == 1) { ty=2; }
            try require((try signatures.parameterType(fn.metadata,g,p,sig,j)).index ==
                ty,"unsupported Text runtime argument type");
            j=j+1;
        }
        if resultCount == 1 {
            let ty be carrier.index;
            if op == 4 { ty=1; }
            if op == 5 or op == 6 or op == 7 or op == 9 { ty=2; }
            try require((try signatures.resultType(fn.metadata,g,p,sig,0)).index ==
                ty,"unsupported Text runtime result type");
        }
        op=op+1;
    }
    if recursive {
        // Declaration 13 is a local, closed *self*-call, never an arbitrary
        // external or fallible FunctionId. Exact signature equals this fn.
        let symbol be name(13);
        let d be 72;
        let first be try get(fn.metadata.declarations,p,d+1);
        try require((try get(fn.metadata.declarations,p,d)) == fn.signature.index and
            (try get(fn.metadata.declarations,p,d+2)) == symbol.bytes.count and
            (try get(fn.metadata.declarations,p,d+3)) == 1 and
            (try get(fn.metadata.declarations,p,d+4)) == 0 and
            (try get(fn.metadata.declarations,p,d+5)) == 0,
            "recursive Text call must bind exact local function signature");
        let j be 0;
        while j < symbol.bytes.count {
            try require((try get(fn.metadata.symbolBytes,p,first+j)) ==
                symbol.bytes[j],"foreign recursive Text declaration");
            j=j+1;
        }
        try require((try signatures.parameterType(fn.metadata,g,p,
            fn.signature,0)).index == carrier.index and
            (try signatures.parameterType(fn.metadata,g,p,
            fn.signature,1)).index == 2 and
            (try get(fn.blocks,p,0)) == 1 and
            (try get(fn.blocks,p,1)) == 2 and
            (try get(fn.values,p,0)) == carrier.index and
            (try get(fn.values,p,4)) == 2,
            "recursive Text parameters are not the verified entry roots");
    }
    let i be 1;
    while i <= fn.instructions.length/10 {
        let code be try get(fn.instructions,p,(i-1)*10);
        try require(code == 1 or code == 2 or code == 18 or
            code == 6 or code == 7 or code == 34 or code == 8 or
            (recursive and (code == 15 or code == 16)),
            "Text carrier is not an ordinary structural aggregate");
        if code == 34 {
            let instructionOp be try get(fn.instructions,p,(i-1)*10+7);
            let maximum be 12;
            if recursive { maximum=13; }
            try require(instructionOp >= 1 and instructionOp <= maximum,
                "unknown Text runtime call");
        }
        i=i+1;
    }
}
function line(text Text) { output("    "+text); }
function slot(value Int) returns Text {
    return format.integer((value-1)*8)+"(%rsp)";
}
function load(fn identity build.Function,p identity budget.Phase,
    inst Int,n Int,reg Text) fails budget.LimitError {
    let first be try get(fn.instructions,p,(inst-1)*10+2);
    let value be try get(fn.operands,p,first+n);
    line("movq "+slot(value)+","+reg);
}
// Each recursive invocation allocates its OWN frame and scope record;
// caller roots remain registered while children allocate/collect. This does
// not implement cross-function recursion or precise liveness root retirement.
function emitNative(fn identity build.Function,p identity budget.Phase,
    plan maybe identity ssa.Plan)
    fails budget.LimitError,ssa.InvalidLiveness {
    let recursive be fn.metadata.declarations.length == 78;
    let total be fn.values.length/4;
    let viewSlot be total*8;
    let scopeOffset be viewSlot+8;
    let returnOffset be scopeOffset+8;
    let scratchOffset be returnOffset+8;
    let frame be ((scratchOffset+total*8+15)/16)*16+8;
    output(".section .rodata\nerist_u2_text_classes:");
    let i be 0;
    while i <= total { output(".byte 1"); i=i+1; }
    if recursive {
        // Keep initialized root class bytes in rodata: .bss permits only zero
        // allocation and cannot contain the actual class byte value 1.
        // This bounded single-thread counter prevents native stack overflow.
        output(".bss\n.p2align 3\nerist_u2_text_depth:\n.quad 0");
    }
    output(".text\n.globl erist_u2_text_entry\nerist_u2_text_entry:");
    // The owned graph descriptor kinds 1, 3 and 4 match scalar tags.
    // Unicode view rows 15..17 must have kind 12.
    line("cmpl $1,ev_types+32(%rip)");
    line("jne erist_rt_value_fault_internal");
    line("cmpl $3,ev_types+96(%rip)");
    line("jne erist_rt_value_fault_internal");
    line("cmpl $4,ev_types+128(%rip)");
    line("jne erist_rt_value_fault_internal");
    line("cmpl $12,ev_types+480(%rip)");
    line("jne erist_rt_value_fault_internal");
    line("cmpl $12,ev_types+512(%rip)");
    line("jne erist_rt_value_fault_internal");
    line("cmpl $12,ev_types+544(%rip)");
    line("jne erist_rt_value_fault_internal");
    if recursive {
        line("cmpq $32,erist_u2_text_depth(%rip)");
        line("jae erist_rt_value_fault_internal");
        line("testq %rdi,%rdi");
        line("je erist_rt_value_fault_internal");
        line("testq %rsi,%rsi");
        line("je erist_rt_value_fault_internal");
        line("cmpq $4,0(%rdi)");
        line("jne erist_rt_value_fault_internal");
        line("cmpq $1,0(%rsi)");
        line("jne erist_rt_value_fault_internal");
        line("incq erist_u2_text_depth(%rip)");
    }
    line("subq $"+format.integer(frame)+",%rsp");
    i=1;
    while i <= total { line("movq $0,"+slot(i)); i=i+1; }
    if recursive {
        // Incoming args come from the parent frame, already rooted across
        // evn_scope_enter allocation; register local copies before GC.
        line("movq %rdi,"+slot(1));
        line("movq %rsi,"+slot(2));
    }
    line("movq $0,"+format.integer(viewSlot)+"(%rsp)");
    line("call evn_scope_enter");
    line("movq %rax,"+format.integer(scopeOffset)+"(%rsp)");
    line("movq %rax,%rdi");
    line("movq %rsp,%rsi");
    line("leaq erist_u2_text_classes(%rip),%rdx");
    line("movq $"+format.integer(total+1)+",%rcx");
    line("call evn_bind_roots");
    let currentBlock be 1;
    while currentBlock <= fn.blocks.length/5 {
    output("erist_u2_text_block_"+format.integer(currentBlock)+":");
    let inst be try get(fn.blocks,p,(currentBlock-1)*5+2);
    let terminal be try get(fn.blocks,p,(currentBlock-1)*5+4);
    if inst == 0 { inst=terminal; }
    while inst != 0 {
        let off be (inst-1)*10;
        let code be try get(fn.instructions,p,off);
        let result be try get(fn.instructions,p,off+4);
        if code == 1 {
            line("movabsq $"+format.integer(try get(fn.instructions,p,off+7))+",%rdi");
            line("call evn_int");
            line("movq %rax,"+slot(result));
        }
        if code == 2 {
            line("movq $"+format.integer(try get(fn.instructions,p,off+7))+",%rdi");
            line("call evn_bool");
            line("movq %rax,"+slot(result));
        }
        if code == 15 or code == 16 {
            try load(fn,p,inst,0,"%rdi");
            try load(fn,p,inst,1,"%rsi");
            line("movq 8(%rdi),%rdi");
            if code == 15 { line("addq 8(%rsi),%rdi"); }
            if code == 16 { line("subq 8(%rsi),%rdi"); }
            line("call evn_int");
            line("movq %rax,"+slot(result));
        }
        if code == 18 {
            try load(fn,p,inst,0,"%rdi");
            try load(fn,p,inst,1,"%rsi");
            line("movq 8(%rdi),%rdi");
            line("cmpq 8(%rsi),%rdi");
            let relation be try get(fn.instructions,p,off+7);
            let condition be "e";
            if relation == 2 { condition="ne"; }
            if relation == 3 { condition="l"; }
            if relation == 4 { condition="le"; }
            if relation == 5 { condition="g"; }
            if relation == 6 { condition="ge"; }
            if relation == 7 { condition="b"; }
            if relation == 8 { condition="be"; }
            if relation == 9 { condition="a"; }
            if relation == 10 { condition="ae"; }
            line("set"+condition+" %dil");
            line("movzbl %dil,%edi");
            line("call evn_bool");
            line("movq %rax,"+slot(result));
        }
        if code == 6 or code == 7 {
            let edges be 1;
            if code == 7 {
                edges=2;
                try load(fn,p,inst,0,"%rax");
                line("cmpq $0,8(%rax)");
                line("je erist_u2_text_edge_"+format.integer(inst)+"_1");
            }
            let ordinal be 0;
            while ordinal < edges {
                output("erist_u2_text_edge_"+format.integer(inst)+"_"+format.integer(ordinal)+":");
                let edge be try get(fn.instructions,p,off+7+ordinal);
                try transfer(fn,p,edge,scratchOffset,plan);
                ordinal=ordinal+1;
            }
        }
        if code == 34 {
            let op be try get(fn.instructions,p,off+7);
            if op == 1 {
                try load(fn,p,inst,0,"%rdi");
                line("movq 8(%rdi),%rdi");
                line("call erist_rt_unicode_from_scalar");
            }
            if op == 2 {
                try load(fn,p,inst,0,"%rdi");
                try load(fn,p,inst,1,"%rsi");
                line("call erist_rt_text_concat");
            }
            if op == 3 {
                try load(fn,p,inst,0,"%rdi");
                line("call evn_copy");
            }
            if op == 4 {
                line("movl $5,%edi");
                try load(fn,p,inst,0,"%rsi");
                try load(fn,p,inst,1,"%rdx");
                line("call erist_rt_text_binary");
            }
            if op == 5 or op == 6 or op == 7 or op == 9 or op == 10 or op == 11 {
                let kind be 15;
                if op == 6 or op == 10 { kind=16; }
                if op == 7 or op == 11 { kind=17; }
                line("movl $"+format.integer(kind)+",%edi");
                try load(fn,p,inst,0,"%rsi");
                line("call evn_view");
                line("movq %rax,"+format.integer(viewSlot)+"(%rsp)");
                line("movq %rax,%rdi");
                if op == 5 or op == 6 or op == 7 {
                    line("call erist_rt_view_count");
                } else {
                    try load(fn,p,inst,1,"%rsi");
                    line("movq 8(%rsi),%rsi");
                    line("call erist_rt_view_index");
                }
                line("movq $0,"+format.integer(viewSlot)+"(%rsp)");
            }
            if op == 12 {
                try load(fn,p,inst,0,"%rdi");
                line("call erist_rt_unicode_normalize_nfc");
            }
            if op == 13 {
                try load(fn,p,inst,0,"%rdi");
                try load(fn,p,inst,1,"%rsi");
                line("call erist_u2_text_entry");
                line("movq %rax,%rdi");
                line("call evn_int");
            }
            if op == 8 {
                line("xorl %edi,%edi");
                line("call erist_rt_slots_collect");
                line("call erist_rt_text_collect");
            } else {
                line("movq %rax,"+slot(result));
            }
        }
        if code == 8 {
            try load(fn,p,inst,0,"%rax");
            line("movq 8(%rax),%rax");
            line("movq %rax,"+format.integer(returnOffset)+"(%rsp)");
            line("call evn_void");
            line("movq %rax,%rsi");
            line("movq "+format.integer(scopeOffset)+"(%rsp),%rdi");
            line("call evn_scope_leave");
            line("movq "+format.integer(returnOffset)+"(%rsp),%rax");
            if recursive { line("decq erist_u2_text_depth(%rip)"); }
            line("addq $"+format.integer(frame)+",%rsp");
            line("ret");
        }
        // A freshly verified canonical SSA plan may retire selected Text
        // slots after their final use. Every result has been published and
        // every allocating helper has returned before the slot is cleared.
        // Recursive self-calls and nonselected profiles remain conservative.
        if code != 6 and code != 7 and code != 8 {
            if plan != none {
                let at be build.InstId { owner=fn.key; index=inst; };
                let selected be 0;
                while selected < plan.values.length/4 {
                    let value be try get(plan.values,p,selected*4);
                    let word be build.ValueId { owner=fn.key; index=value; };
                    if not (try ssa.liveAfter(plan,fn,p,at,word)) {
                        line("movq $0,"+slot(value));
                    }
                    selected=selected+1;
                }
            }
        }
        if inst == terminal { inst=0; }
        else {
            inst=try get(fn.instructions,p,off+9);
            if inst == 0 { inst=terminal; }
        }
    }
    currentBlock=currentBlock+1;
    }
    output(".section .note.GNU-stack,\"\",@progbits");
}
// Simultaneous edge captures preserve SSA swaps without an allocating call
// between raw scratch storage and destination root publication.
function transfer(fn identity build.Function,p identity budget.Phase,
    edge Int,scratch Int,plan maybe identity ssa.Plan)
    fails budget.LimitError,ssa.InvalidLiveness {
    let target be try get(fn.edges,p,(edge-1)*3);
    let first be try get(fn.edges,p,(edge-1)*3+1);
    let count be try get(fn.edges,p,(edge-1)*3+2);
    let parameter be try get(fn.blocks,p,(target-1)*5);
    let item be 0;
    while item < count {
        let value be try get(fn.arguments,p,first+item);
        line("movq "+slot(value)+",%rax");
        line("movq %rax,"+format.integer(scratch+item*8)+"(%rsp)");
        item=item+1;
    }
    item=0;
    while item < count {
        line("movq "+format.integer(scratch+item*8)+"(%rsp),%rax");
        line("movq %rax,"+slot(parameter+item));
        item=item+1;
    }
    // All predecessor sources have been simultaneously captured and
    // successor parameters installed, with no allocating calls in between.
    // Clearing a dead predecessor word therefore cannot invalidate a
    // branch destination, including a loop backedge or parallel swap.
    if plan != none {
        let targetId be build.BlockId { owner=fn.key; index=target; };
        let tracked be 0;
        while tracked < plan.values.length/4 {
            let value be try get(plan.values,p,tracked*4);
            let word be build.ValueId { owner=fn.key; index=value; };
            if not (try ssa.liveEntry(plan,fn,p,targetId,word)) {
                line("movq $0,"+slot(value));
            }
            tracked=tracked+1;
        }
    }
    line("jmp erist_u2_text_block_"+format.integer(target));
}

// The List and Text native adapters share the immutable, independently
// recomputed SSA proof format; neither invents new executable IR opcodes.
function closeProof(plan identity ssa.Plan,table identity contracts.Registry)
    fails budget.LimitError {
    try ssa.close(plan);
    try contracts.close(table);
}
public function emit(fn identity build.Function,g identity aggregate.Registry,
    carrier aggregate.TypeId,p identity budget.Phase)
    fails budget.LimitError,canonical.InvalidIR,Unsupported {
    try verify(fn,g,carrier,p);
    // Avoid expensive proof construction on unaffected single-block cases,
    // and do not alter the separately tested recursive Text-frame contract.
    if fn.blocks.length == 5 or fn.metadata.declarations.length == 78 {
        try emitNative(fn,p,none)
            else error budget.LimitError { fail error; }
            else error ssa.InvalidLiveness {
                fail Unsupported { message=error.message; };
            };
        return;
    }
    let tracked be 0; let value be 1;
    while value <= fn.values.length/4 {
        if (try get(fn.values,p,(value-1)*4)) == carrier.index {
            tracked=tracked+1;
        }
        value=value+1;
    }
    // The exact bounded plan accepts <=32 selected Text SSA values.
    // Retain the previous safe conservative profile beyond that bound.
    if tracked > 32 {
        try emitNative(fn,p,none)
            else error budget.LimitError { fail error; }
            else error ssa.InvalidLiveness {
                fail Unsupported { message=error.message; };
            };
        return;
    }
    let metadataPhase be try budget.constructionPhase(fn.metadata.owner);
    let table be contracts.create(fn.metadata,g,metadataPhase)
        else error budget.LimitError { try budget.finishPhase(metadataPhase); fail error; };
    contracts.freeze(table)
        else error budget.LimitError {
            try contracts.close(table); try budget.finishPhase(metadataPhase); fail error;
        };
    try budget.finishPhase(metadataPhase);
    let plan be ssa.create(fn,g,table,p,[carrier])
        else error ssa.InvalidLiveness {
            try contracts.close(table); fail Unsupported { message=error.message; };
        }
        else error canonical.InvalidIR { try contracts.close(table); fail error; }
        else error budget.LimitError { try contracts.close(table); fail error; };
    let proof be ssa.verify(plan,fn,g,table,p)
        else error ssa.InvalidLiveness {
            try closeProof(plan,table); fail Unsupported { message=error.message; };
        }
        else error canonical.InvalidIR { try closeProof(plan,table); fail error; }
        else error budget.LimitError { try closeProof(plan,table); fail error; };
    emitNative(fn,p,plan)
        else error budget.LimitError { try closeProof(plan,table); fail error; }
        else error ssa.InvalidLiveness {
            try closeProof(plan,table); fail Unsupported { message=error.message; };
        };
    try closeProof(plan,table);
}
public function emitManaged(fn identity build.Function,g identity aggregate.Registry,
    carrier aggregate.TypeId,p identity budget.Phase,table identity managed.Registry,
    textType managed.TypeId)
    fails budget.LimitError,canonical.InvalidIR,Unsupported,
    managed.InvalidManagedTypes,graphVerify.InvalidGraph {
    let phase be try budget.verificationPhase(table.owner);
    let check be managed.verify(table,g,phase)
        else error budget.LimitError { try budget.finishPhase(phase); fail error; }
        else error managed.InvalidManagedTypes { try budget.finishPhase(phase); fail error; }
        else error graphVerify.InvalidGraph { try budget.finishPhase(phase); fail error; };
    let description be managed.descriptor(table,phase,textType)
        else error budget.LimitError { try budget.finishPhase(phase); fail error; };
    try budget.finishPhase(phase);
    try require(description.kind == 1 and description.elementDomain == 0 and
        description.element == 0 and description.copyPolicy == 1,
        "native Text requires verified immutable managed Text descriptor");
    try emit(fn,g,carrier,p);
}
