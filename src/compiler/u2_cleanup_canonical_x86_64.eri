// Opt-in canonical checked-edge admission for bounded native File cleanup.
// Validates source-neutral UIR and independently checked metadata before output.
// This is not a new executable IR or complete checked-FailureContext lowering.
import compiler.u1_budget as budget;
import compiler.u1_words as words;
import compiler.u1_meta as meta;
import compiler.u1_builder as build;
import compiler.u1_aggregate as aggregate;
import compiler.u1_verify as canonical;
import compiler.u2_scoped_owners as owners;
import compiler.u2_invoke_contract as fallible;
import compiler.u2_root_map as roots;
import compiler.u2_continuation_bind as continuation;
import compiler.u2_cleanup_plan as cleanup;
import compiler.u2_cleanup_verify as planVerify;
import compiler.u2_cleanup_native_x86_64 as native;

public error Unsupported { message Text; }
function require(ok Bool,message Text) fails Unsupported {
    if not ok { fail Unsupported { message=message; }; }
}
function read(w identity words.Words,p identity budget.Phase,index Int)
    returns Int fails budget.LimitError {
    return try words.get(w,p,index);
}

// Bounded canonical ingress for ONE checked File-close call (opcode 46).
// Fresh independent whole-function owner/IR, root-map, continuation and
// cleanup-plan checks precede ANY output. The private File runtime binding
// and actual machine root-word lifetime remain separate qualification gates.
// This function is not arbitrary CFG lowering or a public File ABI.
public function emitCanonical(routine identity build.Function,
    graph identity aggregate.Registry,profile identity owners.Profile,
    contracts identity fallible.Registry,phase identity budget.Phase,
    map identity roots.Map,pair continuation.Pair,instruction build.InstId,
    plan identity cleanup.Plan,active,survive Int,exit meta.LocId,
    initiallyFailed Bool,label Int)
    fails budget.LimitError,canonical.InvalidIR,owners.InvalidOwnership,
        roots.InvalidRoots,continuation.InvalidBinding,
        planVerify.InvalidPlan,Unsupported {
    let ownerProof be try owners.verify(profile,routine,graph,contracts);
    let rootProof be try roots.verify(map,routine,graph,phase);
    let binding be try continuation.verify(routine,graph,phase,pair);
    let prepared be try planVerify.verify(routine.metadata,phase,plan,
        active,survive,exit,initiallyFailed);
    // Closed v1 ingress: one checked close, no carried predecessor owners or
    // in-flight success values. Do not pretend multi-owner or failed-mode
    // continuations are already machine-lowered.
    try require(routine.state == 1 and pair.version == 1 and
        instruction.owner == routine.key and instruction.index >= 1 and
        instruction.index <= routine.instructions.length/10 and
        not initiallyFailed and active.count == 1 and survive == 0 and
        plan.depth == 1 and pair.location == exit and
        label > 0 and label <= 2147483647,
        "unsupported canonical native File cleanup boundary");
    let selected cleanup.Scope be active[0];
    let sourceBase be (pair.source.index-1)*2;
    let ownerFirst be try read(profile.blocks,phase,sourceBase);
    let ownerCount be try read(profile.blocks,phase,sourceBase+1);
    try require(ownerCount == 1 and ownerFirst >= 0 and
        ownerFirst < profile.entries.length/2 and
        (try read(profile.entries,phase,ownerFirst*2)) == selected.scope and
        (try read(profile.entries,phase,ownerFirst*2+1)) == selected.value and
        selected.contract == profile.consume.index and
        selected.close == exit and selected.scope >= 1 and
        selected.scope <= profile.scopes.length/2 and
        (try read(profile.scopes,phase,(selected.scope-1)*2+1)) == exit.index,
        "canonical source owner and cleanup obligation disagree");
    let offset be (instruction.index-1)*10;
    let first be try read(routine.instructions,phase,offset+2);
    let edge be try read(routine.instructions,phase,offset+8);
    try require(first >= 0 and first < routine.operands.length and
        edge >= 1 and edge < routine.edges.length/3 and
        (try read(routine.instructions,phase,offset)) == 46 and
        (try read(routine.instructions,phase,offset+1)) == pair.source.index and
        (try read(routine.instructions,phase,offset+3)) == 1 and
        (try read(routine.instructions,phase,offset+6)) == exit.index and
        (try read(routine.instructions,phase,offset+7)) == selected.contract and
        (try read(routine.blocks,phase,(pair.source.index-1)*5+4)) == instruction.index and
        (try read(routine.operands,phase,first)) == selected.value and
        (try read(routine.edges,phase,(edge-1)*3)) == pair.normal.index and
        (try read(routine.edges,phase,edge*3)) == pair.failure.index and
        (try read(routine.edges,phase,(edge-1)*3+2)) == 0 and
        (try read(routine.edges,phase,edge*3+2)) == 1,
        "canonical checked File-close instruction or successors disagree");
    let slot be try read(routine.blocks,phase,(pair.failure.index-1)*5);
    let found be 0; let index be 0;
    while index < rootProof.roots {
        try budget.work(phase,1);
        let base be index*6;
        if (try read(map.records,phase,base)) == instruction.index {
            try require(slot >= 1 and slot <= routine.values.length/4 and
                (try read(map.records,phase,base+1)) == pair.failure.index and
                (try read(map.records,phase,base+2)) == slot and
                (try read(map.records,phase,base+3)) ==
                    (try read(routine.values,phase,(slot-1)*4)) and
                (try read(map.records,phase,base+4)) == exit.index and
                (try read(map.records,phase,base+5)) == 5,
                "canonical checked failure root does not bind selected edge");
            found=found+1;
        }
        index=index+1;
    }
    try require(found == 1,"missing or ambiguous canonical checked failure root");
    // The native emitter revalidates the complete private plan once again.
    // No output is emitted when any canonical proof above refuses.
    native.emit(routine.metadata,phase,plan,active,survive,exit,false,label)
        else error native.Unsupported {
            fail Unsupported { message=error.message; };
        };
}
