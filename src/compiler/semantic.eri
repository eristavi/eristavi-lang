function handled(context identity m.Context, node identity ast.Node, valueRequired Bool) returns m.Result fails m.SemanticError {
    let value be try expression(context,m.child(node.first),valueRequired,true);
    try require(value.failures != none,context,node,"failure","else error requires an expression with checked failures");
    let covered maybe identity m.Name be none; let catchAll be false; let handler be node.second;
    while handler != none {
        try require(not catchAll,context,handler,"failure","catch-all handler must be last");
        let annotation be handler.first; let errorValue be m.makeType(11,"");
        if annotation != none {
            errorValue=try typeRef(context.owner,annotation);
            try require(errorType(context.owner,errorValue) and not m.has(covered,errorValue.name),context,handler,"failure","handler requires a distinct checked error type");
            covered=m.add(covered,errorValue.name);
        } else { catchAll=true; }
        let saved be context.symbols;
        try declare(context,handler,"error",errorValue,false,false);
        let terminated be try block(context,m.child(handler.second));
        try validate(context,saved); context.symbols=saved;
        if valueRequired { try require(terminated,context,handler,"failure","handler attached to a value expression must terminate the current path"); }
        handler=handler.next;
    }
    try require(catchAll or m.subset(value.failures,covered),context,node,"failure","checked-error handling is incomplete");
