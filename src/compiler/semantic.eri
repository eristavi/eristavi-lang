}
function member(context identity m.Context, node identity ast.Node, allowChecked Bool) returns m.Result fails m.SemanticError {
    let value be try expression(context,m.child(node.first),true,allowChecked); let actual be t.resolve(value.value);
    try require(actual.kind != 8,context,node,"maybe","optional value must be proven present");
    if actual.kind == 0 and node.text == "count" { actual=try t.unify(actual,m.wrap(7,m.makeType(0,"")),location(context,node)); }
    if actual.kind == 9 { actual=t.inner(actual); }
    if actual.kind == 4 and (node.text == "bytes" or node.text == "scalars" or node.text == "characters") { return m.Result { value=m.makeType(12,node.text); failures=value.failures; }; }
    if (actual.kind == 7 or actual.kind == 12 or actual.kind == 13 or actual.kind == 14) and node.text == "count" { return m.Result { value=m.makeType(1,""); failures=value.failures; }; }
    if actual.kind == 11 and node.text == "message" { return m.result(m.makeType(4,"")); }
    if actual.kind == 6 {
