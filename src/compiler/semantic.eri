            if active != none { bytesResult=active.explicitResult and t.resolve(active.result).kind == 13 and returned.kind == ast.listExpr(); }
            if bytesResult { result=try bytesLiteral(context,returned,false); }
            else { result=try expression(context,returned,true,false); }
            let actual be t.resolve(result.value);
