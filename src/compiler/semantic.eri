function construct(context identity m.Context, node identity ast.Node, allowChecked Bool) returns m.Result fails m.SemanticError {
    let value be try resolveName(context.owner,node.text,node); let declaration be layout(context.owner,value.name);
    try require(declaration != none,context,node,"type","type is not constructible");
    let fields be node.first; let provided maybe identity m.Name be none; let failures maybe identity m.Name be none;
    if declaration != none {
        while fields != none {
            try require(not m.has(provided,fields.text),context,fields,"type","field is initialized more than once");
            let field be m.find(declaration.fields,fields.text);
            try require(field != none,context,fields,"type","unknown construction field");
            if field != none {
                let item be try expression(context,m.child(fields.first),true,allowChecked);
                try require(t.resolve(item.value).kind != 10,context,fields,"resource","resources cannot be copied into value fields");
                try t.assign(field.value,item.value,location(context,fields)); failures=m.union(failures,item.failures);
