function expression(context identity m.Context, node identity ast.Node, valueRequired Bool, allowChecked Bool) returns m.Result fails m.SemanticError {
    let value be try evaluate(context,node,valueRequired,allowChecked);
    context.owner.facts=identity m.Fact { node=node; value=value.value; failures=value.failures; next=context.owner.facts; };
    return value;
}
function evaluate(context identity m.Context, node identity ast.Node, valueRequired Bool, allowChecked Bool) returns m.Result fails m.SemanticError {
    let kind be node.kind;
    if kind == ast.literalExpr() {
        let typeKind be 4;
        if node.extra == 2 { typeKind=1; try integerLiteral(node,context); }
        if node.extra == 3 { typeKind=2; }
        if node.extra == 30 or node.extra == 31 { typeKind=3; }
        return m.result(m.makeType(typeKind,""));
    }
    if kind == ast.noneExpr() { return m.result(m.wrap(8,m.makeType(0,""))); }
    if kind == ast.nameExpr() {
        let binding be m.find(context.symbols,node.text);
        if binding != none { return m.result(visible(context,binding)); }
        try require(false,context,node,"name","unknown name or function used as a value: " + node.text);
    }
    if kind == ast.listExpr() {
        let element be m.makeType(0,""); let cursor be node.first; let failures maybe identity m.Name be none;
        while cursor != none { let value be try expression(context,cursor,true,allowChecked); try require(t.resolve(value.value).kind != 5,context,cursor,"type","List elements require ordinary values"); try require(t.resolve(value.value).kind != 10,context,cursor,"resource","resources cannot be copied into Lists"); element=try t.join(element,value.value,location(context,cursor)); failures=m.union(failures,value.failures); cursor=cursor.next; }
        return m.Result { value=m.wrap(7,element); failures=failures; };
    }
    if kind == ast.mapExpr() {
        let keyType be m.makeType(0,""); let valueType be m.makeType(0,""); let cursor be node.first; let failures maybe identity m.Name be none;
        while cursor != none {
            let keyNode be m.child(cursor.first); let valueNode be m.child(cursor.second);
            let key be try expression(context,keyNode,true,allowChecked); let item be try expression(context,valueNode,true,allowChecked);
            try require(t.resolve(key.value).kind != 5 and t.resolve(key.value).kind != 10,context,keyNode,"type","Map keys require ordinary values");
            try require(t.resolve(item.value).kind != 5 and t.resolve(item.value).kind != 10,context,valueNode,"type","Map values require ordinary values");
            keyType=try t.join(keyType,key.value,location(context,keyNode)); valueType=try t.join(valueType,item.value,location(context,valueNode));
            try require(mapKey(keyType),context,keyNode,"type","Map keys currently support only Int, Bool, and Text");
            failures=m.union(failures,m.union(key.failures,item.failures)); cursor=cursor.next;
        }
        return m.Result { value=m.pairType(14,keyType,valueType); failures=failures; };
    }
    if kind == ast.identityExpr() {
        let value be try expression(context,m.child(node.first),true,allowChecked); let actual be t.resolve(value.value);
        try require(actual.kind != 8 and actual.kind != 9 and actual.kind != 10 and actual.kind != 5,context,node,"type","identity requires an ordinary non-resource value");
