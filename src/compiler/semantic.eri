        }
        let actual be try t.unify(left.value,right.value,location(context,node)); let allowed be 3;
        if op == "+" { allowed=7; } if op == "%" { allowed=1; }
        try t.constrain(actual,allowed,location(context,node));
        if op == "<" or op == "<=" or op == ">" or op == ">=" { actual=m.makeType(3,""); }
        return m.Result { value=actual; failures=failures; };
    }
    try require(false,context,node,"unsupported","unimplemented semantic expression"); return m.result(m.makeType(5,""));
}

function rootName(node identity ast.Node) returns Text {
    if node.kind == ast.nameExpr() { return node.text; }
    if node.kind == ast.memberExpr() or node.kind == ast.indexExpr() { return rootName(m.child(node.first)); }
    return "";
}
function statement(context identity m.Context, node identity ast.Node) returns Bool fails m.SemanticError {
