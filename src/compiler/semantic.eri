    try validate(context,saved); context.symbols=saved; context.narrowings=savedNarrowings; return terminated;
}
function enforceFixed(context identity m.Context, value identity m.Type, node identity ast.Node) returns Bool fails m.SemanticError {
    let actual be t.resolve(value);
    if actual.kind == 0 { actual.mustFixed=true; return true; }
    if actual.kind == 7 or actual.kind == 8 { return try enforceFixed(context,t.inner(actual),node); }
    if actual.kind == 14 { try enforceFixed(context,t.inner(actual),node); return try enforceFixed(context,t.other(actual),node); }
    return try require(eligible(context.owner,actual,true,none),context,node,"fixed","fixed requires a transitively immutable ordinary value");
}
function enforceEquality(context identity m.Context, value identity m.Type, node identity ast.Node) returns Bool fails m.SemanticError {
    let actual be t.resolve(value);
    if actual.kind == 0 { actual.mustEqual=true; return true; }
    if actual.kind == 7 or actual.kind == 8 { return try enforceEquality(context,t.inner(actual),node); }
    if actual.kind == 14 { try enforceEquality(context,t.inner(actual),node); return try enforceEquality(context,t.other(actual),node); }
    return try require(eligible(context.owner,actual,false,none),context,node,"type","equality is not defined for this type");
