        return m.result(value.value);
    }
    if kind == ast.handledExpr() { return try handled(context,node,valueRequired); }
    if kind == ast.memberExpr() { return try member(context,node,allowChecked); }
    if kind == ast.constructionExpr() { return try construct(context,node,allowChecked); }
    if kind == ast.callExpr() { return try call(context,node,valueRequired,allowChecked); }
    if kind == ast.indexExpr() {
        let base be m.child(node.first); let index be m.child(node.second);
        let value be try expression(context,base,true,allowChecked); let subscript be try expression(context,index,true,allowChecked); let actual be t.resolve(value.value);
        if actual.kind == 14 {
            try t.assign(t.inner(actual),subscript.value,location(context,index));
            try require(mapKey(t.inner(actual)),context,index,"type","Map keys currently support only Int, Bool, and Text");
            return m.Result { value=t.other(actual); failures=m.union(value.failures,subscript.failures); };
        }
        try t.unify(subscript.value,m.makeType(1,""),location(context,index));
        if actual.kind == 13 { return m.Result { value=m.makeType(1,""); failures=m.union(value.failures,subscript.failures); }; }
        if actual.kind == 0 { actual=try t.unify(actual,m.wrap(7,m.makeType(0,"")),location(context,node)); }
        if actual.kind == 12 { let element be m.makeType(4,""); if actual.name == "bytes" { element=m.makeType(1,""); } return m.Result { value=element; failures=m.union(value.failures,subscript.failures); }; }
        try require(actual.kind == 7,context,node,"type","indexing requires a List, Map, Bytes, or explicit Text view");
        if base.kind == ast.listExpr() and index.kind == ast.literalExpr() {
            let count be 0; let cursor be base.first; while cursor != none { count=count+1; cursor=cursor.next; }
