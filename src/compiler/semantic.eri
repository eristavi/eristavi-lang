public function analyze(owner identity m.Module) returns Bool fails m.SemanticError {
    try prepare(owner);
    let declarations be owner.declarations;
    while declarations != none { let currentDeclaration be declarations; if currentDeclaration.node.kind == ast.functionDecl() { try ensureFunction(declarations,true); } declarations=currentDeclaration.next; }
    let context be newContext(owner); let cursor be owner.root.first;
    while cursor != none {
        if cursor.kind != ast.importDecl() and cursor.kind != ast.functionDecl() and cursor.kind != ast.typeDecl() and cursor.kind != ast.errorDecl() { try statement(context,cursor); }
        cursor=cursor.next;
    }
    try validate(context,none); return true;
}
