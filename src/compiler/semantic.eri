    }
    if kind == ast.unaryExpr() {
        let value be try expression(context,m.child(node.first),true,allowChecked);
        if node.text == "not" { try t.unify(value.value,m.makeType(3,""),location(context,node)); }
        else { let actual be t.resolve(value.value); try require(actual.kind == 1 or actual.kind == 2,context,node,"type","unary minus requires Int or Float"); }
