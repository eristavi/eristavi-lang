// First construction slice only; unsupported U1a operations are rejected.
// 1 const.i64, 2 const.pred, 3 signed add.overflow, 4 pred.not, 5 guard,
// 6 jump, 7 branch, 8 return, 9 const.f64.bits. No fake void value.
// 10 cell.init, 11 cell.read, 12 cell.write: construction only, dynamic cell type.
// 13 pred.and, 14 pred.or: eager pure predicate operations (not source short-circuit).
// 15-17 i64 add/sub/mul.wrap; 18 i64.cmp (1 eq, 2 ne, 3 slt, 4 sle,
// 5 sgt, 6 sge, 7 ult, 8 ule, 9 ugt, 10 uge).
// 19-20 signed sub/mul.overflow; 21-23 unsigned add/sub/mul.overflow.
// 24 i64.div.signed, 25 i64.rem.signed, 26 i64.div.unsigned, 27 i64.rem.unsigned.
// These may trap but are not CFG terminators on successful execution.
// Zero divisor => integer_zero_divisor (2); signed MIN/-1 => integer_overflow (1).
// Operation ID encodes overflow signedness; compare relation encodes signedness.
// 28 f.add, 29 f.sub, 30 f.mul, 31 f.div, 32 f.neg, 33 f.cmp.
// Float comparisons: 1 eq, 2 ne, 3 lt, 4 le, 5 gt, 6 ge.
// These are strict binary64 core operations, not ambient-host Float promises;
// actual native execution requires an independently qualified FP environment.
// Opcode numbers remain private and are not a public serialization contract.
// 34 call.direct: payload FunctionId, signature-derived parameter/result counts.
// 35 switch.i64: selector, sparse case/edge table, exactly one default.
// 36 const.narrow: extra is owned i8/i16/i32 TypeId; payload exact unsigned bits.
public function known(op Int) returns Bool { return (op >= 1 and op <= 9) or isCell(op) or (op >= 13 and op <= 36); }
// Construction cells are exactly 10/11/12; numeric thresholds would misclassify future opcodes.
public function isCell(op Int) returns Bool { return op == 10 or op == 11 or op == 12; }
// Only existing jump/branch edges occupy inline payload/extra slots (maximum two).
// A future multiway switch needs a reviewed side-table edge schema.
public function inlineEdges(op Int) returns Int {
    if op == 6 { return 1; }
    if op == 7 { return 2; }
    return 0;
}
public function terminal(op Int) returns Bool { return op == 6 or op == 7 or op == 8 or op == 35; }
// Potential terminal fault on execution is distinct from a CFG terminator.
// Do not discard a may-trap instruction just because its SSA result is unused.
public function mayTrap(op Int) returns Bool { return op == 5 or (op >= 24 and op <= 27) or op == 34; }
public function observable(op Int) returns Bool { return mayTrap(op) or op == 34; }
public function operands(op Int) returns Int {
    if op == 3 or (op >= 13 and op <= 31) or op == 33 { return 2; } if op == 4 or op == 5 or op == 7 or op == 32 { return 1; }
    if op == 10 or op == 12 or op == 35 { return 1; } if op == 8 or op == 34 { return -1; } return 0;
}
public function results(op Int) returns Int {
    if op == 34 { return -1; }
    if op == 3 or (op >= 19 and op <= 23) { return 2; }
    if op == 1 or op == 2 or op == 4 or op == 9 or op == 11 or (op >= 13 and op <= 18) or (op >= 24 and op <= 33) or op == 36 { return 1; } return 0;
}
public function operandType(op Int,index Int) returns Int { if op >= 28 and op <= 33 { return 3; } if op == 3 or (op >= 15 and op <= 27) or op == 35 { return 2; } return 1; }
public function resultType(op Int,index Int) returns Int {
    if op == 1 or (op == 3 and index == 0) or (op >= 15 and op <= 17) or (op >= 19 and op <= 23 and index == 0) or (op >= 24 and op <= 27) { return 2; }
    if op == 9 or (op >= 28 and op <= 32) { return 3; } return 1;
}

// Strict ascending unsigned i64 bit-pattern order for sparse switch cases.
public function unsignedLess(a Int,b Int) returns Bool {
    if a < 0 and b >= 0 { return false; }
    if a >= 0 and b < 0 { return true; }
    return a < b;
}
