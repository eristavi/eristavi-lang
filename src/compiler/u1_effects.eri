// Independent U1a multi-function effect closure. All operations and dead
// blocks are scanned; recursive call paths and possible CFG backedges are
// conservatively divergent. Imports require a selected, versioned adapter.
import compiler.u1_budget as budget;
import compiler.u1_words as words;
import compiler.u1_meta as meta;
import compiler.u1_builder as build;
import compiler.u1_verify as verify;
import compiler.u1_module as link;
import compiler.u1_imports as imports;
import compiler.u1_successors as succ;

public type Path { target Int; next maybe identity Path; }
public type Summary {
    program identity link.Program; policy identity imports.Policy;
    phase identity budget.Phase; flags identity words.Words;
    colors identity words.Words; queued identity words.Words;
    heads identity words.Words; links identity words.Words;
    queue identity words.Words; closed Bool; edges Int; visits Int;
}
public function has(mask Int,flag Int) returns Bool { return mask/flag%2 == 1; }
public function union(first Int,second Int) returns Int {
    let result be 0; let bit be 1;
    while bit <= 32 {
        if has(first,bit) or has(second,bit) { result=result+bit; }
        bit=bit*2;
    }
    return result;
}
function at(summary identity Summary,id Int) returns Int fails budget.LimitError {
    return try words.get(summary.flags,summary.phase,id-1);
}
function combine(summary identity Summary,id Int,bits Int) returns Bool fails budget.LimitError {
    let old be try at(summary,id); let updated be union(old,bits);
    if updated != old {
        try words.set(summary.flags,summary.phase,id-1,updated);
        return true;
    }
    return false;
}
function linkCaller(summary identity Summary,caller Int,callee Int) fails budget.LimitError {
    let old be try words.get(summary.heads,summary.phase,callee-1);
    let index be summary.links.length/2+1;
    let ignored be try words.push(summary.links,summary.phase,caller);
    ignored=try words.push(summary.links,summary.phase,old);
    try words.set(summary.heads,summary.phase,callee-1,index);
    summary.edges=summary.edges+1;
}
function visit(summary identity Summary,target Int,path maybe identity Path,depth Int)
    fails budget.LimitError {
    if depth > 4096 { try budget.reject("U1a effect graph depth exceeds bounded profile"); }
    let state be try words.get(summary.colors,summary.phase,target-1);
    if state == 2 { return; }
    if state == 1 {
        let cursor be path;
        while cursor != none {
            let ignored be try combine(summary,cursor.target,32);
            if cursor.target == target { return; }
            cursor=cursor.next;
        }
        try budget.reject("invalid U1a DFS recursion stack");
    }
    try words.set(summary.colors,summary.phase,target-1,1);
    let functionId be meta.FunctionId { owner=summary.program.metadata.key; index=target; };
    let routine be try link.resolve(summary.program,functionId);
    let phase be try budget.verificationPhase(routine.owner);
    let here be identity Path { target=target; next=path; };
    let index be 1;
    while index <= routine.instructions.length/10 {
        let offset be (index-1)*10;
        let op be try words.get(routine.instructions,phase,offset);
        if op == 5 or (op >= 24 and op <= 27) or op == 41 or op == 42 {
            let ignored be try combine(summary,target,16);
        }
        if op == 6 or op == 7 or op == 35 {
            let source be try words.get(routine.instructions,phase,offset+1);
            let count be try succ.count(routine,phase,index); let item be 0;
            while item < count {
                let edge be try succ.edge(routine,phase,index,item);
                let next be try words.get(routine.edges,phase,(edge-1)*3);
                if next <= source {
                    let ignored be try combine(summary,target,32);
                }
                item=item+1;
            }
        }
        if op == 34 {
            let callee be try words.get(routine.instructions,phase,offset+7);
            try linkCaller(summary,target,callee);
            let kind be try words.get(summary.program.metadata.declarations,
                summary.phase,(callee-1)*6+3);
            if kind == 1 { try visit(summary,callee,here,depth+1); }
        }
        index=index+1;
    }
    try budget.finishPhase(phase);
    try words.set(summary.colors,summary.phase,target-1,2);
    summary.visits=summary.visits+1;
}
function initialize(summary identity Summary) fails budget.LimitError {
    let data be summary.program.metadata;
    let count be data.declarations.length/6;
    let index be 1;
    while index <= count {
        let kind be try words.get(data.declarations,summary.phase,(index-1)*6+3);
        let mask be 0;
        if kind == 2 {
            let target be meta.FunctionId { owner=data.key; index=index; };
            let selected be try imports.adapter(summary.policy,target);
            mask=try words.get(data.declarations,summary.phase,(index-1)*6+4);
        }
        let ignored be try words.push(summary.flags,summary.phase,mask);
        ignored=try words.push(summary.colors,summary.phase,0);
        ignored=try words.push(summary.queued,summary.phase,1);
        ignored=try words.push(summary.heads,summary.phase,0);
        ignored=try words.push(summary.queue,summary.phase,index);
        index=index+1;
    }
    index=1;
    while index <= count {
        let kind be try words.get(data.declarations,summary.phase,(index-1)*6+3);
        if kind == 1 { try visit(summary,index,none,1); }
        index=index+1;
    }
}
function propagate(summary identity Summary) fails budget.LimitError {
    let offset be 0;
    while offset < summary.queue.length {
        let callee be try words.get(summary.queue,summary.phase,offset);
        try words.set(summary.queued,summary.phase,callee-1,0);
        let actual be try at(summary,callee);
        let linkIndex be try words.get(summary.heads,summary.phase,callee-1);
        while linkIndex != 0 {
            let base be (linkIndex-1)*2;
            let caller be try words.get(summary.links,summary.phase,base);
            if try combine(summary,caller,actual) {
                if try words.get(summary.queued,summary.phase,caller-1) == 0 {
                    let ignored be try words.push(summary.queue,summary.phase,caller);
                    try words.set(summary.queued,summary.phase,caller-1,1);
                }
            }
            linkIndex=try words.get(summary.links,summary.phase,base+1);
        }
        offset=offset+1;
    }
    let data be summary.program.metadata; let index be 1;
    while index <= data.declarations.length/6 {
        let declared be try words.get(data.declarations,summary.phase,(index-1)*6+4);
        let derived be try at(summary,index);
        if union(derived,declared) != declared {
            try budget.reject("understated defined U1a function effect upper bound");
        }
        index=index+1;
    }
}
public function inspect(program identity link.Program,policy identity imports.Policy)
    returns identity Summary fails budget.LimitError,verify.InvalidIR {
    if not program.sealed or program.closed or policy.program != program or
       not policy.frozen or policy.closed {
        try budget.reject("U1a effect analysis requires sealed program and trusted imports");
    }
    // Never trust a previous verifier report, optimization hint or freeze flag.
    let cursor be program.head;
    while cursor != none {
        if cursor.body.state != 1 or cursor.body.revision != cursor.revision {
            try budget.reject("stale function body before effects");
        }
        let checkPhase be try budget.verificationPhase(cursor.body.owner);
        let result be try verify.verify(cursor.body,checkPhase);
        if result.revision != cursor.revision { try budget.reject("stale independent verifier"); }
        cursor=cursor.next;
    }
    let phase be try budget.verificationPhase(program.metadata.owner);
    let owner be program.metadata.owner;
    let summary be identity Summary {
        program=program; policy=policy; phase=phase;
        flags=try words.create(owner,65536); colors=try words.create(owner,65536);
        queued=try words.create(owner,65536); heads=try words.create(owner,65536);
        links=try words.create(owner,4194304); queue=try words.create(owner,4194304);
        closed=false; edges=0; visits=0; };
    try initialize(summary);
    try propagate(summary);
    return summary;
}
public function mask(summary identity Summary,target meta.FunctionId)
    returns Int fails budget.LimitError {
    if summary.closed or target.owner != summary.program.metadata.key or
       target.index < 1 or target.index > summary.flags.length {
        try budget.reject("invalid U1a effect summary lookup");
    }
    return try at(summary,target.index);
}
public function close(summary identity Summary) fails budget.LimitError {
    if summary.closed { try budget.reject("double close of effects"); }
    summary.closed=true;
    try words.close(summary.flags); try words.close(summary.colors);
    try words.close(summary.queued); try words.close(summary.heads);
    try words.close(summary.links); try words.close(summary.queue);
    try budget.finishPhase(summary.phase);
}
