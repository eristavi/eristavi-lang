import std.unicode;
import compiler.source;
import compiler.token;
import compiler.diagnostic;

type Scanner {
    input Text;
    index Int;
    byteIndex Int;
    count Int;
    line Int;
    column Int;
}

// Text is validated UTF-8. Keep a byte cursor internally so looking ahead does
// not rescan the whole immutable source for each scalar. Public locations and
// diagnostic columns still count Unicode scalars.
function widthAt(input Text, index Int) returns Int {
    let first be input.bytes[index];
    if first<128 { return 1; }
    if first<224 { return 2; }
    if first<240 { return 3; }
    return 4;
}

function scalarAtByte(input Text, index Int) returns Text {
    if index>=input.bytes.count { return "\0"; }
    let width be widthAt(input,index); let code be input.bytes[index];
    if width==2 { code=code-192; }
    if width==3 { code=code-224; }
    if width==4 { code=code-240; }
    let part be 1;
    while part<width { code=code*64+input.bytes[index+part]-128; part=part+1; }
    return unicode.fromScalar(code);
}

function peek(scanner identity Scanner, offset Int) returns Text {
    let cursor be scanner.byteIndex; let remaining be offset;
    while remaining>0 and cursor<scanner.input.bytes.count {
        cursor=cursor+widthAt(scanner.input,cursor); remaining=remaining-1;
    }
    return scalarAtByte(scanner.input,cursor);
}

function advance(scanner identity Scanner) returns Text {
    let ch be peek(scanner, 0);
    scanner.index = scanner.index + 1;
    scanner.byteIndex = scanner.byteIndex + ch.bytes.count;
    if ch == "\n" { scanner.line = scanner.line + 1; scanner.column = 1; }
    else { scanner.column = scanner.column + 1; }
    return ch;
}

function digit(ch Text, base Int) returns Bool {
    if base == 2 { return ch == "0" or ch == "1"; }
    if base == 16 { return source.isAsciiHexDigit(ch); }
    return source.isAsciiDigit(ch);
}

function digits(scanner identity Scanner, base Int, line Int, column Int) returns Text fails diagnostic.LexError {
    if not digit(peek(scanner, 0), base) {
        fail diagnostic.LexError { message = "numeric literal requires digits"; line = line; column = column; };
    }
    let raw be "";
    let more be true;
    while more {
        let ch be peek(scanner, 0);
        if digit(ch, base) { raw = raw + advance(scanner); }
        else {
            if ch == "_" {
                if not digit(peek(scanner, 1), base) {
                    fail diagnostic.LexError { message = "numeric underscores must appear only between digits"; line = scanner.line; column = scanner.column; };
                }
                raw = raw + advance(scanner);
            } else { more = false; }
        }
    }
    return raw;
}

function number(scanner identity Scanner) returns token.Token fails diagnostic.LexError {
    let line be scanner.line;
    let column be scanner.column;
    let raw be "";
    let kind be token.integer();
    let base be 10;
    if peek(scanner, 0) == "0" {
        if peek(scanner, 1) == "b" or peek(scanner, 1) == "B" { base = 2; }
        if peek(scanner, 1) == "x" or peek(scanner, 1) == "X" { base = 16; }
    }
    if base != 10 {
        raw = advance(scanner);
        raw = raw + advance(scanner);
        raw = raw + try digits(scanner, base, line, column);
    } else {
        raw = try digits(scanner, 10, line, column);
        let integerPart be raw;
        if peek(scanner, 0) == "." {
            if not source.isAsciiDigit(peek(scanner, 1)) {
                fail diagnostic.LexError { message = "a decimal point in a Float literal requires digits on both sides"; line = scanner.line; column = scanner.column; };
            }
            kind = token.float();
            raw = raw + advance(scanner);
            raw = raw + try digits(scanner, 10, line, column);
        }
        if peek(scanner, 0) == "e" or peek(scanner, 0) == "E" {
            kind = token.float();
            raw = raw + advance(scanner);
            if peek(scanner, 0) == "+" or peek(scanner, 0) == "-" { raw = raw + advance(scanner); }
            if not source.isAsciiDigit(peek(scanner, 0)) {
                fail diagnostic.LexError { message = "Float exponent requires decimal digits"; line = scanner.line; column = scanner.column; };
            }
            raw = raw + try digits(scanner, 10, line, column);
        }
        if kind == token.integer() and integerPart.scalars.count > 1 and integerPart.scalars[0] == "0" {
            fail diagnostic.LexError { message = "decimal Int literals may not have leading zeroes"; line = line; column = column; };
        }
    }
    // Numeric values remain source spelling until the typed literal stage.
    return token.make(kind, raw, raw, line, column);
}

function hexValue(ch Text) returns Int {
    let code be source.asciiCode(ch);
    if code >= 48 and code <= 57 { return code - 48; }
    if code >= 65 and code <= 70 { return code - 55; }
    return code - 87;
}

function textLiteral(scanner identity Scanner) returns token.Token fails diagnostic.LexError {
    let line be scanner.line;
    let column be scanner.column;
    let raw be advance(scanner);
    let value be "";
    while scanner.index < scanner.count and peek(scanner, 0) != "\"" {
        let ch be advance(scanner);
        raw = raw + ch;
        if ch == "\n" or ch == "\r" {
            fail diagnostic.LexError { message = "Text literals may not contain a raw newline"; line = line; column = column; };
        }
        if ch != "\\" { value = value + ch; }
        else {
            if scanner.index >= scanner.count {
                fail diagnostic.LexError { message = "unterminated Text escape"; line = line; column = column; };
            }
            let escape be advance(scanner);
            raw = raw + escape;
            let known be true;
            if escape == "n" { value = value + "\n"; }
            else { if escape == "r" { value = value + "\r"; }
            else { if escape == "t" { value = value + "\t"; }
            else { if escape == "0" { value = value + "\0"; }
            else { if escape == "\"" { value = value + "\""; }
            else { if escape == "\\" { value = value + "\\"; }
            else { known = false; } } } } } }
            if not known {
                if escape != "u" or peek(scanner, 0) != "{" {
                    fail diagnostic.LexError { message = "unsupported Text escape"; line = scanner.line; column = scanner.column; };
                }
                raw = raw + advance(scanner);
                let scalar be 0;
                let size be 0;
                while peek(scanner, 0) != "}" {
                    if scanner.index >= scanner.count or not source.isAsciiHexDigit(peek(scanner, 0)) {
                        fail diagnostic.LexError { message = "invalid Unicode scalar escape"; line = scanner.line; column = scanner.column; };
                    }
                    let item be advance(scanner);
                    raw = raw + item;
                    scalar = scalar * 16 + hexValue(item);
                    size = size + 1;
                    if size > 6 {
                        fail diagnostic.LexError { message = "Unicode scalar escape is too long"; line = scanner.line; column = scanner.column; };
                    }
                }
                raw = raw + advance(scanner);
                if size == 0 {
                    fail diagnostic.LexError { message = "Unicode scalar escape requires hexadecimal digits"; line = scanner.line; column = scanner.column; };
                }
                if scalar > 1114111 or (scalar >= 55296 and scalar <= 57343) {
                    fail diagnostic.LexError { message = "Unicode escape must name a Unicode scalar value"; line = line; column = column; };
                }
                value = value + unicode.fromScalar(scalar);
            }
        }
    }
    if scanner.index >= scanner.count {
        fail diagnostic.LexError { message = "unterminated Text literal"; line = line; column = column; };
    }
    raw = raw + advance(scanner);
    return token.make(token.text(), raw, value, line, column);
}

function blockComment(scanner identity Scanner) fails diagnostic.LexError {
    let line be scanner.line;
    let column be scanner.column;
    advance(scanner); advance(scanner);
    let depth be 1;
    while depth > 0 {
        if scanner.index >= scanner.count {
            fail diagnostic.LexError { message = "unterminated block comment"; line = line; column = column; };
        }
        if peek(scanner, 0) == "/" and peek(scanner, 1) == "*" {
            advance(scanner); advance(scanner); depth = depth + 1;
        } else {
            if peek(scanner, 0) == "*" and peek(scanner, 1) == "/" {
                advance(scanner); advance(scanner); depth = depth - 1;
            } else { advance(scanner); }
        }
    }
}

function symbolKind(spelling Text) returns Int {
    if spelling == "==" { return token.equalEqual(); }
    if spelling == "!=" { return token.bangEqual(); }
    if spelling == "<=" { return token.lessEqual(); }
    if spelling == ">=" { return token.greaterEqual(); }
    if spelling == ";" { return token.semicolon(); }
    if spelling == "," { return token.comma(); }
    if spelling == "." { return token.dot(); }
    if spelling == "(" { return token.leftParen(); }
    if spelling == ")" { return token.rightParen(); }
    if spelling == "{" { return token.leftBrace(); }
    if spelling == "}" { return token.rightBrace(); }
    if spelling == "[" { return token.leftBracket(); }
    if spelling == "]" { return token.rightBracket(); }
    if spelling == "=" { return token.equal(); }
    if spelling == "+" { return token.plus(); }
    if spelling == "-" { return token.minus(); }
    if spelling == "*" { return token.star(); }
    if spelling == "/" { return token.slash(); }
    if spelling == "%" { return token.percent(); }
    if spelling == "<" { return token.less(); }
    if spelling == ">" { return token.greater(); }
    return -1;
}

public function lex(input Text) fails diagnostic.LexError {
    let scanner be identity Scanner { input = input; index = 0; byteIndex = 0; count = input.scalars.count; line = 1; column = 1; };
    // A single initial BOM is ignored, including for source column numbering.
    if peek(scanner, 0) == "\u{FEFF}" { scanner.index = 1; scanner.byteIndex = 3; }
    let cursor be scanner.byteIndex;
    let bomLine be 1;
    let bomColumn be 1;
    while cursor < input.bytes.count {
        let ch be scalarAtByte(input, cursor);
        if ch == "\u{FEFF}" {
            fail diagnostic.LexError { message = "BOM is allowed only at the start of a source file"; line = bomLine; column = bomColumn; };
        }
        if ch == "\n" { bomLine = bomLine + 1; bomColumn = 1; }
        else { bomColumn = bomColumn + 1; }
        cursor = cursor + ch.bytes.count;
    }
    let tokens be [];
    while scanner.index < scanner.count {
        let ch be peek(scanner, 0);
        if source.isSourceWhitespace(ch) { advance(scanner); }
        else { if ch == "/" and peek(scanner, 1) == "/" {
            advance(scanner); advance(scanner);
            while scanner.index < scanner.count and peek(scanner, 0) != "\n" { advance(scanner); }
        } else { if ch == "/" and peek(scanner, 1) == "*" {
            try blockComment(scanner);
        } else { if ch == "\"" { tokens.add(try textLiteral(scanner)); }
        else { if source.isAsciiDigit(ch) { tokens.add(try number(scanner)); }
        else { if unicode.isIdentifierStart(ch) {
            let line be scanner.line;
            let column be scanner.column;
            let raw be advance(scanner);
            while unicode.isIdentifierContinue(peek(scanner, 0)) { raw = raw + advance(scanner); }
            let name be unicode.normalizeNfc(raw);
            tokens.add(token.make(token.keywordKind(name), raw, name, line, column));
        } else {
            let line be scanner.line;
            let column be scanner.column;
            let raw be ch + peek(scanner, 1);
            let kind be symbolKind(raw);
            if kind != -1 { advance(scanner); advance(scanner); }
            else { raw = ch; kind = symbolKind(raw); advance(scanner); }
            if kind == -1 {
                fail diagnostic.LexError { message = "unexpected source character"; line = line; column = column; };
            }
            tokens.add(token.make(kind, raw, raw, line, column));
        } } } } } }
    }
    tokens.add(token.make(token.eof(), "", "", scanner.line, scanner.column));
    return tokens;
}
