public type SourceLocation {
    offset Int;
    line Int;
    column Int;
}

public function startLocation() returns SourceLocation {
    return SourceLocation {
        offset = 0;
        line = 1;
        column = 1;
    };
}

public function at(offset Int, line Int, column Int) returns SourceLocation {
    return SourceLocation {
        offset = offset;
        line = line;
        column = column;
    };
}

public function advance(location SourceLocation, scalar Text) returns SourceLocation {
    if scalar == "\n" {
        return SourceLocation {
            offset = location.offset + 1;
            line = location.line + 1;
            column = 1;
        };
    }
    return SourceLocation {
        offset = location.offset + 1;
        line = location.line;
        column = location.column + 1;
    };
}

public function scalarAt(text Text, index Int) returns Text {
    if index < 0 or index >= text.scalars.count {
        return "\0";
    }
    return text.scalars[index];
}

public function isAsciiDigit(scalar Text) returns Bool {
    return scalar >= "0" and scalar <= "9";
}

public function isAsciiLetter(scalar Text) returns Bool {
    return (scalar >= "a" and scalar <= "z") or (scalar >= "A" and scalar <= "Z");
}

public function isAsciiHexDigit(scalar Text) returns Bool {
    return isAsciiDigit(scalar) or (scalar >= "a" and scalar <= "f") or (scalar >= "A" and scalar <= "F");
}

public function isSourceWhitespace(scalar Text) returns Bool {
    return scalar == " " or scalar == "\t" or scalar == "\r" or scalar == "\n";
}

public function isAsciiIdentifierStart(scalar Text) returns Bool {
    return scalar == "_" or isAsciiLetter(scalar);
}

public function isAsciiIdentifierContinue(scalar Text) returns Bool {
    return isAsciiIdentifierStart(scalar) or isAsciiDigit(scalar);
}
