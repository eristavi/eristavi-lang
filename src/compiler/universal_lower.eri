    if kind == 40 { return expression(e,required(node.first)); }
    if kind == 41 {
        let frame be zero(e,"frame"); let success be u.block(e.builder); let failure be u.block(e.builder); let done be u.block(e.builder); let result be u.allocate(e.builder,1);
        let boundary be u.instruction(9); boundary.arguments=identity u.Operand { value=frame; next=none; }; boundary.first=success.index; boundary.second=failure.index; u.end(e.builder,boundary);
        e.builder.current=success; let first be expression(e,required(node.first)); u.copy(e.builder,result,first); let popped be call(e,"pop",[frame]); u.jump(e.builder,done);
