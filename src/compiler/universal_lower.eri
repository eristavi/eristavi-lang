            let snapshot be expression(e,required(current.first)); let counter be u.allocate(e.builder,2); let initial be immediate(e,0); u.copy(e.builder,counter,initial);
            let testBlock be u.block(e.builder); let body be u.block(e.builder); let done be u.block(e.builder); u.jump(e.builder,testBlock); e.builder.current=testBlock;
            let countValue be call(e,"count",[snapshot]); let count be call(e,"truth",[countValue]); let test be u.instruction(11); test.result=u.allocate(e.builder,2); test.valueClass=2; test.arguments=u.operands([counter,count]); u.append(e.builder,test); u.branch(e.builder,test.result,body,done);
            e.builder.current=body; let item be call(e,"index",[snapshot,counter]); let stored be call(e,"store",[local(e,current.index),item]); block(e,required(current.second));
            if e.builder.current.terminator == none { let increment be u.instruction(12); increment.result=counter; increment.valueClass=2; increment.arguments=u.operands([counter]); u.append(e.builder,increment); u.jump(e.builder,testBlock); } e.builder.current=done;
        }
        if kind == 44 {
            let resource be expression(e,required(current.first)); let stored be call(e,"store",[local(e,current.index),resource]); let frame be zero(e,"frame"); let success be u.block(e.builder); let failure be u.block(e.builder); let done be u.block(e.builder);
            let boundary be u.instruction(9); boundary.arguments=u.operands([frame]); boundary.first=success.index; boundary.second=failure.index; u.end(e.builder,boundary);
            e.builder.current=success; let saved be e.cleanups; e.cleanups=identity Cleanup { index=current.index; frame=frame; next=saved; }; block(e,required(current.second)); e.cleanups=saved;
            if e.builder.current.terminator == none { let normal be call(e,"cleanup_normal",[local(e,current.index),frame]); u.jump(e.builder,done); }
