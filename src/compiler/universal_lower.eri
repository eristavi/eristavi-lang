// Flatten structured typed IR into machine-neutral register operations and CFG.
import compiler.typed_ir as ir;
import compiler.ir_verify;
import compiler.universal_model as u;
import compiler.semantic_model as m;
import compiler.format;
type Cleanup { index Int; frame Int; next maybe identity Cleanup; }
type State { builder identity u.Builder; scope Int; cleanups maybe identity Cleanup; }
function immediate(e identity State,value Int) returns Int { return u.number(e.builder,value); }
function bytes(e identity State,text Text) returns Int { return u.bytes(e.builder,text); }
function call(e identity State,name Text,arguments) returns Int { return u.call(e.builder,name,arguments); }
function zero(e identity State,name Text) returns Int { return u.zero(e.builder,name); }
function local(e identity State,index Int) returns Int { return u.local(e.builder,index); }
function required(value maybe identity ir.Node) returns identity ir.Node { if value != none { return value; } return ir.node(-1,5,identity m.Location { path=""; line=0; column=0; next=none; ordinal=-1; left=none; right=none; }); }
function binary(op Text) returns Int { if op == "+" { return 0; } if op == "-" { return 1; } if op == "*" { return 2; } if op == "/" { return 3; } if op == "%" { return 4; } if op == "==" { return 5; } if op == "!=" { return 6; } if op == "<" { return 7; } if op == "<=" { return 8; } if op == ">" { return 9; } return 10; }
function place(e identity State,node identity ir.Node) returns Int {
    if node.kind == 2 { return local(e,node.index); }
    let base be place(e,required(node.first));
    if node.kind == 29 { return call(e,"get_ref",[base]); }
    if node.kind == 22 { let field be immediate(e,node.index); return call(e,"member_ref",[base,field]); }
    let indexValue be expression(e,required(node.second)); let index be call(e,"truth",[indexValue]); return call(e,"index_ref",[base,index]);
}
function expression(e identity State,node identity ir.Node) returns Int {
