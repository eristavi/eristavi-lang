        if kind == 5 { return call(e,"f"+format.integer(node.index),arguments); }
        if kind == 6 { let ignored be call(e,"output",arguments); return zero(e,"void"); }
        let name be bytes(e,node.text); let valueType be immediate(e,node.valueType); let actual be [name,valueType]; let index be 0;
        while index < arguments.count { actual.add(arguments[index]); index=index+1; } return call(e,"builtin"+format.integer(arguments.count),actual);
    }
