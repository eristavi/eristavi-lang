        let count be 0; let cursor be node.first; while cursor != none { count=count+1; cursor=cursor.next; }
        let valueType be immediate(e,node.valueType); let size be immediate(e,count); let result be call(e,"object",[valueType,size]); cursor=node.first; let index be 0;
        while cursor != none { let item be cursor; let offset be index; if kind == 21 { item=required(cursor.first); offset=cursor.index; } let value be expression(e,item); let field be immediate(e,offset); let ignored be call(e,"init",[result,field,value]); index=index+1; cursor=cursor.next; } return result;
    }
    if kind == 22 { let first be expression(e,required(node.first)); let field be immediate(e,node.index); return call(e,"member",[first,field]); }
    if kind == 23 { let first be expression(e,required(node.first)); let indexValue be expression(e,required(node.second)); let index be call(e,"truth",[indexValue]); return call(e,"index",[first,index]); }
    if kind == 24 { let first be expression(e,required(node.first)); return call(e,"count",[first]); }
    if kind == 25 { let base be place(e,required(node.first)); let value be expression(e,required(node.second)); let ignored be call(e,"add",[base,value]); return zero(e,"void"); }
    if kind == 26 or kind == 28 or kind == 30 { let first be expression(e,required(node.first)); let valueType be immediate(e,node.valueType); let name be "wrap"; if kind == 30 { name="view"; } return call(e,name,[valueType,first]); }
    if kind == 27 { let valueType be immediate(e,node.valueType); return call(e,"none",[valueType]); }
