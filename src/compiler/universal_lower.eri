function routine(program identity u.Program,source identity ir.Function) returns identity u.Function {
    let result be identity u.Function { index=source.index; parameters=0; registers=none; registerTail=none; blocks=none; next=none; };
    let first be identity u.Block { index=0; instructions=none; tail=none; terminator=none; live=false; next=none; }; result.blocks=first;
    let builder be identity u.Builder { program=program; routine=result; current=first; registerCount=0; blockCount=1; locals=none; };
    let scope be u.zero(builder,"scope_enter"); let e be identity State { builder=builder; scope=scope; cleanups=none; }; let cursor be source.locals;
    while cursor != none {
        let value be -1;
        if cursor.parameter { let parameter be u.instruction(5); parameter.result=u.allocate(builder,1); parameter.valueClass=1; parameter.number=result.parameters; result.parameters=result.parameters+1; u.append(builder,parameter); value=call(e,"copy",[parameter.result]); }
        else { value=zero(e,"void"); }
        builder.locals=identity u.Local { index=cursor.index; value=value; next=builder.locals; }; cursor=cursor.next;
    }
    block(e,source.body); if builder.current.terminator == none { let empty be zero(e,"void"); let final be call(e,"scope_leave",[e.scope,empty]); u.returnValue(builder,final); } return result;
}
public function lower(source identity ir.Program) returns identity u.Program fails m.SemanticError {
    try ir_verify.verify(source);
    let placeholder be identity u.Function { index=-1; parameters=0; registers=none; registerTail=none; blocks=none; next=none; };
    let result be identity u.Program { types=source; functions=none; entry=placeholder; };
    result.entry=routine(result,source.entry); let cursor be source.functions;
    while cursor != none { let value be routine(result,cursor); value.next=result.functions; result.functions=value; cursor=cursor.next; } return result;
}
