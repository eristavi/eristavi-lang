        if node.valueType == 3 { let number be immediate(e,node.number); return call(e,"bool",[number]); }
        if node.valueType == 2 { let spelling be ""; let index be 0; while index < node.text.scalars.count { let ch be node.text.scalars[index]; if ch != "_" { spelling=spelling+ch; } index=index+1; } let text be bytes(e,spelling); return call(e,"float",[text]); }
        let text be bytes(e,node.text); let count be immediate(e,node.text.bytes.count); return call(e,"text",[text,count]);
    }
    if kind == 2 { return call(e,"copy",[local(e,node.index)]); }
    if kind == 3 { let first be expression(e,required(node.first)); let operation be 0; if node.text == "not" { operation=1; } let op be immediate(e,operation); return call(e,"unary",[op,first]); }
    if kind == 4 {
