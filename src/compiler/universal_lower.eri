function cleanup(e identity State) {
    let cursor be e.cleanups; if cursor == none { return; }
    let primary be zero(e,"empty_failure"); let last be -1;
    while cursor != none { let ignored be call(e,"cleanup_accumulate",[local(e,cursor.index),primary]); last=cursor.frame; cursor=cursor.next; }
    let popped be call(e,"pop",[last]); let propagated be call(e,"propagate_if",[primary]);
}
function block(e identity State,node identity ir.Node) {
    let cursor be node.first;
    while cursor != none {
        let current be cursor; let kind be current.kind;
        if e.builder.current.terminator != none { return; }
        if kind == 10 or kind == 11 { let value be expression(e,required(current.first)); let ignored be call(e,"store",[local(e,current.index),value]); }
        if kind == 33 { let value be expression(e,required(current.second)); let target be place(e,required(current.first)); let ignored be call(e,"store",[target,value]); }
        if kind == 12 { let ignored be expression(e,required(current.first)); }
        if kind == 15 { let returned be current.first; let value be -1; if returned != none { value=expression(e,returned); } else { value=zero(e,"void"); } cleanup(e); let final be call(e,"scope_leave",[e.scope,value]); u.returnValue(e.builder,final); }
        if kind == 43 {
            let first be required(current.first); let value be expression(e,first); let descriptor be ir.typeAt(e.builder.program.types,first.valueType); let index be 0;
            if descriptor != none { let field be descriptor.fields; while field != none { if field.name == "message" { index=field.index; } field=field.next; } }
            let message be immediate(e,index); let ignored be call(e,"fail",[value,message]); u.end(e.builder,u.instruction(10));
        }
        if kind == 13 {
            let condition be expression(e,required(current.first)); let test be call(e,"truth",[condition]); let first be u.block(e.builder); let second be u.block(e.builder); let done be u.block(e.builder); u.branch(e.builder,test,first,second);
            e.builder.current=first; block(e,required(current.second)); if e.builder.current.terminator == none { u.jump(e.builder,done); }
            e.builder.current=second; let other be current.third; if other != none { block(e,other); } if e.builder.current.terminator == none { u.jump(e.builder,done); } e.builder.current=done;
        }
        if kind == 14 {
            let testBlock be u.block(e.builder); let body be u.block(e.builder); let done be u.block(e.builder); u.jump(e.builder,testBlock); e.builder.current=testBlock;
            let condition be expression(e,required(current.first)); let test be call(e,"truth",[condition]); u.branch(e.builder,test,body,done); e.builder.current=body; block(e,required(current.second)); if e.builder.current.terminator == none { u.jump(e.builder,testBlock); } e.builder.current=done;
        }
