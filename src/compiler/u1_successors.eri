// One successor schema for jump, branch and sparse i64 switch.
// Consumers must validate the IR before treating these as trusted CFG facts.
import compiler.u1_budget as budget;
import compiler.u1_words as words;
import compiler.u1_ops as ops;
import compiler.u1_builder as build;

public function count(routine identity build.Function,phase identity budget.Phase,instruction Int) returns Int fails budget.LimitError {
    if instruction < 1 or instruction > routine.instructions.length/10 { try budget.reject("invalid successor instruction"); }
    let offset be (instruction-1)*10;
    let op be try words.get(routine.instructions,phase,offset);
    if op == 35 {
        let target be try words.get(routine.instructions,phase,offset+7);
        if target < 1 or target > routine.switches.length/3 { try budget.reject("invalid switch header"); }
        return 1+try words.get(routine.switches,phase,(target-1)*3+1);
    }
    return ops.inlineEdges(op);
}
public function edge(routine identity build.Function,phase identity budget.Phase,
    instruction Int,ordinal Int) returns Int fails budget.LimitError {
    let count be try count(routine,phase,instruction);
    if ordinal < 0 or ordinal >= count { try budget.reject("invalid successor ordinal"); }
    let offset be (instruction-1)*10;
    let op be try words.get(routine.instructions,phase,offset);
    if op == 35 {
        let target be try words.get(routine.instructions,phase,offset+7);
        let base be (target-1)*3;
        let cases be try words.get(routine.switches,phase,base+1);
        if ordinal == cases { return try words.get(routine.switches,phase,base+2); }
        let first be try words.get(routine.switches,phase,base);
        return try words.get(routine.cases,phase,(first+ordinal)*2+1);
    }
    return try words.get(routine.instructions,phase,offset+7+ordinal);
}
