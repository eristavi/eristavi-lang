// One successor schema for jump, branch and sparse i64 switch.
// Consumers must validate the IR before treating these as trusted CFG facts.
import compiler.u1_budget as budget;
import compiler.u1_words as words;
import compiler.u1_ops as ops;
import compiler.u1_builder as build;

public function count(routine identity build.Function,phase identity budget.Phase,instruction Int) returns Int fails budget.LimitError {
    if instruction < 1 or instruction > routine.instructions.length/10 { try budget.reject("invalid successor instruction"); }
    let offset be (instruction-1)*10;
    let op be try words.get(routine.instructions,phase,offset);
    if op == 35 {
        let target be try words.get(routine.instructions,phase,offset+7);
        if target < 1 or target > routine.switches.length/3 { try budget.reject("invalid switch header"); }
        return 1+try words.get(routine.switches,phase,(target-1)*3+1);
    }
    return ops.inlineEdges(op);
}
public function edge(routine identity build.Function,phase identity budget.Phase,
    instruction Int,ordinal Int) returns Int fails budget.LimitError {
    if instruction < 1 or instruction > routine.instructions.length/10 { try budget.reject("invalid successor instruction"); }
    let offset be (instruction-1)*10;
    let op be try words.get(routine.instructions,phase,offset);
    if op == 35 {
        let target be try words.get(routine.instructions,phase,offset+7);
        if target < 1 or target > routine.switches.length/3 { try budget.reject("invalid switch header"); }
        let base be (target-1)*3;
        let cases be try words.get(routine.switches,phase,base+1);
        if cases < 0 or cases > 65535 or ordinal < 0 or ordinal > cases { try budget.reject("invalid switch edge ordinal"); }
        if ordinal == cases { return try words.get(routine.switches,phase,base+2); }
        let first be try words.get(routine.switches,phase,base);
        return try words.get(routine.cases,phase,(first+ordinal)*2+1);
    }
    if ordinal < 0 or ordinal >= ops.inlineEdges(op) { try budget.reject("invalid successor ordinal"); }
    return try words.get(routine.instructions,phase,offset+7+ordinal);
}


// An ordinal is an edge identity, even when several arms share a target.
// The last ordinal is always the default edge; case bits are stored separately.
public function caseBits(routine identity build.Function,phase identity budget.Phase,
    instruction Int,ordinal Int) returns Int fails budget.LimitError {
    let size be try count(routine,phase,instruction);
    let offset be (instruction-1)*10;
    if try words.get(routine.instructions,phase,offset) != 35 or ordinal < 0 or ordinal >= size-1 {
        try budget.reject("invalid switch case ordinal");
    }
    let header be try words.get(routine.instructions,phase,offset+7);
    let first be try words.get(routine.switches,phase,(header-1)*3);
    return try words.get(routine.cases,phase,(first+ordinal)*2);
}
public function choose(routine identity build.Function,phase identity budget.Phase,
    instruction Int,selector Int) returns Int fails budget.LimitError {
    if instruction < 1 or instruction > routine.instructions.length/10 { try budget.reject("invalid successor instruction"); }
    let offset be (instruction-1)*10;
    if try words.get(routine.instructions,phase,offset) != 35 { try budget.reject("not a U1a switch"); }
    let header be try words.get(routine.instructions,phase,offset+7);
    if header < 1 or header > routine.switches.length/3 { try budget.reject("invalid switch header"); }
    let base be (header-1)*3;
    let first be try words.get(routine.switches,phase,base);
    let count be try words.get(routine.switches,phase,base+1);
    if count < 0 or count > 65535 { try budget.reject("invalid switch case count"); }
    // Cases are already verified and ordered by unsigned full-width bit pattern.
    // Binary search preserves the original edge ID and does not allocate by span.
    let low be 0; let high be count;
    while low < high {
        let middle be low+(high-low)/2;
        let bits be try words.get(routine.cases,phase,(first+middle)*2);
        if bits == selector { return try words.get(routine.cases,phase,(first+middle)*2+1); }
        if ops.unsignedLess(bits,selector) { low=middle+1; }
        else { high=middle; }
    }
    return try words.get(routine.switches,phase,base+2);
}
