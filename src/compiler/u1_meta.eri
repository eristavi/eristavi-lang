// Independent scalar U1a metadata. No frontend/Typed IR imports or retained graphs.
import compiler.u1_budget as budget;
import compiler.u1_words as words;
public type Key { marker Int; }
public type TypeId { index Int; }
public type SignatureId { owner identity Key; index Int; }
public type FunctionId { owner identity Key; index Int; }
public type SourceId { owner identity Key; index Int; }
public type LocId { owner identity Key; index Int; }
public type Metadata {
    key identity Key; owner identity budget.Owner; frozen Bool; closed Bool; control maybe identity budget.Allocation;
    signatures identity words.Words; types identity words.Words; buckets identity words.Words;
    sources identity words.Words; bytes identity words.Words; locations identity words.Words;
    declarations identity words.Words; symbolBytes identity words.Words;
}
public function typeAt(index Int) returns TypeId fails budget.LimitError {
    if index < 1 or index > 3 { try budget.reject("unsupported U1a type"); }
    return TypeId { index=index; };
}
public function pred() returns TypeId { return TypeId { index=1; }; }
public function i64() returns TypeId { return TypeId { index=2; }; }
public function f64() returns TypeId { return TypeId { index=3; }; }
public function validType(value TypeId) fails budget.LimitError { let checked be try typeAt(value.index); }
function mutable(meta identity Metadata,phase identity budget.Phase) fails budget.LimitError {
    try budget.poll(meta.owner);
    if meta.closed or meta.frozen or phase.owner != meta.owner { try budget.reject("immutable or foreign U1a metadata"); }
}
public function create(owner identity budget.Owner,phase identity budget.Phase) returns identity Metadata fails budget.LimitError {
    if owner.kind != 1 or phase.owner != owner or phase.used != 0 or phase.prepaid != 0 { try budget.reject("metadata requires a fresh shared phase"); }
    // Bound admission before constructing owned metadata stores and bucket pages.
    let preflight be try budget.reserve(owner,16384); try budget.cancelReservation(preflight);
    try budget.prepay(phase,1024);
    let pending be try budget.reserve(owner,768);
    let meta be identity Metadata { key=identity Key { marker=0; }; owner=owner; frozen=false; closed=false; control=none;
        signatures=try words.create(owner,6291456); types=try words.create(owner,8388608);
        buckets=try words.create(owner,64); sources=try words.create(owner,524288);
        bytes=try words.create(owner,8388608); locations=try words.create(owner,7340032);
        declarations=try words.create(owner,393216); symbolBytes=try words.create(owner,16777216); };
    let index be 0; while index < 64 { let ignored be try words.push(meta.buckets,phase,0); index=index+1; }
    meta.control=try budget.commit(pending); return meta;
}
function signatureIndex(meta identity Metadata,value SignatureId) returns Int fails budget.LimitError {
    if meta.closed or value.owner != meta.key or value.index < 1 or value.index > meta.signatures.length/6 { try budget.reject("foreign or invalid U1a SignatureId"); }
    return (value.index-1)*6;
}
public function parameterCount(meta identity Metadata,phase identity budget.Phase,value SignatureId) returns Int fails budget.LimitError {
    let offset be try signatureIndex(meta,value); return try words.get(meta.signatures,phase,offset+3);
}
public function resultCount(meta identity Metadata,phase identity budget.Phase,value SignatureId) returns Int fails budget.LimitError {
    let offset be try signatureIndex(meta,value); return try words.get(meta.signatures,phase,offset+5);
}
public function parameterType(meta identity Metadata,phase identity budget.Phase,value SignatureId,index Int) returns TypeId fails budget.LimitError {
    let offset be try signatureIndex(meta,value); let count be try parameterCount(meta,phase,value);
    if index < 0 or index >= count { try budget.reject("U1a parameter index out of range"); }
    let first be try words.get(meta.signatures,phase,offset+2); return try typeAt(try words.get(meta.types,phase,first+index));
}
public function resultType(meta identity Metadata,phase identity budget.Phase,value SignatureId,index Int) returns TypeId fails budget.LimitError {
    let offset be try signatureIndex(meta,value); let count be try resultCount(meta,phase,value);
    if index < 0 or index >= count { try budget.reject("U1a result index out of range"); }
    let first be try words.get(meta.signatures,phase,offset+4); return try typeAt(try words.get(meta.types,phase,first+index));
}
function sequenceHash(phase identity budget.Phase,values,seed Int) returns Int fails budget.LimitError {
    let hash be seed; let index be 0;
    while index < values.count { try budget.work(phase,1); let value be values[index]; try validType(value); hash=(hash*131+value.index)%2147483629; index=index+1; }
    return (hash*131+values.count)%2147483629;
}
function sameTypes(meta identity Metadata,phase identity budget.Phase,first Int,values) returns Bool fails budget.LimitError {
    let index be 0;
    while index < values.count { let value be values[index]; try validType(value); if try words.get(meta.types,phase,first+index) != value.index { return false; } index=index+1; }
    return true;
}
public function signature(meta identity Metadata,phase identity budget.Phase,parameters,results) returns SignatureId fails budget.LimitError {
    try mutable(meta,phase);
    let hash be try sequenceHash(phase,results,try sequenceHash(phase,parameters,17)); let bucket be hash%64;
    let cursor be try words.get(meta.buckets,phase,bucket);
    while cursor != 0 {
        let value be SignatureId { owner=meta.key; index=cursor; }; let offset be try signatureIndex(meta,value);
        if try words.get(meta.signatures,phase,offset) == hash {
            if try parameterCount(meta,phase,value) == parameters.count and try resultCount(meta,phase,value) == results.count {
                let first be try words.get(meta.signatures,phase,offset+2); let second be try words.get(meta.signatures,phase,offset+4);
                if try sameTypes(meta,phase,first,parameters) and try sameTypes(meta,phase,second,results) { return value; }
            }
        }
        cursor=try words.get(meta.signatures,phase,offset+1);
    }
    let parameterStart be meta.types.length; let index be 0;
    while index < parameters.count { let value be parameters[index]; try validType(value); let ignored be try words.push(meta.types,phase,value.index); index=index+1; }
    let resultStart be meta.types.length; index=0;
    while index < results.count { let value be results[index]; try validType(value); let ignored be try words.push(meta.types,phase,value.index); index=index+1; }
    let value be SignatureId { owner=meta.key; index=meta.signatures.length/6+1; };
    let previous be try words.get(meta.buckets,phase,bucket);
    let ignored be try words.push(meta.signatures,phase,hash); ignored=try words.push(meta.signatures,phase,previous);
    ignored=try words.push(meta.signatures,phase,parameterStart); ignored=try words.push(meta.signatures,phase,parameters.count);
    ignored=try words.push(meta.signatures,phase,resultStart); ignored=try words.push(meta.signatures,phase,results.count);
    try words.set(meta.buckets,phase,bucket,value.index); return value;
}
function appendBytes(meta identity Metadata,phase identity budget.Phase,value Text) returns Int fails budget.LimitError {
    let first be meta.bytes.length; let index be 0;
    while index < value.bytes.count { let ignored be try words.push(meta.bytes,phase,value.bytes[index]); index=index+1; } return first;
}
function sameBytes(meta identity Metadata,phase identity budget.Phase,first Int,count Int,value Text) returns Bool fails budget.LimitError {
    if count != value.bytes.count { return false; } let index be 0;
    while index < count { if try words.get(meta.bytes,phase,first+index) != value.bytes[index] { return false; } index=index+1; } return true;
}

// Owned, closed-profile function declarations. Record width six:
// [signature index, symbol byte start/count, kind, effects, import version].
// Kind 1 defined (version 0); kind 2 imported (trusted version >=1).
// Effect flags: read 1, write 2, external 4, allocation 8, trap 16, diverge 32.
// This slice conservatively treats calls as observable; effect closure and
// imported contract trust are separate gates, not guessed optimizer privileges.
public function functionSignature(meta identity Metadata,phase identity budget.Phase,target FunctionId) returns SignatureId fails budget.LimitError {
    if meta.closed or target.owner != meta.key or target.index < 1 or target.index > meta.declarations.length/6 {
        try budget.reject("foreign or invalid U1a FunctionId");
    }
    let index be try words.get(meta.declarations,phase,(target.index-1)*6);
    return SignatureId { owner=meta.key; index=index; };
}
public function declaration(meta identity Metadata,phase identity budget.Phase,signature SignatureId,symbol Text,
    kind Int,effects Int,version Int) returns FunctionId fails budget.LimitError {
    try mutable(meta,phase);
    let checked be try signatureIndex(meta,signature);
    if kind < 1 or kind > 2 or effects < 0 or effects > 63 or symbol.bytes.count == 0 or symbol.bytes.count > 1024 {
        try budget.reject("invalid U1a function declaration");
    }
    if (kind == 1 and version != 0) or (kind == 2 and version < 1) {
        try budget.reject("invalid U1a import contract version");
    }
    if meta.declarations.length/6 >= 65536 or symbol.bytes.count > 16777216-meta.symbolBytes.length {
        try budget.exceed(meta.owner,symbol.bytes.count,0);
    }
    let old be 0;
    while old < meta.declarations.length/6 {
        let base be old*6;
        let first be try words.get(meta.declarations,phase,base+1);
        let count be try words.get(meta.declarations,phase,base+2);
        if count == symbol.bytes.count {
            let index be 0; let same be true;
            while index < count {
                if try words.get(meta.symbolBytes,phase,first+index) != symbol.bytes[index] { same=false; }
                index=index+1;
            }
            if same { try budget.reject("duplicate U1a function symbol"); }
        }
        old=old+1;
    }
    let start be meta.symbolBytes.length; let index be 0;
    while index < symbol.bytes.count {
        let ignored be try words.push(meta.symbolBytes,phase,symbol.bytes[index]); index=index+1;
    }
    let value be FunctionId { owner=meta.key; index=meta.declarations.length/6+1; };
    let ignored be try words.push(meta.declarations,phase,signature.index);
    ignored=try words.push(meta.declarations,phase,start);
    ignored=try words.push(meta.declarations,phase,symbol.bytes.count);
    ignored=try words.push(meta.declarations,phase,kind);
    ignored=try words.push(meta.declarations,phase,effects);
    ignored=try words.push(meta.declarations,phase,version);
    return value;
}

public function source(meta identity Metadata,phase identity budget.Phase,name Text,digest Text,length Int) returns SourceId fails budget.LimitError {
    try mutable(meta,phase);
    if name.bytes.count == 0 or digest.bytes.count != 64 or length < 0 { try budget.reject("invalid U1a source identity"); }
    let index be 0;
    while index < 64 { let value be digest.bytes[index]; if not (value >= 48 and value <= 57) and not (value >= 97 and value <= 102) { try budget.reject("source digest must be lowercase SHA-256 hex"); } index=index+1; }
    index=0;
    while index < meta.sources.length/4 {
        let offset be index*4; let nameStart be try words.get(meta.sources,phase,offset); let nameSize be try words.get(meta.sources,phase,offset+1);
        if try sameBytes(meta,phase,nameStart,nameSize,name) {
            let digestStart be try words.get(meta.sources,phase,offset+2);
            if not (try sameBytes(meta,phase,digestStart,64,digest)) or try words.get(meta.sources,phase,offset+3) != length { try budget.reject("conflicting source revision"); }
            return SourceId { owner=meta.key; index=index+1; };
        } index=index+1;
    }
    let nameStart be try appendBytes(meta,phase,name); let digestStart be try appendBytes(meta,phase,digest);
    let value be SourceId { owner=meta.key; index=meta.sources.length/4+1; };
    let ignored be try words.push(meta.sources,phase,nameStart); ignored=try words.push(meta.sources,phase,name.bytes.count);
    ignored=try words.push(meta.sources,phase,digestStart); ignored=try words.push(meta.sources,phase,length); return value;
}
public function location(meta identity Metadata,phase identity budget.Phase,source SourceId,start Int,end Int,anchor Int,line Int,column Int) returns LocId fails budget.LimitError {
    try mutable(meta,phase);
    if source.owner != meta.key or source.index < 1 or source.index > meta.sources.length/4 { try budget.reject("foreign or invalid U1a SourceId"); }
    let length be try words.get(meta.sources,phase,(source.index-1)*4+3);
    if start < 0 or end < start or end > length or anchor < start or anchor > end or line < 1 or column < 1 { try budget.reject("invalid U1a source span"); }
    let value be LocId { owner=meta.key; index=meta.locations.length/7+1; };
    let ignored be try words.push(meta.locations,phase,source.index); ignored=try words.push(meta.locations,phase,start);
    ignored=try words.push(meta.locations,phase,end); ignored=try words.push(meta.locations,phase,anchor);
    ignored=try words.push(meta.locations,phase,line); ignored=try words.push(meta.locations,phase,column);
    ignored=try words.push(meta.locations,phase,0); return value;
}
public function syntheticRoot(meta identity Metadata,phase identity budget.Phase,
    source SourceId,start Int,end Int,anchor Int,line Int,column Int) returns LocId fails budget.LimitError {
    let value be try location(meta,phase,source,start,end,anchor,line,column);
    try words.set(meta.locations,phase,(value.index-1)*7+6,1048577);
    return value;
}
/* A private, bounded encoding in the 7th location word:
 * 0 => original source LocId; otherwise reason*1048577 + earlier LocId.
 * Reasons: 1 frontend lowering, 2 scalar promotion, 3 exact folding,
 * 4 machine legalization. Strictly backwards references make cycles impossible.
 * The representation is not a public artifact format or a complete multi-origin DAG.
 */
public function synthetic(meta identity Metadata,phase identity budget.Phase,parent LocId,reason Int) returns LocId fails budget.LimitError {
    try mutable(meta,phase); try validLocation(meta,parent);
    if reason < 1 or reason > 4 { try budget.reject("unsupported U1a synthetic origin reason"); }
    if meta.locations.length/7 >= 1048576 { try budget.exceed(meta.owner,1,0); }
    let offset be (parent.index-1)*7;
    let value be LocId { owner=meta.key; index=meta.locations.length/7+1; };
    let index be 0;
    while index < 6 {
        let ignored be try words.push(meta.locations,phase,try words.get(meta.locations,phase,offset+index)); index=index+1;
    }
    let ignored be try words.push(meta.locations,phase,reason*1048577+parent.index);
    return value;
}

public function validLocation(meta identity Metadata,value LocId) fails budget.LimitError {
    if meta.closed or value.owner != meta.key or value.index < 1 or value.index > meta.locations.length/7 { try budget.reject("foreign or invalid U1a LocId"); }
}
public function freeze(meta identity Metadata) fails budget.LimitError {
    try budget.poll(meta.owner); if meta.closed { try budget.reject("closed U1a metadata"); }
    try words.freeze(meta.signatures); try words.freeze(meta.types); try words.freeze(meta.buckets);
    try words.freeze(meta.sources); try words.freeze(meta.bytes); try words.freeze(meta.locations);
    try words.freeze(meta.declarations); try words.freeze(meta.symbolBytes); meta.frozen=true;
}
public function close(meta identity Metadata) fails budget.LimitError {
    if meta.closed { try budget.reject("double close of U1a metadata"); } meta.closed=true;
    try words.close(meta.signatures); try words.close(meta.types); try words.close(meta.buckets);
    try words.close(meta.sources); try words.close(meta.bytes); try words.close(meta.locations);
    try words.close(meta.declarations); try words.close(meta.symbolBytes);
    let control be meta.control; meta.control=none; if control != none { try budget.release(control); }
}
