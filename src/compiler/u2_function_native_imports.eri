// Bridge existing, independently tested U2 Text/Unicode17 and List<i64>
// runtime-import contracts into the original whole-Function native profile.
// This is NOT an implementation of their values, Unicode or List semantics:
// names and native helpers remain owned by u2_text_native/u2_list_i64.
// Every used call is checked by original canonical declaration/signature,
// version, effects, exact arity and opaque carrier BEFORE native emission.
import compiler.u1_budget as budget;
import compiler.u1_words as words;
import compiler.u1_meta as meta;
import compiler.u1_aggregate as aggregate;
import compiler.u1_aggregate_signature as signatures;
import compiler.u2_text_native as textNative;
import compiler.u2_list_i64 as listNative;

public error Unsupported { message Text; }
public type Target { kind Int; operation Int; }
function require(ok Bool,reason Text) fails Unsupported {
    if not ok { fail Unsupported { message=reason; }; }
}
function same(data identity meta.Metadata,phase identity budget.Phase,
    row Int,symbol Text) returns Bool fails budget.LimitError {
    let size be try words.get(data.declarations,phase,row+2);
    if size != symbol.bytes.count { return false; }
    let first be try words.get(data.declarations,phase,row+1);
    let i be 0;
    while i < size {
        if (try words.get(data.symbolBytes,phase,first+i)) !=
            symbol.bytes[i] { return false; }
        i=i+1;
    }
    return true;
}
// An exact source FunctionId is used: target ordinals are not assumed to
// equal local op indices or each other when Text and List coexist.
public function inspect(data identity meta.Metadata,
    graph identity aggregate.Registry,phase identity budget.Phase,
    target Int,textCarrier Int,listCarrier Int)
    returns Target fails budget.LimitError,Unsupported {
    try require(data.frozen and not data.closed and graph.state == 1 and
        target >= 1 and target <= data.declarations.length/6 and
        phase.state == 0 and phase.owner.kind == 2 and
        phase.owner.parent == data.owner.parent,
        "foreign or unverified native managed import target");
    let row be (target-1)*6;
    let kind be 0; let operation be 0;
    let i be 1;
    while i <= 12 {
        if textCarrier >= 7 and try same(data,phase,row,textNative.name(i)) {
            kind=1; operation=i;
        }
        i=i+1;
    }
    i=1;
    while i <= 7 {
        if listCarrier >= 7 and try same(data,phase,row,listNative.name(i)) {
            kind=2; operation=i;
        }
        i=i+1;
    }
    try require(kind != 0 and (try words.get(data.declarations,phase,row+3)) == 2 and
        (try words.get(data.declarations,phase,row+4)) == 63 and
        (try words.get(data.declarations,phase,row+5)) == 1,
        "unknown or incompatible Text/List runtime import version/effects");
    let functionId be meta.FunctionId { owner=data.key; index=target; };
    let signature be try meta.functionSignature(data,phase,functionId);
    let arguments be 1; let resultCount be 1;
    if kind == 1 {
        if operation == 2 or operation == 4 or
            (operation >= 9 and operation <= 11) { arguments=2; }
        if operation == 8 { arguments=0; resultCount=0; }
    } else {
        if operation == 1 or operation == 7 { arguments=0; }
        if operation == 3 or operation == 6 { arguments=2; }
        if operation == 4 { arguments=3; }
        if operation == 7 { resultCount=0; }
    }
    try require((try meta.parameterCount(data,phase,signature)) == arguments and
        (try meta.resultCount(data,phase,signature)) == resultCount,
        "native managed call has wrong canonical signature arity");
    i=0;
    while i < arguments {
        let expected be textCarrier;
        if kind == 1 {
            if operation == 1 or
                (operation >= 9 and operation <= 11 and i == 1) { expected=2; }
        } else {
            expected=listCarrier;
            if i >= 1 { expected=2; }
        }
        try require((try signatures.parameterType(data,graph,phase,signature,i)).index ==
            expected,"native managed call has wrong canonical argument type");
        i=i+1;
    }
    if resultCount == 1 {
        let expected be textCarrier;
        if kind == 1 {
            if operation == 4 { expected=1; }
            if operation == 5 or operation == 6 or operation == 7 or
                operation == 9 { expected=2; }
        } else {
            expected=listCarrier;
            if operation == 5 or operation == 6 { expected=2; }
        }
        try require((try signatures.resultType(data,graph,phase,signature,0)).index ==
            expected,"native managed call has wrong canonical result type");
    }
    // Do not route List indexed get/replace before preserving its existing
    // precise source-location bounds faults through the new Function emitter.
    try require(kind != 2 or
        (operation != 4 and operation != 6),
        "List indexed bounds adapter not yet linked in whole Function");
    return Target { kind=kind; operation=operation; };
}
