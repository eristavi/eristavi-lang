// Bounded U2 canonical checked File-close / native class-5 root connection.
// Output is ordinary x86-64 machine lowering of freshly verified canonical
// metadata, not an alternate IR, a new GC or a public calling convention.
// Caller owns a LIVE evn_scope_enter-bound canonical root-word vector through
// the checked outcome handler. This prototype selects exactly one File.close.
import compiler.u1_budget as budget;
import compiler.u1_words as words;
import compiler.u1_meta as meta;
import compiler.u1_builder as build;
import compiler.u1_aggregate as aggregate;
import compiler.u1_verify as canonical;
import compiler.u2_scoped_owners as owners;
import compiler.u2_invoke_contract as fallible;
import compiler.u2_root_map as roots;
import compiler.u2_continuation_bind as continuation;
import compiler.u2_cleanup_plan as cleanup;
import compiler.u2_cleanup_verify as planVerify;
import compiler.u2_native_slots_x86_64 as slots;
import compiler.u2_native_root_x86_64 as nativeRoots;
import compiler.u2_cleanup_canonical_x86_64 as checked;
import compiler.format as format;

public error Unsupported { message Text; }
function require(ok Bool,message Text) fails Unsupported {
    if not ok { fail Unsupported { message=message; }; }
}
function line(value Text) { output("    "+value); }

// Emits three related helpers from ONE revalidated canonical revision:
// erist_u2_cleanup_LABEL (verified native File close),
// erist_u2_bind_LABEL / erist_u2_publish_LABEL_INST / release (native roots),
// erist_u2_checked_LABEL (connects checked status to the canonical root).
//
// Wrapper ABI: RDI = caller's File owner slot, RSI = caller-owned saved
// FailureContext record, RDX = caller-owned, already bound root words.
// Entry requires this selected failure root word to be zero. It publishes
// before ANY allocating cleanup call. Success releases it and returns 0;
// checked failure retains it and returns -1. Callers must release the root
// after completing propagation/handling, then leave the bound root scope.
// No hidden handler stack or global error flag is introduced.
public function emit(routine identity build.Function,
    graph identity aggregate.Registry,profile identity owners.Profile,
    contracts identity fallible.Registry,phase identity budget.Phase,
    map identity roots.Map,placement identity slots.Plan,
    pair continuation.Pair,instruction build.InstId,
    plan identity cleanup.Plan,active,survive Int,exit meta.LocId,
    label Int)
    fails budget.LimitError,canonical.InvalidIR,owners.InvalidOwnership,
        roots.InvalidRoots,continuation.InvalidBinding,planVerify.InvalidPlan,
        slots.InvalidSlots,checked.Unsupported,nativeRoots.Unsupported,Unsupported {
    // The independent machine placement verifier checks the entire checked
    // root map, including dead instructions, and its exact current revision.
    let proven be try slots.verify(placement,map,routine,graph,phase);
    try require(label > 0 and label <= 2147483647 and
        instruction.owner == routine.key and instruction.index > 0 and
        proven.roots >= 1 and proven.roots <= 128,
        "invalid canonical checked-root integration profile");
    let rootIndex be 0-1; let offset be 0; let index be 0;
    while index < proven.roots {
        try budget.work(phase,1);
        let id be try words.get(map.records,phase,index*6);
        if id == instruction.index {
            rootIndex=index;
            offset=try words.get(placement.records,phase,index*3+1);
        }
        index=index+1;
    }
    try require(rootIndex >= 0 and offset == rootIndex*8 and
        offset >= 0 and offset < proven.rootBytes,
        "selected canonical checked edge has no unique native class-5 slot");

    // The canonical emitter independently revalidates whole Function owner
    // facts, typed checked destinations, exact LocId and private cleanup plan
    // before emitting any instructions. No unsupported multi-owner fallback.
    try checked.emitCanonical(routine,graph,profile,contracts,phase,map,
        pair,instruction,plan,active,survive,exit,false,label);
    nativeRoots.emitWithSlots(placement,map,routine,graph,phase,label)
        else error nativeRoots.Unsupported { fail error; }
        else error budget.LimitError { fail error; }
        else error roots.InvalidRoots { fail error; }
        else error slots.InvalidSlots { fail error; };
    let name be format.integer(label);
    let symbol be name+"_"+format.integer(instruction.index);
    let base be "erist_u2_checked_"+name;
    output(".text\n.globl "+base+"\n.type "+base+",@function\n"+base+":");
    line("pushq %rbx"); line("pushq %r12"); line("pushq %r13"); line("pushq %r14");
    // Four pushes leave rsp misaligned for calls under SysV ABI.
    line("subq $8,%rsp");
    line("movq %rdi,%r12"); line("movq %rsi,%r13"); line("movq %rdx,%r14");
    line("testq %r12,%r12"); line("je erist_rt_value_fault_internal");
    line("testq %r13,%r13"); line("je erist_rt_value_fault_internal");
    line("testq %r14,%r14"); line("je erist_rt_value_fault_internal");
    line("cmpq $0,"+format.integer(offset)+"(%r14)");
    line("jne erist_rt_value_fault_internal");
    // Keep the pending context live even during any allocating close helper.
    line("movq %r14,%rdi"); line("movq %r13,%rsi");
    line("call erist_u2_publish_"+symbol);
    line("movq %r12,%rdi"); line("movq %r13,%rsi");
    line("call erist_u2_cleanup_"+name);
    line("movq %rax,%rbx");
    line("cmpq $0,%rbx"); line("jne "+base+"_failed");
    line("cmpq $0,(%r13)"); line("jne erist_rt_value_fault_internal");
    line("movq %r14,%rdi"); line("call erist_u2_release_"+symbol);
    line("jmp "+base+"_leave");
    output(base+"_failed:");
    line("cmpq $0,(%r13)"); line("je erist_rt_value_fault_internal");
    output(base+"_leave:");
    line("movq %rbx,%rax");
    line("addq $8,%rsp");
    line("popq %r14"); line("popq %r13"); line("popq %r12"); line("popq %rbx");
    line("ret");
    output(".size "+base+",.-"+base);
    output(".section .note.GNU-stack,\"\",@progbits");
}
