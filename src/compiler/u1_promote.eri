        cellHeads=0; cellTails=0; nextOp=0; defined=0; live=0; placed=0; queued=0; definitions=0;
        frontierHeads=0; frontierTails=0; frontierMark=0; phiHeads=0; phiTails=0; predCount=0;
        aliases=0; phiForValue=0; current=0; edgeHeads=0; edgeTails=0; users=0; userTails=0; queue=0;
        blockMap=0; valueMap=0; reach=0; undo=0; liveStates=0; predecessorVisits=0; placementStates=0;
        frontierEntries=0; frontierVisits=0; aliasVisits=0; plannedParameters=0; plannedArguments=0; parameters=0; arguments=0; };
