function get(state identity State,table identity words.Words,index Int) returns Int fails budget.LimitError { return try words.get(table,state.phase,index); }
function read(state identity State,first Int,index Int) returns Int fails budget.LimitError { return try get(state,state.graph.data,first+index); }
