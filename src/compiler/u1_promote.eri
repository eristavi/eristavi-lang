    let root be value; let steps be 0;
    while try read(state,state.aliases,root) != root {
        root=try read(state,state.aliases,root); steps=steps+1; state.aliasVisits=state.aliasVisits+1;
        if root < 1 or root >= limit or steps >= limit { try invalid("cyclic or missing promotion substitution"); }
