import compiler.typed_ir as ir;
import compiler.semantic_model as m;
import compiler.semantic_types as t;
import compiler.semantic;

// Compiler-private lookup state. Program.types remains the canonical public table.
public type TypeCacheEntry { kind Int; name Text; inner Int; index Int; next maybe identity TypeCacheEntry; }
public type TypeBucket { number Int; entries maybe identity TypeCacheEntry; left maybe identity TypeBucket; right maybe identity TypeBucket; }
public type Registry { root identity TypeBucket; nextIndex Int; }

function bucketTree(first Int, last Int) returns maybe identity TypeBucket {
    if first > last { return none; }
    let middle be first+(last-first)/2;
    return identity TypeBucket { number=middle; entries=none; left=bucketTree(first,middle-1); right=bucketTree(middle+1,last); };
}
function typeBucket(indexer identity Registry, number Int) returns identity TypeBucket {
    let cursor maybe identity TypeBucket be indexer.root;
    while cursor != none {
        let current be cursor;
        if current.number == number { return current; }
        if number < current.number { cursor=current.left; } else { cursor=current.right; }
    }
    return indexer.root;
}
function typeHash(kind Int, name Text, inner Int) returns Int {
    let value be kind%257; if value < 0 { value=value+257; }
    let part be inner%257; if part < 0 { part=part+257; }
    value=(value*131+part)%257;
    let offset be 0;
    while offset < name.bytes.count { value=(value*131+name.bytes[offset])%257; offset=offset+1; }
    return value;
}
function cached(indexer identity Registry, kind Int, name Text, inner Int) returns Int {
    let slot be typeBucket(indexer,typeHash(kind,name,inner)); let cursor be slot.entries;
    while cursor != none { if cursor.kind == kind and cursor.name == name and cursor.inner == inner { return cursor.index; } cursor=cursor.next; }
    return -1;
}
function remember(indexer identity Registry, kind Int, name Text, inner Int, index Int) {
    let slot be typeBucket(indexer,typeHash(kind,name,inner));
    slot.entries=identity TypeCacheEntry { kind=kind; name=name; inner=inner; index=index; next=slot.entries; };
}
function seed(indexer identity Registry, value maybe identity ir.Type) {
    if value != none { seed(indexer,value.next); remember(indexer,value.kind,value.name,value.inner,value.index); indexer.nextIndex=indexer.nextIndex+1; }
}
public function registry(program identity ir.Program) returns identity Registry {
    let result be identity Registry {
        root=identity TypeBucket { number=128; entries=none; left=bucketTree(0,127); right=bucketTree(129,256); };
        nextIndex=6;
    };
    seed(result,program.types); return result;
}
function registerWith(indexer maybe identity Registry, program identity ir.Program, owner identity m.Module, value identity m.Type, location identity m.Location) returns Int fails m.SemanticError {
    let actual be t.resolve(value); let kind be actual.kind;
    if kind >= 1 and kind <= 5 { return kind; }
    if kind == 0 { try m.reject(location,"lower","unresolved type in executable lowering"); }
    let inner be -1;
    if kind == 7 or kind == 8 or kind == 9 { inner=try registerWith(indexer,program,owner,t.inner(actual),location); }
    let index be -1;
    if indexer != none {
        index=cached(indexer,kind,actual.name,inner); if index >= 0 { return index; }
        index=indexer.nextIndex; indexer.nextIndex=index+1;
    } else {
        let cursor be program.types; index=6;
        while cursor != none { if cursor.kind == kind and cursor.name == actual.name and cursor.inner == inner { return cursor.index; } index=index+1; cursor=cursor.next; }
    }
    let item be identity ir.Type { index=index; kind=kind; name=actual.name; inner=inner; fields=none; checked=false; next=program.types; }; program.types=item;
    if indexer != none { remember(indexer,kind,actual.name,inner,index); }
    if kind == 6 {
        if actual.name == "std.files.FileError" { item.checked=true;
            item.fields=identity ir.Field { index=0; name="message"; valueType=4; immutable=false; next=identity ir.Field { index=1; name="path"; valueType=4; immutable=false; next=none; }; }; return index;
        }
        let declaration be semantic.layout(owner,actual.name);
        if declaration == none { try m.reject(location,"lower","missing nominal type layout: "+actual.name); }
        else {
            item.checked=declaration.node.kind == 5;
            let field be declaration.fields; let number be 0; let tail maybe identity ir.Field be none;
            while field != none {
                let fieldType be try registerWith(indexer,program,owner,field.value,location);
                let entry be identity ir.Field { index=number; name=field.name; valueType=fieldType; immutable=field.immutable; next=none; };
                if tail == none { item.fields=entry; } else { tail.next=entry; } tail=entry; number=number+1; field=field.next;
            }
        }
    }
    if kind == 11 { item.fields=identity ir.Field { index=0; name="message"; valueType=4; immutable=false; next=none; }; }
    return index;
}
public function register(program identity ir.Program, owner identity m.Module, value identity m.Type, location identity m.Location) returns Int fails m.SemanticError {
    return try registerWith(none,program,owner,value,location);
}
public function registerIndexed(indexer identity Registry, program identity ir.Program, owner identity m.Module, value identity m.Type, location identity m.Location) returns Int fails m.SemanticError {
    return try registerWith(indexer,program,owner,value,location);
}
public function semanticType(program identity ir.Program, index Int) returns identity m.Type {
    let kind be ir.kind(program,index);
    if index >= 1 and index <= 5 { return m.makeType(index,""); }
    let item be ir.typeAt(program,index);
    if item != none { if kind == 7 or kind == 8 or kind == 9 { return m.wrap(kind,semanticType(program,item.inner)); } return m.makeType(kind,item.name); }
    return m.makeType(5,"");
}
function failureSet(indexer maybe identity Registry, program identity ir.Program, owner identity m.Module, names maybe identity m.Name, location identity m.Location) returns maybe identity ir.Failure fails m.SemanticError {
    let result maybe identity ir.Failure be none; let cursor be names;
    while cursor != none { let value be try registerWith(indexer,program,owner,m.makeType(6,cursor.text),location); result=identity ir.Failure { valueType=value; next=result; }; cursor=cursor.next; } return result;
}
public function failures(program identity ir.Program, owner identity m.Module, names maybe identity m.Name, location identity m.Location) returns maybe identity ir.Failure fails m.SemanticError {
    return try failureSet(none,program,owner,names,location);
}
public function failuresIndexed(indexer identity Registry, program identity ir.Program, owner identity m.Module, names maybe identity m.Name, location identity m.Location) returns maybe identity ir.Failure fails m.SemanticError {
    return try failureSet(indexer,program,owner,names,location);
}
public function field(program identity ir.Program, valueType Int, name Text, location identity m.Location) returns identity ir.Field fails m.SemanticError {
    let target be valueType; if ir.kind(program,target) == 9 { target=ir.inner(program,target); }
    let item be ir.typeAt(program,target);
    if item != none { let cursor be item.fields; while cursor != none { if cursor.name == name { return cursor; } cursor=cursor.next; } }
    try m.reject(location,"lower","missing nominal field: "+name); return identity ir.Field { index=-1; name=name; valueType=5; immutable=false; next=none; };
}
