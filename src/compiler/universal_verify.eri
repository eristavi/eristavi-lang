// CFG/type/definite-initialization verification independent of the lowerer.
import compiler.universal_model as u;
import compiler.typed_ir as ir;
import compiler.semantic_model as m;
import compiler.format;
// Masks share one dense table of identity words per routine. Only the first
// wordCount entries are scratch; each flow owns disjoint incoming/outgoing ranges.
type Word { value Int; }
type Flow { block identity u.Block; reachable Bool; incoming Int; outgoing Int; first maybe identity Flow; second maybe identity Flow; next maybe identity Flow; }
function require(program identity u.Program,condition Bool,message Text) returns Bool fails m.SemanticError {
    if condition { return true; }
    return try ir.require(false,program.types.entry.body.location,"Universal IR: "+message);
}
function flowAt(flows maybe identity Flow,index Int) returns maybe identity Flow { let cursor be flows; while cursor != none { if cursor.block.index == index { return cursor; } cursor=cursor.next; } return none; }
function words(count Int) {
    let result be []; let index be 0;
    while index<count { result.add(identity Word { value=0; }); index=index+1; } return result;
}
function powers() {
    let result be [1]; let value be 1;
    while result.count<62 { value=value*2; result.add(value); } return result;
}
function fill(values,start Int,count Int) { let index be 0; while index<count { let word identity Word be values[start+index]; word.value=4611686018427387903; index=index+1; } }
function defined(values,start Int,index Int,flags) returns Bool { let word identity Word be values[start+index/62]; return (word.value/flags[index%62])%2 == 1; }
function define(values,start Int,index Int,flags) { let word identity Word be values[start+index/62]; let flag be flags[index%62]; if (word.value/flag)%2 == 0 { word.value=word.value+flag; } }
function copy(values,target Int,source Int,count Int) returns Bool {
    let changed be false; let index be 0;
    while index<count { let word identity Word be values[target+index]; let other identity Word be values[source+index]; let value be other.value; if word.value != value { word.value=value; changed=true; } index=index+1; } return changed;
}
function intersect(values,target Int,source Int,count Int) returns Bool {
    let changed be false; let word be 0;
    while word<count {
        let current identity Word be values[target+word]; let sourceWord identity Word be values[source+word]; let other be sourceWord.value; let result be current.value;
        if result != other {
            if result == 0 or other == 0 { result=0; }
            else { if result == 4611686018427387903 { result=other; }
            else { if other != 4611686018427387903 {
                result=0; let flag be 1; let index be 0;
                while index<62 { if (current.value/flag)%2 == 1 and (other/flag)%2 == 1 { result=result+flag; } if index<61 { flag=flag*2; } index=index+1; }
            } } }
        }
        if result != current.value { current.value=result; changed=true; } word=word+1;
    } return changed;
}
function signature(name Text) returns Text {
    if name == "scope_enter" or name == "void" or name == "frame" or name == "saved" or name == "empty_failure" { return ""; }
    if name == "scope_leave" { return "61"; }
    if name == "copy" or name == "truth" or name == "output" or name == "count" or name == "get" or name == "get_ref" { return "1"; }
    if name == "int" or name == "bool" or name == "none" { return "2"; }
    if name == "float" { return "3"; } if name == "text" { return "32"; }
    if name == "unary" or name == "wrap" or name == "view" { return "21"; }
    if name == "binary" { return "211"; }
    if name == "store" or name == "add" { return "11"; }
    if name == "object" { return "22"; } if name == "init" { return "121"; }
    if name == "member" or name == "member_ref" or name == "index" or name == "index_ref" or name == "fail" { return "12"; }
    if name == "builtin0" { return "32"; } if name == "builtin1" { return "321"; } if name == "builtin2" { return "3211"; }
    if name == "pop" { return "4"; } if name == "match" or name == "error" { return "52"; }
    if name == "propagate" or name == "propagate_if" { return "5"; }
    if name == "cleanup_accumulate" { return "15"; } if name == "cleanup_normal" or name == "unwind" { return "14"; }
    return "?";
}
public function functionId(name Text) returns Int {
    // Function symbols are canonical ASCII decimal, independently of Unicode.
    let count be name.bytes.count;
    if count<2 or name.bytes[0] != 102 { return -2; }
    if count>2 and name.bytes[1] == 48 { return -2; }
    let result be 0; let index be 1;
    while index<count { let code be name.bytes[index]-48; if code<0 or code>9 or result>100000000 { return -2; } result=result*10+code; index=index+1; } return result;
}
function operands(program identity u.Program,value identity u.Instruction,classes,masks,flags,checkDefinitions Bool) returns Int fails m.SemanticError {
    let cursor be value.arguments; let count be 0;
    while cursor != none { try require(program,count<classes.count+8,"cyclic/excess operand list"); try require(program,cursor.value>=0 and cursor.value<classes.count,"unknown register operand"); if checkDefinitions { try require(program,defined(masks,0,cursor.value,flags),"register is not initialized on every incoming path"); } count=count+1; cursor=cursor.next; } return count;
}
function instruction(program identity u.Program,routine identity u.Function,value identity u.Instruction,classes,masks,flags,functions,checkDefinitions Bool) returns Bool fails m.SemanticError {
    let count be try operands(program,value,classes,masks,flags,checkDefinitions); let op be value.op;
    if not (value.result>=0 and value.result<classes.count and classes[value.result] == value.valueClass) {
        try require(program,false,"result register class mismatch at "+format.integer(value.result)+" (class "+format.integer(value.valueClass)+")");
    }
    if op == 1 { try require(program,value.valueClass == 2 and count == 0,"invalid integer constant"); }
    else { if op == 2 { try require(program,value.valueClass == 3 and count == 0,"invalid byte constant"); }
    else { if op == 5 { try require(program,value.valueClass == 1 and count == 0 and value.number>=0 and value.number<routine.parameters,"invalid parameter load"); }
    else { if op == 4 { try require(program,count == 1,"copy requires one operand"); let first be value.arguments; if first != none { try require(program,count == 1 and classes[first.value] == value.valueClass,"invalid copy"); } }
    else { if op == 11 or op == 12 { let expectedCount be 1; if op == 11 { expectedCount=2; } try require(program,value.valueClass == 2 and count == expectedCount,"invalid integer loop operation"); let cursor be value.arguments; while cursor != none { try require(program,classes[cursor.value] == 2,"loop operation requires integer registers"); cursor=cursor.next; } }
    else { if op == 3 {
        let id be functionId(value.text); let expected be ""; let resultClass be 1;
        if id>=0 { try require(program,id<functions.count,"unknown program call target"); let called identity u.Function be functions[id]; try require(program,count == called.parameters,"program call arity mismatch"); }
        else { expected=signature(value.text); resultClass=u.resultClass(value.text); try require(program,expected != "?" and count == expected.bytes.count,"unknown helper or invalid arity"); }
        try require(program,value.valueClass == resultClass,"call result class mismatch"); let cursor be value.arguments; let index be 0;
        while cursor != none { let wanted be 1; if id<0 { wanted=expected.bytes[index]-48; } try require(program,classes[cursor.value] == wanted,"call argument class mismatch"); index=index+1; cursor=cursor.next; }
    } else { try require(program,false,"unknown instruction opcode"); } } } } } }
    return true;
}
function successors(program identity u.Program,flow identity Flow,value identity u.Instruction,flows maybe identity Flow) returns Bool fails m.SemanticError {
    if value.op == 6 or value.op == 7 or value.op == 9 { flow.first=flowAt(flows,value.first); try require(program,flow.first != none,"missing first successor"); }
    if value.op == 7 or value.op == 9 { flow.second=flowAt(flows,value.second); try require(program,flow.second != none,"missing second successor"); } return true;
}
function transfer(program identity u.Program,routine identity u.Function,flow identity Flow,classes,masks,wordCount Int,flags,functions,validate Bool,checkDefinitions Bool) returns Bool fails m.SemanticError {
    copy(masks,0,flow.incoming,wordCount); let cursor be flow.block.instructions; let count be 0;
    while cursor != none { try require(program,count<10*(classes.count+1),"cyclic/excess instruction list"); if validate { try instruction(program,routine,cursor,classes,masks,flags,functions,checkDefinitions); } define(masks,0,cursor.result,flags); count=count+1; cursor=cursor.next; }
    let terminal be flow.block.terminator; try require(program,terminal != none,"block has no terminator");
    if terminal != none { if validate { let arity be try operands(program,terminal,classes,masks,flags,checkDefinitions); let op be terminal.op;
        if op == 6 or op == 10 { try require(program,arity == 0,"unexpected terminator operands"); }
        else { let operand be terminal.arguments; try require(program,arity == 1,"terminator requires one operand"); if operand != none { let wanted be 2; if op == 8 { wanted=1; } if op == 9 { wanted=4; } try require(program,(op == 7 or op == 8 or op == 9) and classes[operand.value] == wanted,"invalid terminator/class"); } }
    } } return copy(masks,flow.outgoing,0,wordCount);
}
function propagate(source identity Flow,target maybe identity Flow,masks,wordCount Int) returns Bool {
    if target == none { return false; } let current be target; let changed be false;
    if not current.reachable { current.reachable=true; changed=true; }
    if intersect(masks,current.incoming,source.outgoing,wordCount) { changed=true; } return changed;
}
function routine(program identity u.Program,routine identity u.Function,flags,functions) returns Bool fails m.SemanticError {
    let classes be []; let register be routine.registers;
    while register != none { try require(program,register.index == classes.count and register.valueClass>=0 and register.valueClass<=6,"invalid register table"); classes.add(register.valueClass); register=register.next; }
    let wordCount be (classes.count+61)/62; let flows maybe identity Flow be none; let cursor be routine.blocks; let count be 0;
    while cursor != none { try require(program,flowAt(flows,cursor.index) == none and cursor.index>=0,"cyclic/duplicate block table"); let record be identity Flow { block=cursor; reachable=cursor.index == 0; incoming=(2*count+1)*wordCount; outgoing=(2*count+2)*wordCount; first=none; second=none; next=flows; }; flows=record; cursor=cursor.next; count=count+1; }
    try require(program,flowAt(flows,0) != none,"function has no entry block");
    let masks be words((2*count+1)*wordCount); let flow be flows;
    while flow != none { if flow.block.index != 0 { fill(masks,flow.incoming,wordCount); } fill(masks,flow.outgoing,wordCount); flow=flow.next; }
    flow=flows;
    while flow != none { let terminal be flow.block.terminator; try require(program,terminal != none,"missing terminator"); if terminal != none { try successors(program,flow,terminal,flows); } try transfer(program,routine,flow,classes,masks,wordCount,flags,functions,true,false); flow=flow.next; }
    let changed be true; let iterations be 0;
    while changed {
        changed=false; flow=flows; iterations=iterations+1; try require(program,iterations<=(classes.count+2)*(count+1),"definite initialization did not converge");
        while flow != none {
            let current be flow;
            if current.reachable {
                if try transfer(program,routine,current,classes,masks,wordCount,flags,functions,false,false) { changed=true; }
                let terminal be current.block.terminator;
                if terminal != none { if terminal.op == 6 or terminal.op == 7 or terminal.op == 9 { if propagate(current,current.first,masks,wordCount) { changed=true; } } if terminal.op == 7 or terminal.op == 9 { if propagate(current,current.second,masks,wordCount) { changed=true; } } }
            } flow=current.next;
        }
    }
    flow=flows; while flow != none { if flow.reachable { try transfer(program,routine,flow,classes,masks,wordCount,flags,functions,true,true); } flow=flow.next; } return true;
}
public function verify(program identity u.Program) returns Bool fails m.SemanticError {
    try require(program,program.entry.index == -1 and program.entry.parameters == 0,"invalid entry function"); let cursor be program.functions; let count be 0; let functions be [];
    while cursor != none { try require(program,cursor.index == count,"noncontiguous/duplicate function table"); functions.add(cursor); count=count+1; cursor=cursor.next; }
    let flags be powers(); cursor=program.functions; while cursor != none { try routine(program,cursor,flags,functions); cursor=cursor.next; } return try routine(program,program.entry,flags,functions);
}
