// C bootstrap runtime text emitted by the Eristavi backend.
public function source() returns Text {
    return "/* Experimental scalar bootstrap runtime: checked Int and length-aware UTF-8 Text. */\n#include <stdint.h>\n#include <inttypes.h>\n#include <stdbool.h>\n#include <stddef.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\nstatic void eri_fault(const char *message) { fprintf(stderr,\"Eristavi runtime fault: %s\\n\",message); exit(1); }\ntypedef struct { const unsigned char *data; size_t len; } eri_text;\ntypedef struct eri_allocation { void *data; struct eri_allocation *next; } eri_allocation;\nstatic eri_allocation *eri_allocations=NULL;\nstatic void eri_cleanup(void) { while(eri_allocations) { eri_allocation *p=eri_allocations; eri_allocations=p->next; free(p->data); free(p); } }\nstatic void *eri_alloc(size_t n) { void *p=malloc(n?n:1); if(!p)eri_fault(\"out of memory\"); eri_allocation *a=malloc(sizeof(*a)); if(!a){free(p);eri_fault(\"out of memory\");} a->data=p; a->next=eri_allocations; eri_allocations=a; return p; }\nstatic eri_text eri_text_add(eri_text a,eri_text b) { if(a.len>SIZE_MAX-b.len)eri_fault(\"Text size overflow\"); size_t n=a.len+b.len; unsigned char *p=eri_alloc(n); if(a.len)memcpy(p,a.data,a.len); if(b.len)memcpy(p+a.len,b.data,b.len); return (eri_text){p,n}; }\nstatic bool eri_text_equal(eri_text a,eri_text b) { return a.len==b.len && (!a.len || memcmp(a.data,b.data,a.len)==0); }\nstatic void eri_out_int(int64_t value) { printf(\"%\" PRId64 \"\\n\",value); }\nstatic void eri_out_bool(bool value) { puts(value?\"true\":\"false\"); }\nstatic void eri_out_text(eri_text value) { if(value.len)fwrite(value.data,1,value.len,stdout); fputc('\\n',stdout); }\nstatic int64_t eri_iadd(int64_t a,int64_t b){ if((b>0&&a>INT64_MAX-b)||(b<0&&a<INT64_MIN-b))eri_fault(\"Int overflow\"); return a+b; }\nstatic int64_t eri_isub(int64_t a,int64_t b){ if((b<0&&a>INT64_MAX+b)||(b>0&&a<INT64_MIN+b))eri_fault(\"Int overflow\"); return a-b; }\nstatic int64_t eri_imul(int64_t a,int64_t b){ if(a==0||b==0)return 0; if((a==INT64_MIN&&b==-1)||(b==INT64_MIN&&a==-1))eri_fault(\"Int overflow\"); if(a>0){ if(b>0){if(a>INT64_MAX/b)eri_fault(\"Int overflow\");} else {if(b<INT64_MIN/a)eri_fault(\"Int overflow\");}} else { if(b>0){if(a<INT64_MIN/b)eri_fault(\"Int overflow\");} else {if(a!=0&&b<INT64_MAX/a)eri_fault(\"Int overflow\");}} return a*b; }\nstatic int64_t eri_idiv(int64_t a,int64_t b){ if(!b)eri_fault(\"Int division by zero\"); if(a==INT64_MIN&&b==-1)eri_fault(\"Int overflow\"); return a/b; }\nstatic int64_t eri_irem(int64_t a,int64_t b){ if(!b)eri_fault(\"Int remainder by zero\"); if(a==INT64_MIN&&b==-1)eri_fault(\"Int overflow\"); return a%b; }\nstatic int64_t eri_ineg(int64_t a){ if(a==INT64_MIN)eri_fault(\"Int overflow\"); return -a; }\n";
}
