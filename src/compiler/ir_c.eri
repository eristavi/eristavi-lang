// This backend consumes only verified Eristavi IR; it never interprets AST nodes.
import compiler.typed_ir as ir;
import compiler.ir_verify;
import compiler.scalar_runtime;
import compiler.semantic_model as m;
import compiler.format;

type Emitter { text Text; temporary Int; }
function append(emitter identity Emitter, text Text) { emitter.text=emitter.text+text+"\n"; }
function typeName(kind Int) returns Text { if kind == 1 { return "int64_t"; } if kind == 2 { return "double"; } if kind == 3 { return "bool"; } if kind == 4 { return "eri_text"; } return "void"; }
function suffix(kind Int) returns Text { if kind == 1 { return "int"; } if kind == 2 { return "float"; } if kind == 3 { return "bool"; } return "text"; }
function temp(emitter identity Emitter) returns Text { let name be "t"+format.integer(emitter.temporary); emitter.temporary=emitter.temporary+1; return name; }
function required(node maybe identity ir.Node) returns identity ir.Node { if node != none { return node; } return ir.node(-1,5,identity m.Location { path=""; line=0; column=0; next=none; }); }
function literal(node identity ir.Node) returns Text {
    if node.valueType == 1 { if node.number == -9223372036854775807-1 { return "INT64_MIN"; } return "INT64_C("+format.integer(node.number)+")"; }
    if node.valueType == 2 {
        let spelling be ""; let index be 0;
        while index < node.text.scalars.count { let ch be node.text.scalars[index]; if ch != "_" { spelling=spelling+ch; } index=index+1; }
        return "eri_float_literal("+format.quote(spelling)+")";
    }
    if node.valueType == 3 { if node.number == 1 { return "true"; } return "false"; }
    // Escape every UTF-8 byte using exactly three octal digits: no C source,
    // escape-sequence, trigraph, embedded NUL or execution-charset ambiguity.
    let result be ""; let index be 0;
    while index < node.text.bytes.count { let byte be node.text.bytes[index]; result=result+"\\"+"01234567".scalars[byte/64]+"01234567".scalars[(byte/8)%8]+"01234567".scalars[byte%8]; index=index+1; }
    return "(eri_text){(const unsigned char *)\""+result+"\",(size_t)"+format.integer(node.text.bytes.count)+"}";
}
function expression(emitter identity Emitter, node identity ir.Node) returns Text {
    let value be "";
    if node.kind == 1 { value=literal(node); }
    if node.kind == 2 { value="v"+format.integer(node.index); }
    if node.kind == 3 {
        let first be expression(emitter,required(node.first));
        if node.text == "not" { value="(!"+first+")"; } else { let helper be "eri_ineg"; if node.valueType == 2 { helper="eri_fneg"; } value=helper+"("+first+")"; }
    }
    if node.kind == 4 {
        let firstNode be required(node.first); let first be expression(emitter,firstNode);
        if node.text == "and" or node.text == "or" {
            let result be temp(emitter); append(emitter,"bool "+result+" = "+first+";");
            let condition be result; if node.text == "or" { condition="!"+result; }
            append(emitter,"if ("+condition+") {"); let second be expression(emitter,required(node.second)); append(emitter,result+" = "+second+";"); append(emitter,"}"); return result;
        }
        let second be expression(emitter,required(node.second)); let op be node.text;
        if op == "+" or op == "-" or op == "*" or op == "/" or op == "%" {
            let helper be "eri_iadd"; if op == "-" { helper="eri_isub"; } if op == "*" { helper="eri_imul"; } if op == "/" { helper="eri_idiv"; } if op == "%" { helper="eri_irem"; }
            if firstNode.valueType == 2 { helper="eri_fadd"; if op == "-" { helper="eri_fsub"; } if op == "*" { helper="eri_fmul"; } if op == "/" { helper="eri_fdiv"; } }
            if firstNode.valueType == 4 { helper="eri_text_add"; } value=helper+"("+first+","+second+")";
        } else {
            if firstNode.valueType == 4 { value="eri_text_equal("+first+","+second+")"; if op == "!=" { value="(!"+value+")"; } }
            else { value="("+first+" "+op+" "+second+")"; }
        }
    }
    if node.kind == 5 or node.kind == 6 {
        let arguments be ""; let separator be ""; let cursor be node.first;
        while cursor != none { let argument be expression(emitter,cursor); arguments=arguments+separator+argument; separator=","; cursor=cursor.next; }
        let name be "f"+format.integer(node.index);
        if node.kind == 6 { name="eri_out_"+suffix(required(node.first).valueType); }
        value=name+"("+arguments+")";
    }
    if node.valueType == 5 { append(emitter,value+";"); return ""; }
    // Every operand and argument is materialized in source order before its
    // consumer. C's unspecified argument evaluation order cannot leak through.
    let result be temp(emitter); append(emitter,typeName(node.valueType)+" "+result+" = "+value+";"); return result;
}
function block(emitter identity Emitter, node identity ir.Node) {
    let cursor be node.first;
    while cursor != none {
        let kind be cursor.kind;
        if kind == 10 or kind == 11 {
            let valueNode be required(cursor.first); let value be expression(emitter,valueNode); let prefix be "";
            if kind == 10 { prefix=typeName(valueNode.valueType)+" "; }
            append(emitter,prefix+"v"+format.integer(cursor.index)+" = "+value+";");
        }
        if kind == 12 { let ignored be expression(emitter,required(cursor.first)); }
        if kind == 15 { let value be cursor.first; if value == none { append(emitter,"return;"); } else { let result be expression(emitter,value); append(emitter,"return "+result+";"); } }
        if kind == 13 {
            let condition be expression(emitter,required(cursor.first)); append(emitter,"if ("+condition+") {"); block(emitter,required(cursor.second)); append(emitter,"}");
            let other be cursor.third; if other != none { append(emitter,"else {"); block(emitter,other); append(emitter,"}"); }
        }
        if kind == 14 {
            append(emitter,"while (true) {"); let condition be expression(emitter,required(cursor.first)); append(emitter,"if (!"+condition+") break;"); block(emitter,required(cursor.second)); append(emitter,"}");
        }
        cursor=cursor.next;
    }
}
function signature(routine identity ir.Function) returns Text {
    let result be "static "+typeName(routine.result)+" f"+format.integer(routine.index)+"("; let separator be ""; let parameter be routine.locals;
    while parameter != none { if parameter.parameter { result=result+separator+typeName(parameter.valueType)+" v"+format.integer(parameter.index); separator=","; } parameter=parameter.next; }
    if separator == "" { result=result+"void"; } return result+")";
}
public function emit(program identity ir.Program) returns Text fails m.SemanticError {
    try ir_verify.verify(program);
    let emitter be identity Emitter { text=scalar_runtime.source(); temporary=0; };
    let cursor be program.functions;
    while cursor != none { append(emitter,signature(cursor)+";"); cursor=cursor.next; }
    cursor=program.functions;
    while cursor != none { emitter.temporary=0; append(emitter,signature(cursor)+" {"); block(emitter,cursor.body); if cursor.result == 5 { append(emitter,"return;"); } append(emitter,"}"); cursor=cursor.next; }
    emitter.temporary=0; append(emitter,"int main(void) {"); append(emitter,"if (fesetround(FE_TONEAREST) != 0) eri_fault(\"cannot establish Float rounding mode\");"); append(emitter,"if (atexit(eri_cleanup) != 0) eri_fault(\"cannot register runtime cleanup\");"); block(emitter,program.entry.body); append(emitter,"return 0;\n}"); return emitter.text;
}
