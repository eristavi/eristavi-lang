public function helpersSource() returns Text { return ".text\n# Private ABI: rdi=binary64 bits, rsi=trusted writable 32-byte buffer.\n# Returns rax=byte length (no NUL), rdx=0 success/1 internal capacity fault.\n# Exact integer conversion followed by one decimal ties-even rounding to 17 digits.\n.globl erist_rt_float_format\n.type erist_rt_float_format,@function\nerist_rt_float_format:\n    pushq %rbx\n    pushq %r12\n    pushq %r13\n    pushq %r14\n    pushq %r15\n    subq $1792,%rsp\n    # 0..511: reserved scratch; 512..1663: exact decimal digits.\n    # 1664: decimal scale. Max finite conversion needs at most 767 digits.\n    movq %rsi,%r12\n    xorl %r13d,%r13d\n    testq %rdi,%rdi\n    jns .Lff_magnitude\n    movb $45,(%r12)\n    incq %r13\n.Lff_magnitude:\n    movabsq $0x7fffffffffffffff,%rax\n    andq %rdi,%rax\n    testq %rax,%rax\n    je .Lff_zero\n    movq %rax,%rcx\n    shrq $52,%rcx\n    movabsq $0xfffffffffffff,%rbx\n    andq %rax,%rbx\n    cmpq $2047,%rcx\n    je .Lff_special\n    testq %rcx,%rcx\n    je .Lff_subnormal\n    btsq $52,%rbx\n    subq $1075,%rcx\n    jmp .Lff_expand\n.Lff_subnormal:\n    movq $-1074,%rcx\n.Lff_expand:\n    movq %rbx,%rdi\n    movq %rcx,%rsi\n    leaq 512(%rsp),%rdx\n    call erist_rt_float_exact_digits\n    testq %rax,%rax\n    je .Lff_internal\n    movq %rax,%r14\n    movq %rdx,1664(%rsp)\n    leaq 512(%rsp),%r15\n.Lff_decimal_exponent:\n    movq %r14,%rbx\n    subq 1664(%rsp),%rbx\n    decq %rbx\n    cmpq $17,%r14\n    jbe .Lff_trim\n    cmpb $53,17(%r15)\n    jb .Lff_truncate\n    ja .Lff_round_up\n    movl $18,%r8d\n.Lff_round_sticky:\n    cmpq %r14,%r8\n    jae .Lff_round_tie\n    cmpb $48,(%r15,%r8)\n    jne .Lff_round_up\n    incq %r8\n    jmp .Lff_round_sticky\n.Lff_round_tie:\n    testb $1,16(%r15)\n    je .Lff_truncate\n.Lff_round_up:\n    movl $16,%r8d\n.Lff_round_carry:\n    incb (%r15,%r8)\n    cmpb $57,(%r15,%r8)\n    jbe .Lff_truncate\n    movb $48,(%r15,%r8)\n    decq %r8\n    jns .Lff_round_carry\n    movb