%al,(%r12,%r13)\n    incq %r13\n.Lff_exponent_two:\n    movq %rdx,%rax\n    xorl %edx,%edx\n    movl $10,%ecx\n    divq %rcx\n    addb $48,%al\n    movb %al,(%r12,%r13)\n    incq %r13\n    addb $48,%dl\n    movb %dl,(%r12,%r13)\n    incq %r13\n    jmp .Lff_done\n.Lff_special:\n    testq %rbx,%rbx\n    jne .Lff_nan\n    movw $0x6e69,(%r12,%r13)\n    movb $102,2(%r12,%r13)\n    addq $3,%r13\n    jmp .Lff_done\n.Lff_nan:\n    movw $0x616e,(%r12,%r13)\n    movb $110,2(%r12,%r13)\n    addq $3,%r13\n    jmp .Lff_done\n.Lff_zero:\n    movb $48,(%r12,%r13)\n    incq %r13\n.Lff_done:\n    movq %r13,%rax\n    xorl %edx,%edx\n    jmp .Lff_return\n.Lff_internal:\n    xorl %eax,%eax\n    movl $1,%edx\n.Lff_return:\n    addq $1792,%rsp\n    popq %r15\n    popq %r14\n    popq %r13\n    popq %r12\n    popq %rbx\n    ret\n.size erist_rt_float_format,.-erist_rt_float_format\n"; }
