// Exact binary64 decimal output foundation; private machine ABI only.
public function source() returns Text { return ".text\n# Private ABI: rdi=binary64 bits, rsi=trusted writable 32-byte buffer.\n# Returns rax=byte length (no NUL), rdx=0 success/1 internal capacity fault.\n# Exact integer conversion followed by one decimal ties-even rounding to 17 digits.\n.globl erist_rt_float_format\n.type erist_rt_float_format,@function\nerist_rt_float_format:\n    pushq %rbx\n    pushq %r12\n    pushq %r13\n    pushq %r14\n    pushq %r15\n    subq $1792,%rsp\n    # 0..511: 128 base-1e9 limbs; 512..1663: exact decimal digits.\n    # 1664: decimal scale. Max finite conversion needs at most 767 digits.\n    movq %rsi,%r12\n    xorl %r13d,%r13d\n    testq %rdi,%rdi\n    jns .Lff_magnitude\n    movb $45,(%r12)\n    incq %r13\n.Lff_magnitude:\n    movabsq $0x7fffffffffffffff,%rax\n    andq %rdi,%rax\n    testq %rax,%rax\n    je .Lff_zero\n    movq %rax,%rcx\n    shrq $52,%rcx\n    movabsq $0xfffffffffffff,%rbx\n    andq %rax,%rbx\n    cmpq $2047,%rcx\n    je .Lff_special\n    movq $0,1664(%rsp)\n    testq %rcx,%rcx\n    je .Lff_subnormal\n    btsq $52,%rbx\n    subq $1075,%rcx\n    jmp .Lff_power\n.Lff_subnormal:\n    movq $-1074,%rcx\n.Lff_power:\n    movl $2,%r15d\n    testq %rcx,%rcx\n    jns .Lff_positive_power\n    negq %rcx\n    movq %rcx,1664(%rsp)\n    movl $5,%r15d\n.Lff_positive_power:\n    movq %rcx,%r14\n    # Split the <=53-bit significand into two decimal limbs.\n    movq %rbx,%rax\n    xorl %edx,%edx\n    movl $1000000000,%ecx\n    divq %rcx\n    movl %edx,0(%rsp)\n    movl $1,%ebx\n    testq %rax,%rax\n    je .Lff_multiply_next\n    movl %eax,4(%rsp)\n    incq %rbx\n.Lff_multiply_next:\n    testq %r14,%r14\n    je .Lff_digits_start\n    # Up to 12 powers at once: 5^12 < 1e9, and each limb product fits uint64.\n    movq %r14,%rcx\n    cmpq $12,%rcx\n    jbe .Lff_chunk\n    movl $12,%ecx\n.Lff_chunk:\n    subq %rcx,%r14\n    movl $1,%r11d\n.Lff_factor:\n    imulq %r15,%r11\n    decq %rcx\n    jne .Lff_factor\n    xorl %r8d,%r8d\n    xorl %r10d,%r10d\n    movl $1000000000,%ecx\n.Lff_multiply_limb:\n    movl (%rsp,%r8,4),%eax\n    mulq %r11\n    addq %r10,%rax\n    # High half is zero by the limb/product bound above.\n    xorl %edx,%edx\n    divq %rcx\n    movl %edx,(%rsp,%r8,4)\n    movq %rax,%r10\n    incq %r8\n    cmpq %rbx,%r8\n    jb .Lff_multiply_limb\n    testq %r10,%r10\n    je .Lff_multiply_next\n    cmpq $128,%rbx\n    jae .Lff_internal\n    movl %r10d,(%rsp,%rbx,4)\n    incq %rbx\n    jmp .Lff_multiply_next\n.Lff_digits_start:\n    xorl %r14d,%r14d\n    leaq -1(%rbx),%r15\n.Lff_digit_limb:\n    movl (%rsp,%r15,4),%eax\n    leaq 520(%rsp,%r14),%r8\n    movl $9,%r9d\n    movl $10,%ecx\n.Lff_digit_loop:\n    xorl %edx,%edx\n    divq %rcx\n    addb $48,%dl\n    movb %dl,(%r8)\n    decq %r8\n    decq %r9\n    jne .Lff_digit_loop\n    addq $9,%r14\n    decq %r15\n    jns .Lff_digit_limb\n    leaq 512(%rsp),%r15\n.Lff_leading_zero:\n    cmpb $48,(%r15)\n    jne .Lff_decimal_exponent\n    incq %r15\n    decq %r14\n    jmp .Lff_leading_zero\n.Lff_decimal_exponent:\n    movq %r14,%rbx\n    subq 1664(%rsp),%rbx\n    decq %rbx\n    cmpq $17,%r14\n    jbe .Lff_trim\n    cmpb $53,17(%r15)\n    jb .Lff_truncate\n    ja .Lff_round_up\n    movl $18,%r8d\n.Lff_round_sticky:\n    cmpq %r14,%r8\n    jae .Lff_round_tie\n    cmpb $48,(%r15,%r8)\n    jne .Lff_round_up\n    incq %r8\n    jmp .Lff_round_sticky\n.Lff_round_tie:\n    testb $1,16(%r15)\n    je .Lff_truncate\n.Lff_round_up:\n    movl $16,%r8d\n.Lff_round_carry:\n    incb (%r15,%r8)\n    cmpb $57,(%r15,%r8)\n    jbe .Lff_truncate\n    movb $48,(%r15,%r8)\n    decq %r8\n    jns .Lff_round_carry\n    movb $49,(%r15)\n    incq %rbx\n.Lff_truncate:\n    movl $17,%r14d\n.Lff_trim:\n    cmpq $1,%r14\n    jbe .Lff_notation\n    cmpb $48,-1(%r15,%r14)\n    jne .Lff_notation\n    decq %r14\n    jmp .Lff_trim\n.Lff_notation:\n    cmpq $-4,%rbx\n    jl .Lff_scientific\n    cmpq $17,%rbx\n    jge .Lff_scientific\n    testq %rbx,%rbx\n    js .Lff_small_fixed\n    leaq 1(%rbx),%r8\n    xorl %r9d,%r9d\n.Lff_fixed_digits:\n    movb (%r15,%r9),%al\n    movb %al,(%r12,%r13)\n    incq %r13\n    incq %r9\n    cmpq %r14,%r9\n    jae .Lff_fixed_padding\n    cmpq %r8,%r9\n    jne .Lff_fixed_digits\n    movb $46,(%r12,%r13)\n    incq %r13\n    jmp .Lff_fixed_digits\n.Lff_fixed_padding:\n    cmpq %r8,%r9\n    jae .Lff_done\n    movb $48,(%r12,%r13)\n    incq %r13\n    incq %r9\n    jmp .Lff_fixed_padding\n.Lff_small_fixed:\n    movb $48,(%r12,%r13)\n    incq %r13\n    movb $46,(%r12,%r13)\n    incq %r13\n    movq %rbx,%r8\n    negq %r8\n    decq %r8\n.Lff_small_padding:\n    testq %r8,%r8\n    je .Lff_small_digits\n    movb $48,(%r12,%r13)\n    incq %r13\n    decq %r8\n    jmp .Lff_small_padding\n.Lff_small_digits:\n    xorl %r9d,%r9d\n.Lff_small_copy:\n    movb (%r15,%r9),%al\n    movb %al,(%r12,%r13)\n    incq %r13\n    incq %r9\n    cmpq %r14,%r9\n    jb .Lff_small_copy\n    jmp .Lff_done\n.Lff_scientific:\n    movb (%r15),%al\n    movb %al,(%r12,%r13)\n    incq %r13\n    cmpq $1,%r14\n    je .Lff_exponent\n    movb $46,(%r12,%r13)\n    incq %r13\n    movl $1,%r9d\n.Lff_scientific_copy:\n    movb (%r15,%r9),%al\n    movb %al,(%r12,%r13)\n    incq %r13\n    incq %r9\n    cmpq %r14,%r9\n    jb .Lff_scientific_copy\n.Lff_exponent:\n    movb $101,(%r12,%r13)\n    incq %r13\n    movb $43,%cl\n    movq %rbx,%rax\n    testq %rax,%rax\n    jns .Lff_exponent_magnitude\n    movb $45,%cl\n    negq %rax\n.Lff_exponent_magnitude:\n    movb %cl,(%r12,%r13)\n    incq %r13\n    movl $100,%ecx\n    xorl %edx,%edx\n    divq %rcx\n    testq %rax,%rax\n    je .Lff_exponent_two\n    addb $48,%al\n    movb %al,(%r12,%r13)\n    incq %r13\n.Lff_exponent_two:\n    movq %rdx,%rax\n    xorl %edx,%edx\n    movl $10,%ecx\n    divq %rcx\n    addb $48,%al\n    movb %al,(%r12,%r13)\n    incq %r13\n    addb $48,%dl\n    movb %dl,(%r12,%r13)\n    incq %r13\n    jmp .Lff_done\n.Lff_special:\n    testq %rbx,%rbx\n    jne .Lff_nan\n    movw $0x6e69,(%r12,%r13)\n    movb $102,2(%r12,%r13)\n    addq $3,%r13\n    jmp .Lff_done\n.Lff_nan:\n    movw $0x616e,(%r12,%r13)\n    movb $110,2(%r12,%r13)\n    addq $3,%r13\n    jmp .Lff_done\n.Lff_zero:\n    movb $48,(%r12,%r13)\n    incq %r13\n.Lff_done:\n    movq %r13,%rax\n    xorl %edx,%edx\n    jmp .Lff_return\n.Lff_internal:\n    xorl %eax,%eax\n    movl $1,%edx\n.Lff_return:\n    addq $1792,%rsp\n    popq %r15\n    popq %r14\n    popq %r13\n    popq %r12\n    popq %rbx\n    ret\n.size erist_rt_float_format,.-erist_rt_float_format\n"; }
