public function source() returns Text { return ".section .rodata\n.Lview_bytes_name:\n.asciz \"bytes\"\n.Lview_scalars_name:\n.asciz \"scalars\"\n.Lview_bounds_message:\n.ascii \"Eristavi runtime fault: Text view index out of bounds\\n\"\n.Lview_bounds_end:\n.text\n.globl erist_rt_view_kind\n.type erist_rt_view_kind,@function\nerist_rt_view_kind:\n    cmpq $6,%rdi\n    jb erist_rt_value_fault_internal\n    movq %rdi,%rax\n    shrq $59,%rax\n    jne erist_rt_value_fault_internal\n    leaq ev_types(%rip),%rax\n    testq %rax,%rax\n    je erist_rt_value_fault_internal\n    shlq $5,%rdi\n    addq %rdi,%rax\n    jc erist_rt_value_fault_internal\n    cmpl $12,0(%rax)\n    jne erist_rt_value_fault_internal\n    movq 8(%rax),%rdi\n    testq %rdi,%rdi\n    je erist_rt_value_fault_internal\n    subq $8,%rsp\n    leaq .Lview_bytes_name(%rip),%rsi\n    call .Lview_name_equal\n    testl %eax,%eax\n    jne .Lview_kind_bytes\n    leaq .Lview_scalars_name(%rip),%rsi\n    call .Lview_name_equal\n    testl %eax,%eax\n    je .Lview_kind_internal\n    movl $2,%eax\n    addq $8,%rsp\n    ret\n.Lview_kind_bytes:\n    movl $1,%eax\n    addq $8,%rsp\n    ret\n.Lview_kind_internal:\n    addq $8,%rsp\n    jmp erist_rt_value_fault_internal\n.Lview_name_equal:\n    xorl %ecx,%ecx\n.Lview_name_loop:\n    movzbl (%rdi,%rcx),%edx\n    cmpb (%rsi,%rcx),%dl\n    jne .Lview_name_no\n    testl %edx,%edx\n    je .Lview_name_yes\n    incq %rcx\n    jmp .Lview_name_loop\n.Lview_name_yes:\n    movl $1,%eax\n    ret\n.Lview_name_no:\n    xorl %eax,%eax\n    ret\n.size erist_rt_view_kind,.-erist_rt_view_kind\n.globl evn_view\n.type evn_view,@function\nevn_view:\n    pushq %rbx\n    pushq %r12\n    pushq %r13\n    movq %rdi,%r12\n    movq %rsi,%r13\n    cmpq $4,0(%r13)\n    jne .Lview_new_internal\n    call erist_rt_view_kind\n    movq %rax,%rbx\n    movq %r12,%rdi\n    movq 8(%r13),%rsi\n    call erist_rt_value_new\n    movq 16(%r13),%rcx\n    movq %rcx,16(%rax)\n    movq %rbx,24(%rax)\n    movq %rax,%rdi\n    call erist_rt_text_safe_point\n    popq %r13\n    popq %r12\n    popq %rbx\n    ret\n.Lview_new_internal:\n    popq %r13\n    popq %r12\n    popq %rbx\n    jmp erist_rt_value_fault_internal\n.size evn_view,.-evn_view\n.globl evn_count\n.type evn_count,@function\nevn_count:\n    pushq %rbx\n    movq %rdi,%rbx\n    movq 0(%rdi),%rdi\n    call erist_rt_view_kind\n    cmpq 24(%rbx),%rax\n    jne .Lview_count_internal\n    cmpq $1,%rax\n    je .Lview_count_bytes\n    movq 8(%rbx),%r10\n    movq 16(%rbx),%r11\n    xorl %r8d,%r8d\n    xorl %r9d,%r9d\n.Lview_count_loop:\n    cmpq %r10,%r8\n    jae .Lview_count_done\n    movzbl (%r11,%r8),%eax\n    call .Lview_width\n    addq %rax,%r8\n    cmpq %r10,%r8\n    ja .Lview_count_internal\n    incq %r9\n    jmp .Lview_count_loop\n.Lview_count_done:\n    movq %r9,%rdi\n    popq %rbx\n    jmp evn_int\n.Lview_count_bytes:\n    movq 8(%rbx),%rdi\n    popq %rbx\n    jmp evn_int\n.Lview_count_internal:\n    popq %rbx\n    jmp erist_rt_value_fault_internal\n.size evn_count,.-evn_count\n.Lview_width:\n    cmpl $128,%eax\n    jb .Lview_width_one\n    cmpl $224,%eax\n    jb .Lview_width_two\n    cmpl $240,%eax\n    jb .Lview_width_three\n    movl $4,%eax\n    ret\n.Lview_width_one:\n    movl $1,%eax\n    ret\n.Lview_width_two:\n    movl $2,%eax\n    ret\n.Lview_width_three:\n    movl $3,%eax\n    ret\n.globl evn_index\n.type evn_index,@function\nevn_index:\n    pushq %rbx\n    pushq %r12\n    pushq %r13\n    movq %rdi,%rbx\n    movq %rsi,%r12\n    testq %r12,%r12\n    js .Lview_index_bounds\n    movq 0(%rdi),%rdi\n    call erist_rt_view_kind\n    cmpq 24(%rbx),%rax\n    jne .Lview_index_internal\n    cmpq $1,%rax\n    jne .Lview_index_scalars\n    cmpq 8(%rbx),%r12\n    jae .Lview_index_bounds\n    movq 16(%rbx),%rax\n    movzbl (%rax,%r12),%edi\n    popq %r13\n    popq %r12\n    popq %rbx\n    jmp evn_int\n.Lview_index_scalars:\n    movq 8(%rbx),%r10\n    movq 16(%rbx),%r11\n    xorl %r8d,%r8d\n    xorl %r9d,%r9d\n.Lview_index_loop:\n