// Temporary nonowning slot-root membership index, rebuilt for each pruning pass.
// Fresh zero-filled scratch is reserved separately from the value allocator.
// Scope maps remain authoritative; no keys are dereferenced or retained afterward.
public function source() returns Text {
    return ".text\n# Scratch membership set: exact keys only, never dereferenced.\n# Zero denotes an empty bucket. Capacity is at least twice the key bound.\n.Lslots_index_insert:\n    testq %rdi,%rdi\n    je .Lslots_index_insert_done\n    movq %rdi,%rax\n    shrq $4,%rax\n    movq %rax,%rcx\n    shrq $17,%rcx\n    xorq %rcx,%rax\n    andq %rdx,%rax\n.Lslots_index_insert_probe:\n    movq (%rsi,%rax,8),%rcx\n    testq %rcx,%rcx\n    je .Lslots_index_insert_store\n    cmpq %rdi,%rcx\n    je .Lslots_index_insert_done\n    incq %rax\n    andq %rdx,%rax\n    jmp .Lslots_index_insert_probe\n.Lslots_index_insert_store:\n    movq %rdi,(%rsi,%rax,8)\n.Lslots_index_insert_done:\n    ret\n.Lslots_index_contains:\n    movq %rdi,%rax\n    shrq $4,%rax\n    movq %rax,%rcx\n    shrq $17,%rcx\n    xorq %rcx,%rax\n    andq %rdx,%rax\n.Lslots_index_find_probe:\n    movq (%rsi,%rax,8),%rcx\n    testq %rcx,%rcx\n    je .Lslots_index_missing\n    cmpq %rdi,%rcx\n    je .Lslots_index_present\n    incq %rax\n    andq %rdx,%rax\n    jmp .Lslots_index_find_probe\n.Lslots_index_missing:\n    xorl %eax,%eax\n    ret\n.Lslots_index_present:\n    movl $1,%eax\n    ret\n# Called only after every scope has a bound root map. Reservation failure uses\n# the original linear search; pruning never requires a successful reservation.\n.Lslots_prepare_index:\n    pushq %rbx\n    pushq %r12\n    pushq %r13\n    pushq %r14\n    pushq %r15\n    xorl %r15d,%r15d\n    movq .Lvalue_scopes(%rip),%r12\n.Lslots_index_count:\n    addq 32(%r12),%r15\n    jc .Lslots_index_unavailable\n    addq $1,%r15\n    jc .Lslots_index_unavailable\n    movq 8(%r12),%r12\n    testq %r12,%r12\n    jne .Lslots_index_count\n    addq %r15,%r15\n    jc .Lslots_index_unavailable\n    movl $16,%r14d\n.Lslots_index_capacity:\n    cmpq %r15,%r14\n    jae .Lslots_index_allocate\n    addq %r14,%r14\n    jc .Lslots_index_unavailable\n    jmp .Lslots_index_capacity\n.Lslots_index_allocate:\n    movq %r14,%rax\n    shrq $60,%rax\n    jne .Lslots_index_unavailable\n    leaq (,%r14,8),%rdi\n    call erist_rt_reserve\n    testq %rax,%rax\n    je .Lslots_index_unavailable\n    movq %rax,%r13\n    movq %rdx,%r15\n    decq %r14\n    movq .Lvalue_scopes(%rip),%r12\n.Lslots_index_frame:\n    movq 0(%r12),%rdi\n    movq %r13,%rsi\n    movq %r14,%rdx\n    call .Lslots_index_insert\n    xorl %ebx,%ebx\n.Lslots_index_root:\n    cmpq 32(%r12),%rbx\n    jae .Lslots_index_next_frame\n    movq 24(%r12),%rax\n    cmpb $1,(%rax,%rbx)\n    jne .Lslots_index_next_root\n    movq 16(%r12),%rax\n    movq (%rax,%rbx,8),%rdi\n    movq %r13,%rsi\n    movq %r14,%rdx\n    call .Lslots_index_insert\n.Lslots_index_next_root:\n    incq %rbx\n    jmp .Lslots_index_root\n.Lslots_index_next_frame:\n    movq 8(%r12),%r12\n    testq %r12,%r12\n    jne .Lslots_index_frame\n    movq %r13,%rax\n    movq %r14,%rdx\n    movq %r15,%rcx\n    jmp .Lslots_index_prepared\n.Lslots_index_unavailable:\n    xorl %eax,%eax\n    xorl %edx,%edx\n.Lslots_index_prepared:\n    popq %r15\n    popq %r14\n    popq %r13\n    popq %r12\n    popq %rbx\n    ret\n";
}
