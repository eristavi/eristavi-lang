// Temporary nonowning slot-root membership index, rebuilt for each pruning pass.
// Fresh zero-filled scratch is reserved separately from the value allocator.
// Scope maps remain authoritative; no keys are dereferenced or retained afterward.
public function source() returns Text {
    return ".text\n# Scratch membership set: exact keys only, never dereferenced.\n# Zero denotes an empty bucket. Capacity is at least twice the key bound.\n.Lslots_index_insert:\n    testq %rdi,%rdi\n    je .Lslots_index_insert_done\n    movq %rdi,%rax\n    shrq $4,%rax\n    movq %rax,%rcx\n    shrq $17,%rcx\n    xorq %rcx,%rax\n    andq %rdx,%rax\n.Lslots_index_insert_probe:\n    movq (%rsi,%rax,8),%rcx\n    testq %rcx,%rcx\n    je .Lslots_index_insert_store\n    cmpq %rdi,%rcx\n    je .Lslots_index_insert_done\n    incq %rax\n    andq %rdx,%rax\n    jmp .Lslots_index_insert_probe\n.Lslots_index_insert_store:\n    movq %rdi,(%rsi,%rax,8)\n.Lslots_index_insert_done:\n    ret\n.Lslots_index_contains:\n    movq %rdi,%rax\n    shrq $4,%rax\n    movq %rax,%rcx\n    shrq $17,%rcx\n    xorq %rcx,%rax\n    andq %rdx,%rax\n.Lslots_index_find_probe:\n    movq (%rsi,%rax,8),%rcx\n    testq %rcx,%rcx\n    je .Lslots_index_missing\n    cmpq %rdi,%rcx\n    je .Lslots_index_present\n    incq %rax\n    andq %rdx,%rax\n    jmp .Lslots_index_find_probe\n.Lslots_index_missing:\n    xorl %eax,%eax\n    ret\n.Lslots_index_present:\n    movl $1,%eax\n    ret\n# Called only after every scope has a bound root map. Reservation failure uses\n# the original linear search; pruning never requires a successful reservation.\n.Lslots_prepare_index:\n    pushq %rbx\n    pushq %r12\n    pushq %r13\n    pushq %r14\n    pushq %r15\n    xorl %r15d,%r15d\n    movq .Lvalue_scopes(%rip),%r12\n.Lslots_index_count:\n    addq 32(%r12),%r15\n    jc .Lslots_index_unavailable\n    addq $1,%r15\n    jc .Lslots_index_unavailable\n    movq 8(%r12),%r12\n    testq %r12,%r12\n    jne .Lslots_index_count\n    addq %r15,%r15\n    jc .Lslots_index_unavailable\n    movl $16,%r14d\n.Lslots_index_capacity:\n    cmpq %r15,%r14\n    jae .Lslots_index_allocate\n    addq %r14,%r14\n    jc .Lslots_index_unavailable\n    jmp .Lslots_index_capacity\n.Lslots_index_allocate:\n    movq %r14,%rax\n    shrq $60,%rax\n    jne .Lslots_index_unavailable\n    leaq (,%r14,8),%rdi\n    call erist_rt_reserve\n    testq %rax,%rax\n    je .Lslots_index_unavailable\n    movq %rax,%r13\n    movq %rdx,%r15\n    decq %r14\n    movq .Lvalue_scopes(%rip),%r12\n.Lslots_index_frame:\n    movq 0(%r12),%rdi\n    movq %r13,%rsi\n    movq %r14,%rdx\n    call .Lslots_index_insert\n    xorl %ebx,%ebx\n.Lslots_index_root:\n    cmpq 32(%r12),%rbx\n    jae .Lslots_index_next_frame\n    movq 24(%r12),%rax\n    cmpb $1,(%rax,%rbx)\n    jne .Lslots_index_next_root\n    movq 16(%r12),%rax\n    movq (%rax,%rbx,8),%rdi\n    movq %r13,%rsi\n    movq %r14,%rdx\n    call .Lslots_index_insert\n.Lslots_index_next_root:\n    incq %rbx\n    jmp .Lslots_index_root\n.Lslots_index_next_frame:\n    movq 8(%r12),%r12\n    testq %r12,%r12\n    jne .Lslots_index_frame\n    movq %r13,%rax\n    movq %r14,%rdx\n    movq %r15,%rcx\n    jmp .Lslots_index_prepared\n.Lslots_index_unavailable:\n    xorl %eax,%eax\n    xorl %edx,%edx\n.Lslots_index_prepared:\n    popq %r15\n    popq %r14\n    popq %r13\n    popq %r12\n    popq %rbx\n    ret\n.text\n# Clear surviving register roots that name slots abandoned by a checked jump.\n# rdi=slot boundary, rsi=surviving scope. Exact-key scratch membership, with\n# a linear no-allocation fallback if the reservation cannot be obtained.\n.Lslots_clear_unwind_roots:\n    pushq %rbx\n    pushq %r12\n    pushq %r13\n    pushq %r14\n    pushq %r15\n    subq $48,%rsp\n    movq %rdi,0(%rsp)\n    movq %rsi,8(%rsp)\n    movq $0,16(%rsp)\n    movq .Lvalue_slots(%rip),%r12\n    xorl %r15d,%r15d\n.Lunwind_index_count:\n    cmpq 0(%rsp),%r12\n    je .Lunwind_index_capacity_start\n    testq %r12,%r12\n    je erist_rt_value_fault_internal\n    addq $1,%r15\n    jc erist_rt_value_fault_internal\n    movq 32(%r12),%r12\n    jmp .Lunwind_index_count\n.Lunwind_index_capacity_start:\n    testq %r15,%r15\n    je .Lunwind_roots_return\n    addq %r15,%r15\n    jc .Lunwind_index_fallback\n    movl $16,%r14d\n.Lunwind_index_capacity:\n    cmpq %r15,%r14\n    jae .Lunwind_index_allocate\n    addq %r14,%r14\n    jc .Lunwind_index_fallback\n    jmp .Lunwind_index_capacity\n.Lunwind_index_allocate:\n    movq %r14,%rax\n    shrq $60,%rax\n    jne .Lunwind_index_fallback\n    leaq (,%r14,8),%rdi\n    call erist_rt_reserve\n    testq %rax,%rax\n    je .Lunwind_index_fallback\n    movq %rax,%r13\n    movq %rax,16(%rsp)\n    movq %rdx,24(%rsp)\n    decq %r14\n    movq .Lvalue_slots(%rip),%r12\n.Lunwind_index_fill:\n    cmpq 0(%rsp),%r12\n    je .Lunwind_roots_start\n    movq %r12,%rdi\n    movq %r13,%rsi\n    movq %r14,%rdx\n    call .Lslots_index_insert\n    movq 32(%r12),%r12\n    jmp .Lunwind_index_fill\n.Lunwind_index_fallback:\n    movq $0,16(%rsp)\n.Lunwind_roots_start:\n    movq 8(%rsp),%r12\n.Lunwind_roots_scope:\n    testq %r12,%r12\n    je .Lunwind_roots_release\n    cmpq $0,16(%r12)\n    je .Lunwind_roots_next_scope\n    cmpq $0,24(%r12)\n    je .Lunwind_roots_next_scope\n    xorl %ebx,%ebx\n.Lunwind_roots_entry:\n    cmpq 32(%r12),%rbx\n    jae .Lunwind_roots_next_scope\n    movq 24(%r12),%rax\n    cmpb $1,(%rax,%rbx)\n    jne .Lunwind_roots_next_entry\n    movq 16(%r12),%rax\n    movq (%rax,%rbx,8),%rdi\n    testq %rdi,%rdi\n    je .Lunwind_roots_next_entry\n    cmpq $0,16(%rsp)\n    je .Lunwind_roots_linear\n    movq %r13,%rsi\n    movq %r14,%rdx\n    call .Lslots_index_contains\n    testl %eax,%eax\n    je .Lunwind_roots_next_entry\n    jmp .Lunwind_roots_clear\n.Lunwind_roots_linear:\n    movq .Lvalue_slots(%rip),%rax\n.Lunwind_roots_find:\n    cmpq 0(%rsp),%rax\n    je .Lunwind_roots_next_entry\n    cmpq %rdi,%rax\n    je .Lunwind_roots_clear\n    movq 32(%rax),%rax\n    jmp .Lunwind_roots_find\n.Lunwind_roots_clear:\n    movq 16(%r12),%rax\n    movq $0,(%rax,%rbx,8)\n.Lunwind_roots_next_entry:\n    incq %rbx\n    jmp .Lunwind_roots_entry\n.Lunwind_roots_next_scope:\n    movq 8(%r12),%r12\n    jmp .Lunwind_roots_scope\n.Lunwind_roots_release:\n    movq 16(%rsp),%rdi\n    testq %rdi,%rdi\n    je .Lunwind_roots_return\n    movq 24(%rsp),%rsi\n    call erist_rt_release\n    testq %rax,%rax\n    jne erist_rt_value_fault_internal\n.Lunwind_roots_return:\n    addq $48,%rsp\n    popq %r15\n    popq %r14\n    popq %r13\n    popq %r12\n    popq %rbx\n    ret\n";
}
