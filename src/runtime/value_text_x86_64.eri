function constructorSource() returns Text { return ".text\n.globl evn_text\n.type evn_text,@function\nevn_text:\n    pushq %r12\n    movq %rsi,%r12\n    call erist_rt_text_buffer_copy\n    testq %rcx,%rcx\n    jne .Ltext_constructor_failure\n    movq %rax,%rdi\n    movq %rdx,%rsi\n    movq %r12,%rdx\n    popq %r12\n    jmp erist_rt_text_publish\n.Ltext_constructor_failure:\n    popq %r12\n    cmpq $3,%rcx\n    je erist_rt_value_fault_oom\n    cmpq $1,%rcx\n    je erist_rt_text_fault_invalid\n    cmpq $2,%rcx\n    je erist_rt_text_fault_size\n    jmp erist_rt_value_fault_internal\n.size evn_text,.-evn_text\n.globl erist_rt_text_fault_invalid\n.type erist_rt_text_fault_invalid,@function\nerist_rt_text_fault_invalid:\n    leaq .Ltext_invalid_message(%rip),%rsi\n    movl $(.Ltext_invalid_end-.Ltext_invalid_message),%edx\n    jmp .Lvalue_fault_emit\n.size erist_rt_text_fault_invalid,.-erist_rt_text_fault_invalid\n.globl erist_rt_text_fault_size\n.type erist_rt_text_fault_size,@function\nerist_rt_text_fault_size:\n    leaq .Ltext_size_message(%rip),%rsi\n    movl $(.Ltext_size_end-.Ltext_size_message),%edx\n    jmp .Lvalue_fault_emit\n.size erist_rt_text_fault_size,.-erist_rt_text_fault_size\n.section .rodata\n.Ltext_invalid_message:\n.ascii \"Eristavi runtime fault: invalid UTF-8 inside Text\\n\"\n.Ltext_invalid_end:\n.Ltext_size_message:\n.ascii \"Eristavi runtime fault: Text size overflow\\n\"\n.Ltext_size_end:\n"; }
