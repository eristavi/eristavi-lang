function constructorSource() returns Text { return ".text\n.globl evn_text\n.type evn_text,@function\nevn_text:\n    pushq %rbx\n    pushq %r12\n    pushq %r13\n    pushq %r14\n    pushq %r15\n    movq %rsi,%r12\n    call erist_rt_text_buffer_copy\n    testq %rcx,%rcx\n    jne .Ltext_new_failure\n    movq %rax,%r13\n    movq %rdx,%r14\n    testq %r13,%r13\n    je .Ltext_new_slot\n    movl $40,%edi\n    call erist_rt_alloc\n    testq %rax,%rax\n    je .Ltext_new_record_oom\n    movq %rax,%r15\n    movq .Ltext_records(%rip),%rax\n    movq %rax,0(%r15)\n    movq %r13,8(%r15)\n    movq %r14,16(%r15)\n    movq %r12,24(%r15)\n    movq $0,32(%r15)\n    movq %r15,.Ltext_records(%rip)\n    addq $1,.Ltext_count(%rip)\n    jc .Ltext_new_internal\n.Ltext_new_slot:\n    movl $4,%edi\n    movq %r12,%rsi\n    call erist_rt_value_new\n    movq %r13,16(%rax)\n    movq %rax,%rbx\n    movq %rax,%rdi\n    call erist_rt_text_safe_point\n    movq %rbx,%rax\n    popq %r15\n    popq %r14\n    popq %r13\n    popq %r12\n    popq %rbx\n    ret\n.Ltext_new_record_oom:\n    movq %r13,%rdi\n    movq %r14,%rsi\n    call erist_rt_release\n    jmp .Ltext_new_oom\n.Ltext_new_failure:\n    cmpq $3,%rcx\n    je .Ltext_new_oom\n    cmpq $1,%rcx\n    je .Ltext_new_invalid\n    cmpq $2,%rcx\n    je .Ltext_new_size\n.Ltext_new_internal:\n    popq %r15\n    popq %r14\n    popq %r13\n    popq %r12\n    popq %rbx\n    jmp erist_rt_value_fault_internal\n.Ltext_new_oom:\n    popq %r15\n    popq %r14\n    popq %r13\n    popq %r12\n    popq %rbx\n    jmp erist_rt_value_fault_oom\n.Ltext_new_invalid:\n    leaq .Ltext_invalid_message(%rip),%rsi\n    movl $(.Ltext_invalid_end-.Ltext_invalid_message),%edx\n    jmp .Ltext_new_fault\n.Ltext_new_size:\n    leaq .Ltext_size_message(%rip),%rsi\n    movl $(.Ltext_size_end-.Ltext_size_message),%edx\n.Ltext_new_fault:\n    movl $2,%edi\n    call erist_rt_write_all\n    movl $1,%edi\n    call erist_rt_exit\n    ud2\n.size evn_text,.-evn_text\n.section .rodata\n.Ltext_invalid