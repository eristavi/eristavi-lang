// Shared exact binary64/midpoint decimal expansion, private machine ABI.
public function source() returns Text { return ".text\n# exact_digits(M,E,buffer1152) -> rax=digit count, rdx=decimal scale.\n# M in 1..2^54-1, E in -1075..971; no FP or heap operations.\n.globl erist_rt_float_exact_digits\n.type erist_rt_float_exact_digits,@function\nerist_rt_float_exact_digits:\n    pushq %rbx\n    pushq %r12\n    pushq %r13\n    pushq %r14\n    pushq %r15\n    subq $512,%rsp\n    movq %rdx,%r12\n    testq %rdi,%rdi\n    jle .Lfd_internal\n    movabsq $18014398509481983,%rax\n    cmpq %rax,%rdi\n    ja .Lfd_internal\n    cmpq $-1075,%rsi\n    jl .Lfd_internal\n    cmpq $971,%rsi\n    jg .Lfd_internal\n    movq %rdi,%rbx\n    movq %rsi,%rcx\n    xorl %r13d,%r13d\n    movl $2,%r15d\n    testq %rcx,%rcx\n    jns .Lfd_positive_power\n    negq %rcx\n    movq %rcx,%r13\n    movl $5,%r15d\n.Lfd_positive_power:\n    movq %rcx,%r14\n    # Split the <=53-bit significand into two decimal limbs.\n    movq %rbx,%rax\n    xorl %edx,%edx\n    movl $1000000000,%ecx\n    divq %rcx\n    movl %edx,0(%rsp)\n    movl $1,%ebx\n    testq %rax,%rax\n    je .Lfd_multiply_next\n    movl %eax,4(%rsp)\n    incq %rbx\n.Lfd_multiply_next:\n    testq %r14,%r14\n    je .Lfd_digits_start\n    # Up to 12 powers at once: 5^12 < 1e9, and each limb product fits uint64.\n    movq %r14,%rcx\n    cmpq $12,%rcx\n    jbe .Lfd_chunk\n    movl $12,%ecx\n.Lfd_chunk:\n    subq %rcx,%r14\n    movl $1,%r11d\n.Lfd_factor:\n    imulq %r15,%r11\n    decq %rcx\n    jne .Lfd_factor\n    xorl %r8d,%r8d\n    xorl %r10d,%r10d\n    movl $1000000000,%ecx\n.Lfd_multiply_limb:\n    movl (%rsp,%r8,4),%eax\n    mulq %r11\n    addq %r10,%rax\n    # High half is zero by the limb/product bound above.\n    xorl %edx,%edx\n    divq %rcx\n    movl %edx,(%rsp,%r8,4)\n    movq %rax,%r10\n    incq %r8\n    cmpq %rbx,%r8\n    jb .Lfd_multiply_limb\n    testq %r10,%r10\n    je .Lfd_multiply_next\n    cmpq $128,%rbx\n    jae .Lfd_internal\n    movl %r10d,(%rsp,%rbx,4)\n    incq %rbx\n    jmp .Lfd_multiply_next\n.Lfd_digits_start:\n    xorl %r14d,%r14d\n    leaq -1(%rbx),%r15\n.Lfd_digit_limb:\n    movl (%rsp,%r15,4),%eax\n    leaq 8(%r12,%r14),%r8\n    movl $9,%r9d\n    movl $10,%ecx\n.Lfd_digit_loop:\n    xorl %edx,%edx\n    divq %rcx\n    addb $48,%dl\n    movb %dl,(%r8)\n    decq %r8\n    decq %r9\n    jne .Lfd_digit_loop\n    addq $9,%r14\n    decq %r15\n    jns .Lfd_digit_limb\n    movq %r12,%r15\n.Lfd_leading_zero:\n    cmpb $48,(%r15)\n    jne .Lfd_success\n    incq %r15\n    decq %r14\n    jmp .Lfd_leading_zero\n.Lfd_success:\n    movq %r14,%rax\n    movq %r13,%rdx\n    movq %r15,%rsi\n    movq %r12,%rdi\n    movq %r14,%rcx\n    cld\n    rep movsb\n    jmp .Lfd_return\n.Lfd_internal:\n    xorl %eax,%eax\n    xorl %edx,%edx\n.Lfd_return:\n    addq $512,%rsp\n    popq %r15\n    popq %r14\n    popq %r13\n    popq %r12\n    popq %rbx\n    ret\n.size erist_rt_float_exact_digits,.-erist_rt_float_exact_digits\n"; }
