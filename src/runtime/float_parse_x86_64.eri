// Correctly rounded canonical decimal literals using exact midpoint search.
import runtime.float_decimal_x86_64;
public function helpersSource() returns Text { return ".text\n# Private canonical decimal ABI: rdi=NUL-terminated spelling, no separators.\n# rax=binary64 bits; rdx=0 success, 1 malformed, 2 internal defect.\n# Whole input is validated; 800 significant digits plus sticky suffice because\n# every adjacent binary64 midpoint has <=768 exact significant decimal digits.\n.globl erist_rt_float_parse\n.type erist_rt_float_parse,@function\nerist_rt_float_parse:\n    pushq %rbx\n    pushq %r12\n    pushq %r13\n    pushq %r14\n    pushq %r15\n    subq $2112,%rsp\n    movq %rdi,%r12\n    testq %r12,%r12\n    je .Lfp_invalid\n    xorl %r13d,%r13d\n    xorl %r14d,%r14d\n    xorl %r15d,%r15d\n    movq $0,1960(%rsp)\n    movq $0,1984(%rsp)\n    movq $0,1992(%rsp)\n    movq $0,2056(%rsp)\n    movq $0,2032(%rsp)\n    cmpb $45,(%r12)\n    jne .Lfp_plus\n    movabsq $0x8000000000000000,%rax\n    movq %rax,1992(%rsp)\n    incq %r12\n    jmp .Lfp_first\n.Lfp_plus:\n    cmpb $43,(%r12)\n    jne .Lfp_first\n    incq %r12\n.Lfp_first:\n    movzbl (%r12),%eax\n    subl $48,%eax\n    cmpl $9,%eax\n    ja .Lfp_invalid\n.Lfp_mantissa:\n    movzbl (%r12),%eax\n    subl $48,%eax\n    cmpl $9,%eax\n    ja .Lfp_non_digit\n    cmpq $0,1984(%rsp)\n    jne .Lfp_significant\n    incq %r15\n    js .Lfp_invalid\n.Lfp_significant:\n    testq %r13,%r13\n    jne .Lfp_keep_digit\n    testl %eax,%eax\n    jne .Lfp_keep_digit\n    incq %r14\n    js .Lfp_invalid\n    jmp .Lfp_advance\n.Lfp_keep_digit:\n    cmpq $800,%r13\n    jae .Lfp_discard_digit\n    addb $48,%al\n    movb %al,(%rsp,%r13)\n    incq %r13\n    jmp .Lfp_advance\n.Lfp_discard_digit:\n    testl %eax,%eax\n    je .Lfp_advance\n    movq $1,1960(%rsp)\n.Lfp_advance:\n    movq $1,2056(%rsp)\n    incq %r12\n    jmp .Lfp_mantissa\n.Lfp_non_digit:\n    addl $48,%eax\n    cmpl $46,%eax\n    je .Lfp_dot\n    cmpq $0,2056(%rsp)\n    je .Lfp_invalid\n    cmpl $101,%eax\n    je .Lfp_exponent\n    cmpl $69,%eax\n    je .Lfp_exponent\n    testl %eax,%eax\n    jne .Lfp_invalid\n    xorl %r8d,%r8d\n    xorl %r9d,%r9d\n    jmp .Lfp_normalize\n.Lfp_dot:\n    cmpq $0,1984(%rsp)\n    jne .Lfp_invalid\n    movq $1,1984(%rsp)\n    movq $0,2056(%rsp)\n    incq %r12\n    jmp .Lfp_mantissa\n.Lfp_exponent:\n    incq %r12\n    cmpb $45,(%r12)\n    jne .Lfp_exponent_plus\n    movq $1,2032(%rsp)\n    incq %r12\n    jmp .Lfp_exponent_first\n.Lfp_exponent_plus:\n    cmpb $43,(%r12)\n    jne .Lfp_exponent_first\n    incq %r12\n.Lfp_exponent_first:\n    movzbl (%r12),%eax\n    subl $48,%eax\n    cmpl $9,%eax\n    ja .Lfp_invalid\n    xorl %r8d,%r8d\n    xorl %r9d,%r9d\n.Lfp_exponent_digit:\n    movzbl (%r12),%r10d\n    testl %r10d,%r10d\n    je .Lfp_normalize\n    subl $48,%r10d\n    cmpl $9,%r10d\n    ja .Lfp_invalid\n    testq %r9,%r9\n    jne .Lfp_exponent_next\n    movq %r8,%rax\n    movl $10,%ecx\n    mulq %rcx\n    testq %rdx,%rdx\n    jne .Lfp_exponent_huge\n    addq %r10,%rax\n    jc .Lfp_exponent_huge\n    movq %rax,%r8\n    jmp .Lfp_exponent_next\n.Lfp_exponent_huge:\n    movl $1,%r9d\n.Lfp_exponent_next:\n    incq %r12\n    jmp .Lfp_exponent_digit\n.Lfp_normalize:\n    testq %r13,%r13\n    je .Lfp_zero\n    testq %r9,%r9\n    jne .Lfp_huge_exponent\n    # Adjust the exponent in signed 128 bits; do not silently clamp cancellation.\n    movq %r8,%rax\n    xorl %edx,%edx\n    cmpq $0,2032(%rsp)\n    je .Lfp_exponent_signed\n    negq %rax\n    sbbq %rdx,%rdx\n.Lfp_exponent_signed:\n    movq %r15,%rcx\n    subq %r14,%rcx\n    decq %rcx\n    movq %rcx,%r10\n    sarq $63,%r10\n    addq %rcx,%rax\n    adcq %r10,%rdx\n    movq %rax,%r10\n    sarq $63,%r10\n    cmpq %r10,%rdx\n    jne .Lfp_extreme_adjusted\n    cmpq $308,%rax\n    jg .Lfp_infinity\n    cmpq $-324,%rax\n    jl .Lfp_zero\n    movq %rax,2024(%rsp)\n    movq %r13,1952(%rsp)\n    movq $0,2000(%rsp)\n    movabsq $0x7ff0000000000000,%rax\n    movq %rax,2008(%rsp)\n.Lfp_search:\n    movq 2000(%rsp),%rax\n    cmpq 2008(%rsp),%rax\n    je .Lfp_signed_result\n    addq 2008(%rsp),%rax\n    shrq $1,%rax\n    movq %rax,2016(%rsp)\n    movq %rax,%rsi\n    shrq $52,%rsi\n    movabsq $0xfffffffffffff,%rdi\n    andq %rax,%rdi\n    testq %rsi,%rsi\n    je .Lfp_mid_subnormal\n    btsq $52,%rdi\n    subq $1076,%rsi\n    jmp .Lfp_mid_expand\n.Lfp_mid_subnormal:\n    movq $-1075,%rsi\n.Lfp_mid_expand:\n    leaq 1(%rdi,%rdi),%rdi\n    leaq 800(%rsp),%rdx\n    call erist_rt_float_exact_digits\n    testq %rax,%rax\n    je .Lfp_internal\n    movq %rax,%r14\n    subq %rdx,%rax\n    decq %rax\n    cmpq %rax,2024(%rsp)\n    jl .Lfp_below\n    jg .Lfp_above\n    xorl %ecx,%ecx\n.Lfp_compare_digit:\n    cmpq 1952(%rsp),%rcx\n    jb .Lfp_input_digit\n    cmpq %r14,%rcx\n    jae .Lfp_equal_digits\n    movl $48,%r8d\n    jmp .Lfp_mid_digit\n.Lfp_input_digit:\n    movzbl (%rsp,%rcx),%r8d\n.Lfp_mid_digit:\n    movl $48,%r9d\n    cmpq %r14,%rcx\n    jae .Lfp_digit_order\n    movzbl 800(%rsp,%rcx),%r9d\n.Lfp_digit_order:\n    cmpl %r9d,%r8d\n    jb .Lfp_below\n    ja .Lfp_above\n    incq %rcx\n    jmp .Lfp_compare_digit\n.Lfp_equal_digits:\n    cmpq $0,1960(%rsp)\n    jne .Lfp_above\n    movq 2016(%rsp),%rax\n    testb $1,%al\n    je .Lfp_signed_result\n    incq %rax\n    jmp .Lfp_signed_result\n.Lfp_below:\n    movq 2016(%rsp),%rax\n    movq %rax,2008(%rsp)\n    jmp .Lfp_search\n.Lfp_above:\n    movq 2016(%rsp),%rax\n    incq %rax\n    movq %rax,2000(%rsp)\n    jmp .Lfp_search\n.Lfp_extreme_adjusted:\n    testq %rdx,%rdx\n    js .Lfp_zero\n    jmp .Lfp_infinity\n.Lfp_huge_exponent:\n    cmpq $0,2032(%rsp)\n    jne .Lfp_zero\n.Lfp_infinity:\n    movabsq $0x7ff0000000000000,%rax\n    jmp .Lfp_signed_result\n.Lfp_zero:\n    xorl %eax,%eax\n.Lfp_signed_result:\n    xorq 1992(%rsp),%rax\n    xorl %edx,%edx\n    jmp .Lfp_return\n.Lfp_invalid:\n    xorl %eax,%eax\n    movl $1,%edx\n    jmp .Lfp_return\n.Lfp_internal:\n    xorl %eax,%eax\n    movl $2,%edx\n.Lfp_return:\n    addq $2112,%rsp\n    popq %r15\n    popq %r14\n    popq %r13\n    popq %r12\n    popq %rbx\n    ret\n.size erist_rt_float_parse,.-erist_rt_float_parse\n"; }
public function source() returns Text { return float_decimal_x86_64.source()+helpersSource(); }
