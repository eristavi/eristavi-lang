    let accessors be accessorSource();
    if accessors == "" { return ".text\n.globl erist_rt_allocator_lowering_invalid\nerist_rt_allocator_lowering_invalid:\n    ud2\n"; }
    return linux_x86_64.memorySource()+accessors+stateSource()+allocatorBody();
}

