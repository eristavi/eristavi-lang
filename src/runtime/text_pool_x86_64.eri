// Managed small-Text storage; private Linux x86-64 implementation.
// Pool slices are independent buffers. Only backing reservations are shared.
public function source() returns Text {
    return ".bss\n.p2align 3\n.Ltext_pool_available:\n.quad 0\n.Ltext_pool_count:\n.quad 0\n.text\n# Slab header (64 bytes): available next/previous, live blocks, free head,\n# initialized blocks, exact mapped length, two reserved words.\n# 60 blocks of 272 bytes fill the rest of a 16 KiB slab exactly.\n# Block header (16 bytes): owner slab, free next or allocated sentinel 1.\n# Caller owns one exact returned base/capacity pair, until storage_release.\n.globl erist_rt_text_storage_reserve\n.type erist_rt_text_storage_reserve,@function\nerist_rt_text_storage_reserve:\n    testq %rdi,%rdi\n    jle erist_rt_reserve\n    cmpq $256,%rdi\n    ja erist_rt_reserve\n    pushq %rbx\n    movq .Ltext_pool_available(%rip),%rbx\n    testq %rbx,%rbx\n    jne .Ltext_pool_take\n    movl $16384,%edi\n    call erist_rt_reserve\n    testq %rax,%rax\n    je .Ltext_pool_reserve_done\n    movq %rax,%rbx\n    movq %rdx,40(%rbx)\n    movq %rbx,.Ltext_pool_available(%rip)\n    incq .Ltext_pool_count(%rip)\n.Ltext_pool_take:\n    movq 24(%rbx),%rax\n    testq %rax,%rax\n    je .Ltext_pool_bump\n    movq 8(%rax),%rcx\n    movq %rcx,24(%rbx)\n    jmp .Ltext_pool_acquired\n.Ltext_pool_bump:\n    movq 32(%rbx),%rax\n    cmpq $60,%rax\n    jae .Ltext_pool_reserve_corrupt\n    imulq $272,%rax,%rax\n    leaq 64(%rbx,%rax),%rax\n    incq 32(%rbx)\n    movq %rbx,0(%rax)\n.Ltext_pool_acquired:\n    movq $1,8(%rax)\n    incq 16(%rbx)\n    cmpq $60,16(%rbx)\n    jb .Ltext_pool_reserved\n    jne .Ltext_pool_reserve_corrupt\n    # Allocation always takes the head slab. Remove it when full.\n    movq 0(%rbx),%rcx\n    movq %rcx,.Ltext_pool_available(%rip)\n    testq %rcx,%rcx\n    je .Ltext_pool_full_unlinked\n    movq $0,8(%rcx)\n.Ltext_pool_full_unlinked:\n    movq $0,0(%rbx)\n    movq $0,8(%rbx)\n.Ltext_pool_reserved:\n    addq $16,%rax\n    movl $256,%edx\n.Ltext_pool_reserve_done:\n    popq %rbx\n    ret\n.Ltext_pool_reserve_corrupt:\n    popq %rbx\n    jmp erist_rt_value_fault_internal\n.size erist_rt_text_storage_reserve,.-erist_rt_text_storage_reserve\n\n.globl erist_rt_text_storage_release\n.type erist_rt_text_storage_release,@function\nerist_rt_text_storage_release:\n    cmpq $256,%rsi\n    jne erist_rt_release\n    # Managed registry/constructor ownership proves the input allocation is live.\n    # Validate its exact block offset and allocated sentinel before unlinking it.\n    pushq %rbx\n    testq %rdi,%rdi\n    je .Ltext_pool_release_invalid\n    leaq -16(%rdi),%r8\n    movq 0(%r8),%rbx\n    testq %rbx,%rbx\n    je .Ltext_pool_release_invalid\n    cmpq $1,8(%r8)\n    jne .Ltext_pool_release_invalid\n    movq %r8,%rax\n    subq %rbx,%rax\n    jc .Ltext_pool_release_invalid\n    subq $64,%rax\n    jc .Ltext_pool_release_invalid\n    xorl %edx,%edx\n    movl $272,%ecx\n    divq %rcx\n    testq %rdx,%rdx\n    jne .Ltext_pool_release_invalid\n    cmpq 32(%rbx),%rax\n    jae .Ltext_pool_release_invalid\n    cmpq $0,16(%rbx)\n    je .Ltext_pool_release_invalid\n    cmpq $60,16(%rbx)\n    ja .Ltext_pool_release_invalid\n    jne .Ltext_pool_return_block\n    # A full slab rejoins the available list when its first block is freed.\n    movq .Ltext_pool_available(%rip),%rax\n    movq %rax,0(%rbx)\n    movq $0,8(%rbx)\n    testq %rax,%rax\n    je .Ltext_pool_available_linked\n    movq %rbx,8(%rax)\n.Ltext_pool_available_linked:\n    movq %rbx,.Ltext_pool_available(%rip)\n.Ltext_pool_return_block:\n    movq 24(%rbx),%rax\n    movq %rax,8(%r8)\n    movq %r8,24(%rbx)\n    decq 16(%rbx)\n    jne .Ltext_pool_release_ok\n    # Empty slabs are released immediately, including constructor-error cleanup.\n    movq 0(%rbx),%rax\n    movq 8(%rbx),%rcx\n    testq %rcx,%rcx\n    je .Ltext_pool_unlink_head\n    movq %rax,0(%rcx)\n    jmp .Ltext_pool_unlink_previous_done\n.Ltext_pool_unlink_head:\n    movq %rax,.Ltext_pool_available(%rip)\n.Ltext_pool_unlink_previous_done:\n    testq %rax,%rax\n    je .Ltext_pool_unlinked\n    movq %rcx,8(%rax)\n.Ltext_pool_unlinked:\n    movq %rbx,%rdi\n    movq 40(%rbx),%rsi\n    call erist_rt_release\n    testq %rax,%rax\n    jne .Ltext_pool_release_done\n    decq .Ltext_pool_count(%rip)\n    jmp .Ltext_pool_release_done\n.Ltext_pool_release_ok:\n    xorl %eax,%eax\n    jmp .Ltext_pool_release_done\n.Ltext_pool_release_invalid:\n    movq $-1,%rax\n.Ltext_pool_release_done:\n    popq %rbx\n    ret\n.size erist_rt_text_storage_release,.-erist_rt_text_storage_release\n\n# Pool byte accesses translate a checked slice offset into the original slab\n# reservation pair. The verified raw-memory helpers retain their page/provenance\n# contract; a pool slice is never passed to them as an independent reservation.\n.Ltext_pool_address:\n    testq %rdi,%rdi\n    je .Ltext_pool_bad_address\n    cmpq $256,%rdx\n    jae .Ltext_pool_bad_address\n    testq $15,%rdi\n    jne .Ltext_pool_bad_address\n    movq %rdx,%r10\n    leaq -16(%rdi),%rax\n    cmpq $1,8(%rax)\n    jne .Ltext_pool_bad_address\n    movq 0(%rax),%r9\n    testq %r9,%r9\n    je .Ltext_pool_bad_address\n    cmpq $16384,40(%r9)\n    jne .Ltext_pool_bad_address\n    cmpq $60,32(%r9)\n    ja .Ltext_pool_bad_address\n    movq %rdi,%rax\n    subq %r9,%rax\n    jc .Ltext_pool_bad_address\n    subq $80,%rax\n    jc .Ltext_pool_bad_address\n    xorl %edx,%edx\n    movl $272,%r8d\n    divq %r8\n    testq %rdx,%rdx\n    jne .Ltext_pool_bad_address\n    cmpq 32(%r9),%rax\n    jae .Ltext_pool_bad_address\n    imulq $272,%rax,%rdx\n    addq $80,%rdx\n    addq %r10,%rdx\n    movq %r9,%rdi\n    movl $16384,%esi\n    clc\n    ret\n.Ltext_pool_bad_address:\n    stc\n    ret\n.globl erist_rt_text_load8\n.type erist_rt_text_load8,@function\nerist_rt_text_load8:\n    cmpq $256,%rsi\n    jne erist_rt_text_reservation_load8\n    subq $8,%rsp\n    call .Ltext_pool_address\n    leaq 8(%rsp),%rsp\n    jc .Ltext_pool_access_invalid\n    jmp erist_rt_text_reservation_load8\n.size erist_rt_text_load8,.-erist_rt_text_load8\n.globl erist_rt_text_store8\n.type erist_rt_text_store8,@function\nerist_rt_text_store8:\n    cmpq $256,%rsi\n    jne erist_rt_text_reservation_store8\n    subq $8,%rsp\n    call .Ltext_pool_address\n    leaq 8(%rsp),%rsp\n    jc .Ltext_pool_access_invalid\n    jmp erist_rt_text_reservation_store8\n.size erist_rt_text_store8,.-erist_rt_text_store8\n.Ltext_pool_access_invalid:\n    xorl %eax,%eax\n    movl $1,%edx\n    ret\n";
}
