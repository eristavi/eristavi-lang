// Private Text operators: exact UTF-8 byte equality/inequality and checked immutable
// concatenation. Both inputs are complete supported Text values; new storage is
// published before any collection. Empty concatenation shares immutable storage.
public function source() returns Text { return ".text\n.globl erist_rt_text_binary\n.type erist_rt_text_binary,@function\nerist_rt_text_binary:\n    testq %rdi,%rdi\n    je .Ltext_binary_concat\n    cmpq $5,%rdi\n    je .Ltext_binary_compare\n    cmpq $6,%rdi\n    jne erist_rt_value_fault_internal\n.Ltext_binary_compare:\n    movq %rdi,%r8\n    movq 8(%rsi),%rcx\n    cmpq 8(%rdx),%rcx\n    jne .Ltext_compare_different\n    testq %rcx,%rcx\n    je .Ltext_compare_equal\n    movq 16(%rsi),%rsi\n    movq 16(%rdx),%rdx\n    xorl %r9d,%r9d\n.Ltext_compare_loop:\n    movzbl (%rsi,%r9),%r10d\n    cmpb (%rdx,%r9),%r10b\n    jne .Ltext_compare_different\n    incq %r9\n    cmpq %rcx,%r9\n    jb .Ltext_compare_loop\n.Ltext_compare_equal:\n    movl $1,%eax\n    jmp .Ltext_compare_result\n.Ltext_compare_different:\n    xorl %eax,%eax\n.Ltext_compare_result:\n    cmpq $6,%r8\n    jne .Ltext_compare_bool\n    xorl $1,%eax\n.Ltext_compare_bool:\n    movq %rax,%rdi\n    jmp evn_bool\n.Ltext_binary_concat:\n    movq %rsi,%rdi\n    movq %rdx,%rsi\n    jmp erist_rt_text_concat\n.size erist_rt_text_binary,.-erist_rt_text_binary\n.globl erist_rt_text_concat\n.type erist_rt_text_concat,@function\nerist_rt_text_concat:\n    movq 8(%rdi),%rax\n    addq 8(%rsi),%rax\n    jc erist_rt_text_fault_size\n    movabsq $9223372036854771712,%rcx\n    cmpq %rcx,%rax\n    ja erist_rt_text_fault_size\n    cmpq $0,8(%rsi)\n    je evn_copy\n    cmpq $0,8(%rdi)\n    jne .Ltext_concat_nonempty\n    movq %rsi,%rdi\n    jmp evn_copy\n.Ltext_concat_nonempty:\n    pushq %rbx\n    pushq %r12\n    pushq %r13\n    pushq %r14\n    pushq %r15\n    subq $32,%rsp\n    movq %rax,24(%rsp)\n    movq 16(%rdi),%rbx\n    movq 8(%rdi),%r12\n    movq 16(%rsi),%r13\n    # Append only beyond the longest published prefix, within its reservation.\n    # Earlier snapshots still expose their own length and never change bytes.\n    movq %rbx,%rdi\n    call erist_rt_text_registry_find\n    testq %rax,%rax\n    je .Ltext_concat_internal\n    movq %rax,16(%rsp)\n    cmpq 24(%rax),%r12\n    jne .Ltext_concat_allocate\n    movq 24(%rsp),%rcx\n    cmpq 16(%rax),%rcx\n    ja .Ltext_concat_allocate\n    movq %rbx,0(%rsp)\n    movq 16(%rax),%rdx\n    movq %rdx,8(%rsp)\n    movq %r12,%r15\n    jmp .Ltext_concat_suffix\n.Ltext_concat_allocate:\n    movq $0,16(%rsp)\n    # Geometric capacity, capped at the exact supported reservation limit.\n    movq 24(%rsp),%rdi\n    movabsq $4611686018427385856,%rcx\n    cmpq %rcx,%rdi\n    ja .Ltext_concat_reserve\n    addq %rdi,%rdi\n.Ltext_concat_reserve:\n    call erist_rt_text_storage_reserve\n    testq %rax,%rax\n    je .Ltext_concat_oom\n    movq %rax,0(%rsp)\n    movq %rdx,8(%rsp)\n    xorl %r15d,%r15d\n.Ltext_concat_copy:\n    cmpq %r12,%r15\n    jae .Ltext_concat_suffix\n    movzbl (%rbx,%r15),%ecx\n    jmp .Ltext_concat_store\n.Ltext_concat_suffix:\n    movq %r15,%rax\n    subq %r12,%rax\n    movzbl (%r13,%rax),%ecx\n.Ltext_concat_store:\n    movq 0(%rsp),%rdi\n    movq 8(%rsp),%rsi\n    movq %r15,%rdx\n    call erist_rt_text_store8\n    testq %rdx,%rdx\n    jne .Ltext_concat_cleanup\n    incq %r15\n    cmpq 24(%rsp),%r15\n    jb .Ltext_concat_copy\n    cmpq $0,16(%rsp)\n    jne .Ltext_concat_publish_prefix\n    movq 0(%rsp),%rdi\n    movq 8(%rsp),%rsi\n    movq 24(%rsp),%rdx\n    call erist_rt_text_publish\n    jmp .Ltext_concat_done\n.Ltext_concat_publish_prefix:\n    movq 16(%rsp),%rax\n    movq 24(%rsp),%rsi\n    movq %rsi,24(%rax)\n    movl $4,%edi\n    call erist_rt_value_new\n    movq 0(%rsp),%rcx\n    movq %rcx,16(%rax)\n    movq %rax,%rdi\n    call erist_rt_text_safe_point\n.Ltext_concat_done:\n    addq $32,%rsp\n    popq %r15\n    popq %r14\n    popq %r13\n    popq %r12\n    popq %rbx\n    ret\n.Ltext_concat_cleanup:\n    cmpq $0,16(%rsp)\n    jne .Ltext_concat_internal\n    movq 0(%rsp),%rdi\n    movq 8(%rsp),%rsi\n    call erist_rt_text_storage_release\n.Ltext_concat_internal:\n    addq $32,%rsp\n    popq %r15\n    popq %r14\n    popq %r13\n    popq %r12\n    popq %rbx\n    jmp erist_rt_value_fault_internal\n.Ltext_concat_oom:\n    addq $32,%rsp\n    popq %r15\n    popq %r14\n    popq %r13\n    popq %r12\n    popq %rbx\n    jmp erist_rt_value_fault_oom\n.size erist_rt_text_concat,.-erist_rt_text_concat\n"; }
