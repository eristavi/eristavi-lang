// Private Text storage foundation; Linux/System-V x86-64 only.
// utf8_valid(rdi=trusted readable bytes,rsi=count) -> rax=Bool.
// text_buffer_copy(same inputs) -> rax=base, rdx=exact reservation length,
// rcx=status (0 success, 1 invalid UTF-8, 2 size, 3 reserve, 4 internal store).
// Empty success is (0,0,0). The caller owns the returned reservation and must
// release its exact base/length once, after all references have expired.
// These operations are not public Text values or a replacement for managed GC.
import runtime.linux_x86_64;
import runtime.text_pool_x86_64;
import compiler.runtime_memory_ir as memory_ir;
import compiler.runtime_memory_x86;

function validatorSource() returns Text { return ".text\n.globl erist_rt_utf8_valid\n.type erist_rt_utf8_valid,@function\nerist_rt_utf8_valid:\n    testq %rsi,%rsi\n    je .Lutf8_valid\n    testq %rdi,%rdi\n    je .Lutf8_invalid\n    movq %rdi,%rax\n    addq %rsi,%rax\n    jc .Lutf8_invalid\n    xorl %ecx,%ecx\n.Lutf8_loop:\n    cmpq %rsi,%rcx\n    jae .Lutf8_valid\n    movzbl (%rdi,%rcx),%eax\n    incq %rcx\n    cmpl $127,%eax\n    jbe .Lutf8_loop\n    cmpl $194,%eax\n    jb .Lutf8_invalid\n    cmpl $223,%eax\n    jbe .Lutf8_two\n    cmpl $239,%eax\n    jbe .Lutf8_three\n    cmpl $244,%eax\n    ja .Lutf8_invalid\n    movl $3,%r8d\n    jmp .Lutf8_tail\n.Lutf8_three:\n    movl $2,%r8d\n    jmp .Lutf8_tail\n.Lutf8_two:\n    movl $1,%r8d\n.Lutf8_tail:\n    movq %rsi,%rdx\n    subq %rcx,%rdx\n    cmpq %r8,%rdx\n    jb .Lutf8_invalid\n    movzbl (%rdi,%rcx),%edx\n    cmpl $128,%edx\n    jb .Lutf8_invalid\n    cmpl $191,%edx\n    ja .Lutf8_invalid\n    cmpl $224,%eax\n    jne .Lutf8_not_e0\n    cmpl $160,%edx\n    jb .Lutf8_invalid\n.Lutf8_not_e0:\n    cmpl $237,%eax\n    jne .Lutf8_not_ed\n    cmpl $160,%edx\n    jae .Lutf8_invalid\n.Lutf8_not_ed:\n    cmpl $240,%eax\n    jne .Lutf8_not_f0\n    cmpl $144,%edx\n    jb .Lutf8_invalid\n.Lutf8_not_f0:\n    cmpl $244,%eax\n    jne .Lutf8_continuations\n    cmpl $144,%edx\n    jae .Lutf8_invalid\n.Lutf8_continuations:\n    movzbl (%rdi,%rcx),%edx\n    andl $192,%edx\n    cmpl $128,%edx\n    jne .Lutf8_invalid\n    incq %rcx\n    decq %r8\n    jne .Lutf8_continuations\n    jmp .Lutf8_loop\n.Lutf8_valid:\n    movl $1,%eax\n    ret\n.Lutf8_invalid:\n    xorl %eax,%eax\n    ret\n.size erist_rt_utf8_valid,.-erist_rt_utf8_valid\n"; }
function copySource(managed Bool) returns Text {
    let reserve be "erist_rt_reserve"; let release be "erist_rt_release";
    if managed { reserve="erist_rt_text_storage_reserve"; release="erist_rt_text_storage_release"; }
    return ".text\n.globl erist_rt_text_buffer_copy\n.type erist_rt_text_buffer_copy,@function\nerist_rt_text_buffer_copy:\n    pushq %rbx\n    pushq %r12\n    pushq %r13\n    pushq %r14\n    pushq %r15\n    movq %rdi,%r12\n    movq %rsi,%r13\n    movabsq $9223372036854771712,%rax\n    cmpq %rax,%r13\n    ja .Ltext_buffer_size\n    call erist_rt_utf8_valid\n    testq %rax,%rax\n    je .Ltext_buffer_invalid\n    testq %r13,%r13\n    je .Ltext_buffer_empty\n    movq %r13,%rdi\n    call "+reserve+"\n    testq %rax,%rax\n    je .Ltext_buffer_oom\n    movq %rax,%rbx\n    movq %rdx,%r14\n    xorl %r15d,%r15d\n.Ltext_buffer_copy_loop:\n    movzbl (%r12,%r15),%ecx\n    movq %rbx,%rdi\n    movq %r14,%rsi\n    movq %r15,%rdx\n    call erist_rt_text_store8\n    testq %rdx,%rdx\n    jne .Ltext_buffer_cleanup\n    incq %r15\n    cmpq %r13,%r15\n    jb .Ltext_buffer_copy_loop\n    movq %rbx,%rax\n    movq %r14,%rdx\n    xorl %ecx,%ecx\n    jmp .Ltext_buffer_done\n.Ltext_buffer_cleanup:\n    movq %rbx,%rdi\n    movq %r14,%rsi\n    call "+release+"\n    movl $4,%ecx\n    jmp .Ltext_buffer_failure\n.Ltext_buffer_size:\n    movl $2,%ecx\n    jmp .Ltext_buffer_failure\n.Ltext_buffer_invalid:\n    movl $1,%ecx\n    jmp .Ltext_buffer_failure\n.Ltext_buffer_oom:\n    movl $3,%ecx\n.Ltext_buffer_failure:\n    xorl %eax,%eax\n    xorl %edx,%edx\n    jmp .Ltext_buffer_done\n.Ltext_buffer_empty:\n    xorl %eax,%eax\n    xorl %edx,%edx\n    xorl %ecx,%ecx\n.Ltext_buffer_done:\n    popq %r15\n    popq %r14\n    popq %r13\n    popq %r12\n    popq %rbx\n    ret\n.size erist_rt_text_buffer_copy,.-erist_rt_text_buffer_copy\n"; }

function storageSource(managed Bool) returns Text {
    let loadName be "erist_rt_text_load8"; let storeName be "erist_rt_text_store8";
    if managed { loadName="erist_rt_text_reservation_load8"; storeName="erist_rt_text_reservation_store8"; }
    let load be runtime_memory_x86.emit(memory_ir.load8Program(),loadName,4);
    let store be runtime_memory_x86.emit(memory_ir.store8Program(),storeName,3);
    if load=="" or store=="" { return ".text\n.globl erist_rt_text_lowering_invalid\nerist_rt_text_lowering_invalid:\n    ud2\n"; }
    let pool be ""; if managed { pool=text_pool_x86_64.source(); }
    return load+store+validatorSource()+pool+copySource(managed);
}

public function helpersSource() returns Text { return storageSource(false); }
public function managedHelpersSource() returns Text { return storageSource(true); }

public function source() returns Text { return linux_x86_64.memorySource()+helpersSource(); }
