// Slot pruning plus graph-aware protected roots and handler boundary pins.
import runtime.slot_index_x86_64;

function runtimeSource(allowGraph Bool) returns Text {
    let pins be ""; let protect be ""; let pressure be ""; let clear be ""; let schedule be "";
    if allowGraph {
        pins="movq .Lhandler_top(%rip),%r8\n.Lslots_handler_pin:\n    testq %r8,%r8\n    je .Lslots_handler_pin_done\n    cmpq 88(%r8),%r12\n    je .Lslots_keep\n    movq 80(%r8),%r8\n    jmp .Lslots_handler_pin\n.Lslots_handler_pin_done:\n    ";
        protect="movq %rdi,.Lgraph_protected_value(%rip)\n    ";
        // Graph/failure/text allocations mark the heap dirty where they commit.
        // Checking the counters only on dirty safe points avoids scalar hot-path work.
        pressure="";
        clear="movq $0,.Lgraph_protected_value(%rip)\n    ";
        schedule="    # Reclaim in response to fresh managed allocations, not every scalar visit.
    movq .Lgraph_since_gc(%rip),%rax
    addq .Ltext_new_since_gc(%rip),%rax
    jc .Ltext_safe_collect_due
    cmpq .Lgraph_safe_budget(%rip),%rax
    jae .Ltext_safe_collect_due
    # A single large graph or Text allocation must also force a collection.
    movq .Lgraph_alloc_since_gc(%rip),%rax
    addq .Ltext_alloc_since_gc(%rip),%rax
    jc .Ltext_safe_collect_due
    cmpq $8388608,%rax
    jae .Ltext_safe_collect_due
    # Bound deferred reclaim after scope/unwind invalidates roots, even with
    # no newly published managed allocations. Never remove explicit GC calls.
    addq $1,.Lgraph_safe_since(%rip)
    jc .Ltext_safe_collect_due
    cmpq $1048576,.Lgraph_safe_since(%rip)
    jb .Ltext_safe_return
.Ltext_safe_collect_due:
";
    }
    return slot_index_x86_64.source()+".data\n.p2align 3\n.Lslots_next_gc:\n.quad 256\n.text\n.globl erist_rt_slots_live\n.type erist_rt_slots_live,@function\nerist_rt_slots_live:\n    movq .Lvalue_slot_count(%rip),%rax\n    ret\n.size erist_rt_slots_live,.-erist_rt_slots_live\n.globl erist_rt_slots_collect\n.type erist_rt_slots_collect,@function\nerist_rt_slots_collect:\n    pushq %rbx\n    pushq %r12\n    pushq %r13\n    pushq %r14\n    pushq %r15\n    subq $32,%rsp\n    movq $0,0(%rsp)\n    movq %rdi,%r15\n    movq .Lvalue_scopes(%rip),%r13\n    testq %r13,%r13\n    je .Lslots_done\n.Lslots_check_frames:\n    cmpq $0,16(%r13)\n    je .Lslots_done\n    cmpq $0,24(%r13)\n    je .Lslots_done\n    movq 8(%r13),%r13\n    testq %r13,%r13\n    jne .Lslots_check_frames\n    call .Lslots_prepare_index\n    movq %rax,0(%rsp)\n    movq %rdx,8(%rsp)\n    movq %rcx,16(%rsp)\n    leaq .Lvalue_slots(%rip),%rbx\n    xorl %r14d,%r14d\n.Lslots_scan:\n    movq 0(%rbx),%r12\n    testq %r12,%r12\n    je .Lslots_collected\n    cmpq %r15,%r12\n    je .Lslots_keep\n    "+pins+"movq 0(%rsp),%rsi\n    testq %rsi,%rsi\n    je .Lslots_linear\n    movq %r12,%rdi\n    movq 8(%rsp),%rdx\n    call .Lslots_index_contains\n    testq %rax,%rax\n    jne .Lslots_keep\n    jmp .Lslots_drop\n.Lslots_linear:\n    movq .Lvalue_scopes(%rip),%r13\n.Lslots_frame:\n    cmpq 0(%r13),%r12\n    je .Lslots_keep\n    movq 16(%r13),%r8\n    movq 24(%r13),%r9\n    xorl %ecx,%ecx\n.Lslots_root:\n    cmpq 32(%r13),%rcx\n    jae .Lslots_next_frame\n    cmpb $1,(%r9,%rcx)\n    jne .Lslots_next_root\n    cmpq (%r8,%rcx,8),%r12\n    je .Lslots_keep\n.Lslots_next_root:\n    incq %rcx\n    jmp .Lslots_root\n.Lslots_next_frame:\n    movq 8(%r13),%r13\n    testq %r13,%r13\n    jne .Lslots_frame\n.Lslots_drop:\n    movq 32(%r12),%rax\n    movq %rax,0(%rbx)\n    subq $1,.Lvalue_slot_count(%rip)\n    jc .Lslots_internal\n    movq $1,.Ltext_heap_dirty(%rip)\n    movq %r12,%rdi\n    call erist_rt_free\n    testq %rax,%rax\n    jne .Lslots_internal\n    jmp .Lslots_scan\n.Lslots_keep:\n    addq $1,%r14\n    jc .Lslots_internal\n    leaq 32(%r12),%rbx\n    jmp .Lslots_scan\n.Lslots_collected:\n    addq $256,%r14\n    jc .Lslots_internal\n    movq %r14,.Lslots_next_gc(%rip)\n.Lslots_done:\n    movq 0(%rsp),%rdi\n    testq %rdi,%rdi\n    je .Lslots_return\n    movq 16(%rsp),%rsi\n    call .Lslots_scratch_release\n    testq %rax,%rax\n    jne .Lslots_internal\n.Lslots_return:\n    addq $32,%rsp\n    popq %r15\n    popq %r14\n    popq %r13\n    popq %r12\n    popq %rbx\n    ret\n.Lslots_internal:\n    addq $32,%rsp\n    popq %r15\n    popq %r14\n    popq %r13\n    popq %r12\n    popq %rbx\n    jmp erist_rt_value_fault_internal\n.size erist_rt_slots_collect,.-erist_rt_slots_collect\n.globl erist_rt_text_safe_point\n.type erist_rt_text_safe_point,@function\nerist_rt_text_safe_point:\n    pushq %rbx\n    movq %rdi,%rbx\n    "+protect+"call erist_rt_slots_live\n    movq %rax,%rcx\n    addq $256,%rcx\n    jc .Ltext_safe_internal\n    cmpq .Lslots_next_gc(%rip),%rcx\n    jae .Ltext_safe_threshold\n    movq %rcx,.Lslots_next_gc(%rip)\n.Ltext_safe_threshold:\n    cmpq .Lslots_next_gc(%rip),%rax\n    jb .Ltext_safe_heap\n    movq %rbx,%rdi\n    call erist_rt_slots_collect\n.Ltext_safe_heap:\n    "+pressure+"cmpq $0,.Ltext_heap_dirty(%rip)\n    je .Ltext_safe_return\n"+schedule+"    call erist_rt_text_collect\n.Ltext_safe_return:\n    "+clear+"movq %rbx,%rax\n    popq %rbx\n    ret\n.Ltext_safe_internal:\n    popq %rbx\n    jmp erist_rt_value_fault_internal\n.size erist_rt_text_safe_point,.-erist_rt_text_safe_point\n";
}
public function source() returns Text { return runtimeSource(false); }
public function graphSource() returns Text { return runtimeSource(true); }
