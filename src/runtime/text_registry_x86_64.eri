// Private nonowning index; the linked registry remains the sole owner.
// Rebuilt during sweep, before another allocation or mark can run.
public function source() returns Text { return ".bss\n.p2align 3\n.Ltext_buckets:\n.zero 32768\n.Ltext_registry_probes:\n.quad 0\n.text\n# Registered backing bases only. Hash complete reservation/slice bases, never value-slot addresses.\n.Ltext_registry_bucket:\n    movq %rdi,%rax\n    shrq $4,%rax\n    movq %rax,%rcx\n    shrq $12,%rcx\n    xorq %rcx,%rax\n    andl $4095,%eax\n    leaq .Ltext_buckets(%rip),%rcx\n    leaq (%rcx,%rax,8),%rax\n    ret\n.globl erist_rt_text_registry_probe_count\n.type erist_rt_text_registry_probe_count,@function\nerist_rt_text_registry_probe_count:\n    movq .Ltext_registry_probes(%rip),%rax\n    ret\n.size erist_rt_text_registry_probe_count,.-erist_rt_text_registry_probe_count\n.globl erist_rt_text_registry_find\n.type erist_rt_text_registry_find,@function\nerist_rt_text_registry_find:\n    subq $8,%rsp\n    call .Ltext_registry_bucket\n    addq $8,%rsp\n    movq (%rax),%rax\n.Ltext_registry_find_loop:\n    testq %rax,%rax\n    je .Ltext_registry_find_done\n    addq $1,.Ltext_registry_probes(%rip)\n    cmpq 8(%rax),%rdi\n    je .Ltext_registry_find_done\n    movq 40(%rax),%rax\n    jmp .Ltext_registry_find_loop\n.Ltext_registry_find_done:\n    ret\n.size erist_rt_text_registry_find,.-erist_rt_text_registry_find\n.globl erist_rt_text_registry_insert\n.type erist_rt_text_registry_insert,@function\nerist_rt_text_registry_insert:\n    pushq %rdi\n    movq 8(%rdi),%rdi\n    call .Ltext_registry_bucket\n    popq %rdi\n    movq (%rax),%rcx\n    movq %rcx,40(%rdi)\n    movq %rdi,(%rax)\n    ret\n.size erist_rt_text_registry_insert,.-erist_rt_text_registry_insert\n.globl erist_rt_text_registry_clear\n.type erist_rt_text_registry_clear,@function\nerist_rt_text_registry_clear:\n    leaq .Ltext_buckets(%rip),%rdi\n    movl $4096,%ecx\n    xorl %eax,%eax\n    cld\n    rep stosq\n    ret\n.size erist_rt_text_registry_clear,.-erist_rt_text_registry_clear\n"; }
