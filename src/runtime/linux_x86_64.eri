// Compiler-owned assembly emitter, not a public raw-memory library.
// The generator still uses the qualified bootstrap runtime. Its output does not.
// Private SysV AMD64 ABI: reserve(rdi=requested signed byte count) ->
// rax=base, rdx=page-rounded length; both zero on invalid input/OS failure.
// Memory is anonymous, zero-initialized and read/write, never executable.
// release(rdi=base,rsi=exact length) -> rax=0 or negative Linux errno.
// write_all(rdi=fd,rsi=bytes,rdx=count) -> rax=0 or negative Linux errno.
// Helpers preserve callee-saved registers; syscall clobbers rcx/r11/flags.
// Nonzero lengths are rounded to Linux x86-64's 4096-byte base pages.
public function memorySource() returns Text {
    return ".text\n.globl erist_rt_reserve\n.type erist_rt_reserve,@function\nerist_rt_reserve:\n    testq %rdi,%rdi\n    jle .Lreserve_fail\n    movabsq $9223372036854771712,%rax\n    cmpq %rax,%rdi\n    ja .Lreserve_fail\n    leaq 4095(%rdi),%rsi\n    andq $-4096,%rsi\n    pushq %rsi\n    xorl %edi,%edi\n    movl $3,%edx\n    movl $34,%r10d\n    movq $-1,%r8\n    xorl %r9d,%r9d\n    movl $9,%eax\n    syscall\n    popq %rdx\n    cmpq $-4095,%rax\n    jae .Lreserve_fail\n    ret\n.Lreserve_fail:\n    xorl %eax,%eax\n    xorl %edx,%edx\n    ret\n.size erist_rt_reserve,.-erist_rt_reserve\n.globl erist_rt_release\n.type erist_rt_release,@function\nerist_rt_release:\n    movl $11,%eax\n    syscall\n    ret\n.size erist_rt_release,.-erist_rt_release\n.globl erist_rt_exit\n.type erist_rt_exit,@function\nerist_rt_exit:\n    movl $60,%eax\n    syscall\n    ud2\n.size erist_rt_exit,.-erist_rt_exit\n";
}

public function writeSource() returns Text {
    return ".text\n.globl erist_rt_write_all\n.type erist_rt_write_all,@function\nerist_rt_write_all:\n    pushq %rbx\n    pushq %r12\n    pushq %r13\n    movq %rdi,%r12\n    movq %rsi,%r13\n    movq %rdx,%rbx\n.Lwrite_all_loop:\n    testq %rbx,%rbx\n    je .Lwrite_all_success\n    movq %r12,%rdi\n    movq %r13,%rsi\n    movq %rbx,%rdx\n    movl $1,%eax\n    syscall\n    cmpq $-4,%rax\n    je .Lwrite_all_loop\n    cmpq $-4095,%rax\n    jae .Lwrite_all_done\n    testq %rax,%rax\n    jle .Lwrite_all_zero\n    addq %rax,%r13\n    subq %rax,%rbx\n    jmp .Lwrite_all_loop\n.Lwrite_all_success:\n    xorl %eax,%eax\n    jmp .Lwrite_all_done\n.Lwrite_all_zero:\n    movq $-5,%rax\n.Lwrite_all_done:\n    popq %r13\n    popq %r12\n    popq %rbx\n    ret\n.size erist_rt_write_all,.-erist_rt_write_all\n";
}

public function probeSource() returns Text {
    return memorySource() + ".globl _start\n.type _start,@function\n_start:\n    xorl %ebp,%ebp\n    xorl %edi,%edi\n    call erist_rt_reserve\n    orq %rdx,%rax\n    jne .Lprobe_fail\n    movq $-1,%rdi\n    call erist_rt_reserve\n    orq %rdx,%rax\n    jne .Lprobe_fail\n    movabsq $9223372036854775807,%rdi\n    call erist_rt_reserve\n    orq %rdx,%rax\n    jne .Lprobe_fail\n    movabsq $9223372036854771712,%rdi\n    call erist_rt_reserve\n    orq %rdx,%rax\n    jne .Lprobe_fail\n    movl $1,%edi\n    call erist_rt_reserve\n    testq %rax,%rax\n    je .Lprobe_fail\n    cmpq $4096,%rdx\n    jne .Lprobe_fail\n    movq %rax,%r12\n    andq $4095,%rax\n    jne .Lprobe_fail\n    cmpb $0,(%r12)\n    jne .Lprobe_fail\n    cmpb $0,4095(%r12)\n    jne .Lprobe_fail\n    movb $57,4095(%r12)\n    movq %r12,%rdi\n    movq %rdx,%rsi\n    call erist_rt_release\n    testq %rax,%rax\n    jne .Lprobe_fail\n    movl $8193,%edi\n    call erist_rt_reserve\n    testq %rax,%rax\n    je .Lprobe_fail\n    cmpq $12288,%rdx\n    jne .Lprobe_fail\n    cmpb $0,12287(%rax)\n    jne .Lprobe_fail\n    movb $99,12287(%rax)\n    movq %rax,%rdi\n    movq %rdx,%rsi\n    call erist_rt_release\n    testq %rax,%rax\n    jne .Lprobe_fail\n    xorl %edi,%edi\n    jmp erist_rt_exit\n.Lprobe_fail:\n    movl $1,%edi\n    jmp erist_rt_exit\n.size _start,.-_start\n.section .note.GNU-stack,\"\",@progbits\n";
}
