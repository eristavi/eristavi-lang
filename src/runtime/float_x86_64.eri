// Strict binary64 operation foundation. No parser/formatter or value profile yet.
public function source() returns Text { return ".text\n# Private bits ABI, not an evn_float literal parser or a source conversion API.\n# binary(op, a bits, b bits) -> rax=result bits, rdx=0 success/1 invalid op.\n# Comparisons return the machine word 0/1, arithmetic returns binary64 bits.\n# Save/restore caller MXCSR; always execute with ties-even and gradual underflow.\n.globl erist_rt_float_binary\n.type erist_rt_float_binary,@function\nerist_rt_float_binary:\n    subq $16,%rsp\n    stmxcsr 0(%rsp)\n    movl $0x1f80,4(%rsp)\n    ldmxcsr 4(%rsp)\n    movq %rsi,%xmm0\n    movq %rdx,%xmm1\n    cmpq $0,%rdi\n    je .Lfloat_add\n    cmpq $1,%rdi\n    je .Lfloat_sub\n    cmpq $2,%rdi\n    je .Lfloat_mul\n    cmpq $3,%rdi\n    je .Lfloat_div\n    cmpq $5,%rdi\n    jb .Lfloat_invalid\n    cmpq $10,%rdi\n    ja .Lfloat_invalid\n    ucomisd %xmm1,%xmm0\n    setnp %r8b\n    cmpq $5,%rdi\n    je .Lfloat_eq\n    cmpq $6,%rdi\n    je .Lfloat_ne\n    # cmp above changes flags; establish floating comparison again per case.\n    cmpq $7,%rdi\n    je .Lfloat_lt\n    cmpq $8,%rdi\n    je .Lfloat_le\n    cmpq $9,%rdi\n    je .Lfloat_gt\n    ucomisd %xmm1,%xmm0\n    setae %al\n    jmp .Lfloat_ordered\n.Lfloat_eq:\n    ucomisd %xmm1,%xmm0\n    sete %al\n    jmp .Lfloat_ordered\n.Lfloat_ne:\n    ucomisd %xmm1,%xmm0\n    setne %al\n    setp %r8b\n    orb %r8b,%al\n    jmp .Lfloat_bool\n.Lfloat_lt:\n    ucomisd %xmm1,%xmm0\n    setb %al\n    jmp .Lfloat_ordered\n.Lfloat_le:\n    ucomisd %xmm1,%xmm0\n    setbe %al\n    jmp .Lfloat_ordered\n.Lfloat_gt:\n    ucomisd %xmm1,%xmm0\n    seta %al\n.Lfloat_ordered:\n    andb %r8b,%al\n.Lfloat_bool:\n    movzbl %al,%eax\n    jmp .Lfloat_ok\n.Lfloat_add:\n    addsd %xmm1,%xmm0\n    jmp .Lfloat_bits\n.Lfloat_sub:\n    subsd %xmm1,%xmm0\n    jmp .Lfloat_bits\n.Lfloat_mul:\n    mulsd %xmm1,%xmm0\n    jmp .Lfloat_bits\n.Lfloat_div:\n    divsd %xmm1,%xmm0\n.Lfloat_bits:\n    movq %xmm0,%rax\n.Lfloat_ok:\n    xorl %edx,%edx\n    jmp .Lfloat_restore\n.Lfloat_invalid:\n    xorl %eax,%eax\n    movl $1,%edx\n.Lfloat_restore:\n    ldmxcsr 0(%rsp)\n    addq $16,%rsp\n    ret\n.size erist_rt_float_binary,.-erist_rt_float_binary\n.globl erist_rt_float_negate\n.type erist_rt_float_negate,@function\nerist_rt_float_negate:\n    movabsq $0x8000000000000000,%rax\n    xorq %rdi,%rax\n    ret\n.size erist_rt_float_negate,.-erist_rt_float_negate\n"; }
